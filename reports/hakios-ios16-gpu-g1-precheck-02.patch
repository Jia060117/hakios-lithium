+        passno, row = int(passno), int(row)
+        if row not in ROWS or row in matches[passno]:
+            raise ValueError("unexpected or duplicate actual fuse row")
+        if int(width) != 64 or valid != "1" or stable != "1" or \
+                int(address, 16) != 0x74000 + 8 * row:
+            raise ValueError("actual row address/width/valid/stable guard failed")
+        module.uint(raw, 64)
