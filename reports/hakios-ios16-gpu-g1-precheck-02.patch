+        rawrows[row] = a
+    endlines = [(i, line) for i, line in enumerate(lines, 1)
+                if line.startswith("LITHIUM GPU supply end ")]
+    if len(endlines) != 1:
+        raise ValueError("supply capture end summary missing/duplicated")
+    fields = dict(re.findall(r"\b([a-zA-Z0-9_]+)=([^\s]+)", endlines[0][1]))
+    expected = {"fuse_valid0": "0x3f", "fuse_valid1": "0x3f", "fuse_stable": "0x3f",
+                "fuse_reads": "12", "poisoned": "0", "gpu_writes": "0",
+                "regulator_writes": "0", "settled": "UNVERIFIED", "chip_id": "UNREAD"}
+    if any(fields.get(key) != value for key, value in expected.items()):
+        raise ValueError("actual capture end guard differs")
+    capture = {"schema": "gpu-g1-fuse-capture-v1",
+               "provenance": {"kind": "captured_console", "source": snapshot.relative_to(ROOT).as_posix(),
+                              "sha256": sha(data), "bytes": len(data),
+                              "original_console": (RUN / "console.log").relative_to(ROOT).as_posix(),
+                              "snapshot_bytes_unmodified": True, "console_reordered": False,
+                              "actual_emit_order": "row-major/pass-interleaved"},
+               "passes": passes,
+               "capture_end": {"line": endlines[0][0], "source_line": endlines[0][1]}}
+    return capture, rawrows, lines
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
