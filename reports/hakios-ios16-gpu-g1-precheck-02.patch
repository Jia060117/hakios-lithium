+                    v.get('status_valid') == 1 and v.get('status') == 1 and
+                    v.get('attempted') == 1 and v.get('completed') == 1 and
+                    type(v.get('polls')) is int and 1 <= v['polls'] <= 100 and
+                    type(raw) is int and 0 <= raw <= 255)
+                field_records.append(dict(record, data_valid_reported=v.get('valid'),
+                    data_valid_source='g1-precheck.inc:191-202 logs lgs_result.data_valid as valid',
+                    accepted_for_decode=good, error_name=ERRORS[v['error']] if
+                        type(v.get('error')) is int and 0 <= v['error'] < len(ERRORS) else 'unrecognized'))
