+def values(text):
+    result = {}
+    for key, val in re.findall(r'([A-Za-z_][A-Za-z0-9_]*)=([^\s]+)', text):
+        try:
+            result[key] = int(val, 16 if val.startswith('0x') else 10)
+        except ValueError:
+            result[key] = val
+    return result
