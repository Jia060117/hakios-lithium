+          'ROUTE_CHANGED', 'READ_ERROR', 'WRITE_ERROR', 'TIME_ERROR',
+          'DELAY_ERROR', 'CONFIG_UNSUPPORTED', 'TIMEOUT', 'DENIED',
+          'FAILURE', 'DROPPED', 'UNKNOWN_STATUS']
