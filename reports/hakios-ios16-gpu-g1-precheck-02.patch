+def protect():
+    paths = [CALCULATOR, FUSES / "pending-raw-input.json", FUSES / "stock133-model.json",
+             ROOT / "ports/hakios-lithium/gpu/g1-fuse.h",
+             ROOT / "scripts/tests/test-gpu-g1-fuse.c",
+             FUSES / "calculator-qa.py", FUSES / "run-tests.py"]
+    return {p.relative_to(ROOT).as_posix(): filehash(p) for p in paths}
+
+
+def existing_module():
+    spec = importlib.util.spec_from_file_location("stock133_existing", CALCULATOR)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def guards(snapshot_lines, phase):
+    records = {}
+    metadata = {}
+    for name, source in [("boot-intent", RUN / "boot-intent.json"),
+                         ("authorization", RUN / "authorization.json"),
+                         ("result", RUN / "result.json"),
+                         ("kernel-result", PACKAGE / "kernel-result.json"),
+                         ("contract", PACKAGE / "contract.json")]:
+        data = source.read_bytes()
+        saved = HERE / f"guard-{name}-{phase}.json"
+        saved.write_bytes(data)
+        records[name] = {"source": source.relative_to(ROOT).as_posix(),
+                         "snapshot": saved.relative_to(ROOT).as_posix(), "sha256": sha(data)}
+        metadata[name] = json.loads(data)
+    intent, result = metadata["boot-intent"], metadata["result"]
+    auth, kernel, contract = metadata["authorization"], metadata["kernel-result"], metadata["contract"]
+    if not intent["accepted"] or intent["attempt_id"] != "gpu-g1-precheck-02" or \
+            intent["image_sha256"] != result["image_sha256"] or \
+            intent["image_sha256"] != auth["image_sha256"] or \
+            not result["preflight_passed"] or not result["command_accepted"] or \
+            result["automatic_retry"] or result["boot_returncode"] != 0:
+        raise ValueError("run guard metadata inconsistent")
+    if result["accepted_at"] != intent["accepted_at"]:
+        raise ValueError("acceptance timestamp differs")
+    wanted = {"ufs": "0", "cpu_perf_hz": "614400000", "gpu_stage": "0",
+              "gpu_probe": "1", "gpu_power_diag": "1", "gpu_wd": "1"}
+    for source in [auth["boot_args"], result["boot_args"], contract["boot_args"]]:
+        args = dict(re.findall(r"\b([a-zA-Z0-9_]+)=([^\s]+)", source))
+        if any(args.get(key) != value for key, value in wanted.items()):
+            raise ValueError("host RAM/CPU/G1 parameter guard differs")
+    bootargs = [line for line in snapshot_lines if "LITHIUM BOOTARGS" in line]
+    if len(bootargs) != 1:
+        raise ValueError("actual bootargs record missing or duplicated")
+    actual = dict(re.findall(r"\b([a-zA-Z0-9_]+)=([^\s]+)", bootargs[0]))
+    if any(actual.get(key) != value for key, value in wanted.items()):
+        raise ValueError("actual runtime bootargs differ from guarded policy")
