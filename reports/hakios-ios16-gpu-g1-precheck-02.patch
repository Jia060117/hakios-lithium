+"""Host-only precheck02 calculation from an exact immutable console snapshot.
+
+Original calculator and production/test files remain unchanged. The adapter
+prints row-major, pass-interleaved lines. Validate actual line numbers per
+pass without reordering the console, then use existing pure policy functions.
+No device operations, firmware loads/reads, builds or test reruns.
+"""
+import argparse
+from datetime import datetime
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+HERE = Path(__file__).resolve().parent
+FUSES = HERE.parent
+ROOT = HERE.parents[3]
+RUN = ROOT / "evidence/gpu-g1-20261123/package/runs/gpu-g1-precheck-02"
+PACKAGE = RUN.parents[1] / "g1-precheck-02"
+CALCULATOR = FUSES / "calculate-stock133.py"
+ROWS = (39, 41, 63, 64, 66, 68)
+PATTERN = re.compile(
+    r"^LITHIUM GPU fuse pass=([01]) row=(\d+) pa=(0x[0-9a-fA-F]+) "
+    r"bits=(\d+) valid=([01]) raw=(0x[0-9a-fA-F]{16}) stable=([01])$")
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def filehash(path):
+    return sha(path.read_bytes())
+
