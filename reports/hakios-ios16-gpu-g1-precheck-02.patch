+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import re
+import runpy
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[3]
+CONSOLE = ROOT / 'evidence/gpu-g1-20261123/package/runs/gpu-g1-precheck-02/console.log'
+SPMI = HERE.parent
+FIELDS = [('TYPE', 4), ('SUBTYPE', 5), ('RANGE', 64), ('VSET', 65),
+          ('MODE', 69), ('ENABLE', 70), ('STEP', 97)]
+RAILS = [('GFX_PMI8994_S2', 3, 0x1700, 0x317, 'gfx'),
+         ('MX_PM8994_S2', 1, 0x1700, 0x117, 'mx')]
