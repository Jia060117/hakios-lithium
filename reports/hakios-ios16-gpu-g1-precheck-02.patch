+            "accepted_at": intent["accepted_at"], "accepted_image_sha256": intent["image_sha256"],
+            "kernel_sha256_from_build_manifest": kernel["sha256"],
+            "actual_runtime_bootargs_match": True, "production_source_sha256": current,
+            "source_guard_semantics": {
+                "owner": "logical0/affinity1 with interrupts enabled",
+                "budget_us": 250000, "access_cap": 9000,
+                "capture_order": "pass0 six rows then pass1 six rows in source",
+                "print_order": "row-major pass0/pass1 pairs; source g1-precheck.inc:149-157",
+                "validity": "64-bit load, barrier, pre/post lg1_open checks",
+                "stability": "full uint64 equality and both valid masks, source149-163"},
+            "authorization_json_is_preflight_intent": True,
+            "actual_preflight_acceptance_basis": "result.json + boot-intent.json",
+            "new_device_queries": 0, "boot_reissued": False,
+            "lifecycle_and_USB_audit": "owned by main; not certified by this calculation"}
+
+
+def actual_capture(snapshot, module):
+    data = snapshot.read_bytes()
+    lines = data.decode("utf-8").splitlines()
+    matches = {0: {}, 1: {}}
