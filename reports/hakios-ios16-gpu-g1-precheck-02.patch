+                               "valid": True, "raw": raw, "line": lineno,
+                               "source_line": line, "stable_reported": True}
+    all_indices, passes = set(), []
+    for passno in (0, 1):
+        if set(matches[passno]) != set(ROWS):
+            raise ValueError("complete six-row pass not yet captured")
+        entries = [matches[passno][row] for row in ROWS]
+        indices = [entry["line"] for entry in entries]
+        if indices != sorted(indices) or len(set(indices)) != 6 or all_indices & set(indices):
+            raise ValueError("per-pass actual line indices not ascending/unique/disjoint")
+        all_indices.update(indices)
+        passes.append({"pass": passno, "validmask": "0x3f", "rows": entries})
+    rawrows = {}
+    for row in ROWS:
+        a, b = (module.uint(matches[p][row]["raw"], 64) for p in (0, 1))
+        if a != b:
