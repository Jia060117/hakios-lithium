@@ -0,0 +1,137 @@
+"""One authorized R34 UFS desktop boot; retain USB logs without device polling."""
+from datetime import datetime
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import time
+
+ROOT = Path('F:/IOS-MIX1')
+LOCAL = ROOT/'reports/local/20261120-r34-touch-live-ufs-approved'
+PACKAGE = ROOT/'artifacts/hakios/lithium-ios16/phase4-r34-touch-live-ufs-final'
+GUARD = ROOT/'reports/local/ios16-r34-touch-live-ufs-boot-intent.json'
+FASTBOOT = Path('C:/platform-tools/fastboot.exe')
+USB_PYTHON = Path('E:/IOS-MIX1-artifacts/host-usb-venv/Scripts/python.exe')
+IMAGE_SHA = '47740664f56fcf021096493444cc96934223f49ce0dfc099920bfb73cfc426ed'
+CAPTURE_SHA = 'd5a9aecdd3c5ac728b233628d9ae810a598a35ba05d9068d0db3ed70fde3791c'
+now = lambda: datetime.now().astimezone().isoformat()
+sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
+read = lambda p: json.loads(p.read_text(encoding='utf-8'))
+
+
+def save(path, data):
+    path.write_text(json.dumps(data, ensure_ascii=False, indent=2)+'\n', encoding='utf-8')
+
+
+def require(ok, message):
+    if not ok:
+        raise RuntimeError(message)
+
+
+def command(argv, timeout=20):
+    path = LOCAL/'commands.json'
+    rows = read(path) if path.exists() else []
+    row = dict(started_at=now(), argv=list(map(str, argv)))
+    rows.append(row)
+    save(path, rows)
+    try:
+        proc = subprocess.run(row['argv'], capture_output=True, text=True,
+            encoding='utf-8', errors='replace', timeout=timeout)
+        row.update(finished_at=now(), returncode=proc.returncode,
+                   stdout=proc.stdout, stderr=proc.stderr)
+    except Exception as exc:
+        row.update(finished_at=now(), exception=str(exc))
+        save(path, rows)
+        raise
+    save(path, rows)
+    require(proc.returncode == 0, 'Device command failed; no retry')
+    return proc.stdout+proc.stderr
+
+
+def boot():
+    require(not GUARD.exists() and not LOCAL.exists(), 'R34 UFS attempt already exists; stop')
+    c = read(PACKAGE/'contract.json')
+    prepared = read(ROOT/'reports/hakios-ios16-touch-r34-prepared.json')
+    require(c['passed'] and c['profile'] == 'ufs' and
+        c['image']['sha256'] == IMAGE_SHA and c['normal_boot_may_write_userdata'] and
+        not c['return_fastboot'], 'Wrong R34 UFS profile')
+    image = PACKAGE/c['image']['path']
+    require(sha(image) == IMAGE_SHA and image.stat().st_size == c['image']['bytes'], 'Image differs')
+    for name, item in c['components'].items():
+        require(sha(PACKAGE/name) == item['sha256'], 'Frozen component differs: '+name)
+    for name, digest in prepared['source_sha256'].items():
+        require(sha(ROOT/name) == digest, 'Prepared source differs: '+name)
+    require(c['cmdline'] == prepared['profiles']['ufs']['cmdline'], 'Boot arguments differ')
+    require(sha(ROOT/'scripts/capture-hakios-usb.py') == CAPTURE_SHA, 'Receiver differs')
+    require(FASTBOOT.is_file() and USB_PYTHON.is_file(), 'Host tools missing')
+    LOCAL.mkdir()
+    state = dict(schema=1, revision='R34-touch-live-ufs',
+        authorization='User: 测试呀，手机已经连接了; follows the disclosed UFS desktop scope and normal Data writes',
+        scope='One temporary frozen UFS desktop boot, existing R20 root/Data and display configuration, '
+              'GPIO89 reset and QUP6 reports into HakiOS/backboardd, USB capture; normal filesystem writes allowed',
+        image_sha256=IMAGE_SHA, payload_boot_args=c['cmdline'],
+        temporary_boot_issued=False, partition_commands=0, firmware_downloads=0,
+        adb_commands=0, qemu=False, automatic_retry=False,
+        normal_boot_may_write_userdata=True, automatic_fastboot_enabled=False,
+        kernel_timer_seconds=10800, usb_wait_seconds=180, usb_capture_seconds=12600,
+        started_at=now())
+    save(LOCAL/'authorization.json', state)
+    save(LOCAL/'result.json', state)
+    target = read(ROOT/'reports/local/hakios-device-target.json')
+    try:
+        lines = command([FASTBOOT, 'devices']).strip().splitlines()
+        require([s.split() for s in lines] == [[target['serial'], 'fastboot']], 'Target absent/mismatched; stop')
+
+        def query(key):
+            text = command([FASTBOOT, '-s', target['serial'], 'getvar', key])
+            match = re.search(re.escape(key)+r':\s*([^\r\n]+)', text)
+            require(match is not None, 'Missing field '+key)
+            return match[1].strip()
+
+        require(query('product') == target['product'], 'Product mismatch')
+        text = command([FASTBOOT, '-s', target['serial'], 'oem', 'device-info'])
+        require(re.search(r'Device unlocked:\s*true', text, re.I), 'Locked bootloader')
+        require(query('battery-soc-ok').lower() == 'yes', 'Battery not ready')
+        require(int(query('max-download-size'), 16) >= image.stat().st_size, 'Download window too small')
+        state.update(preflight_passed=True, preflight_finished_at=now())
+        private = LOCAL/image.name
+        shutil.copyfile(image, private)
+        require(sha(private) == IMAGE_SHA, 'Private image differs')
+        capture = LOCAL/'capture-host.py'
+        shutil.copyfile(ROOT/'scripts/capture-hakios-usb.py', capture)
+        intent = dict(started_at=now(), image_sha256=IMAGE_SHA, accepted=False, no_retry=True)
+        with GUARD.open('x', encoding='utf-8') as stream:
+            json.dump(intent, stream, indent=2)
+        with (LOCAL/'usb-host.txt').open('x', encoding='utf-8') as log:
+            receiver = subprocess.Popen([str(USB_PYTHON), '-B', '-u', str(capture),
+                '--output', str(LOCAL/'console.log'), '--status', str(LOCAL/'usb-status.json'),
+                '--wait', '180', '--duration', '12600', '--stop-file', str(LOCAL/'stop-usb')],
+                stdout=log, stderr=subprocess.STDOUT, creationflags=subprocess.CREATE_NO_WINDOW)
+        save(LOCAL/'usb-process.json', dict(pid=receiver.pid, started_at=now(), capture_sha256=sha(capture)))
+        for _ in range(30):
+            if (LOCAL/'usb-status.json').exists() or receiver.poll() is not None:
+                break
+            time.sleep(.1)
+        require(receiver.poll() is None and (LOCAL/'usb-status.json').exists(), 'Receiver failed; no boot')
+        state.update(temporary_boot_issued=True, outcome='boot_command_starting')
+        save(LOCAL/'result.json', state)
+        text = command([FASTBOOT, '-s', target['serial'], 'boot', private], timeout=90)
+        require(re.search(r'Booting\s+OKAY', text), 'Boot outcome uncertain; no retry')
+        state.update(command_accepted=True, accepted_at=now(), outcome='boot_accepted_observation_pending',
+                     boot_totals=dict(hakios=60, ios16=29))
+        intent.update(accepted=True, accepted_at=state['accepted_at'])
+        save(GUARD, intent)
+        save(LOCAL/'result.json', state)
+        print('R34 final UFS desktop image accepted ONCE; USB capture running.')
+    except Exception as exc:
+        state.update(outcome='stopped_no_retry', failure=str(exc), stopped_at=now())
+        save(LOCAL/'result.json', state)
+        if GUARD.exists():
+            (LOCAL/'stop-usb').touch()
+        raise
+
+
+if __name__ == '__main__':
+    boot()
