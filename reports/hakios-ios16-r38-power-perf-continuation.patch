+        r38u_read(c, 0x06400004, &c->pwr_l) ||
+        r38u_read(c, 0x099d2018, &c->bhs) ||
+        r38u_read(c, 0x099d2060, &c->pgs) ||
+        r38u_read(c, 0x09820fd0, &c->apcs) ||
+        r38u_read(c, 0x09a10fd0, &c->saw)) return 0;
