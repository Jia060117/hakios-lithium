+def run():
+    provenance = sources()
+    status_raw, status_meta = snapshot(LOCAL / "usb-status.json")
+    try:
+        receiver = json.loads(status_raw) if status_raw else {}
+    except (ValueError, UnicodeError):
+        receiver = {"parse_error": "saved status JSON incomplete"}
+    console, console_meta = snapshot(LOCAL / "console.log")
+    frames, frames_meta = snapshot(LOCAL / "console.frames")
+    parser_raw, parser_meta = snapshot(Path(__file__))
+    review = analyze(console or b"")
+    status_after, _ = snapshot(LOCAL / "usb-status.json")
+    stable = status_raw == status_after and all(m.get("read_stable") for m in (console_meta, frames_meta))
+    finished = bool(receiver.get("finished_at")) and receiver.get("status") not in (None, "waiting", "connecting", "capturing")
+    audit = None
+    audit_error = None
+    # Offline audit imports only Decoder, never calls capture-host.main(). -B
+    # and dont_write_bytecode prevent cache writes outside this owned folder.
+    if finished and stable and console is not None and frames is not None:
+        try:
+            audit_name = "scripts/hakios_usb_audit.py"
+            capture, capture_meta = snapshot(LOCAL / "capture-host.py")
+            if not provenance[audit_name]["pinned_match"] or sha(capture or b"") != PINNED["scripts/capture-hakios-usb.py"]:
+                raise ValueError("Offline audit or saved receiver provenance mismatch")
+            spec = importlib.util.spec_from_file_location("r32_saved_offline_audit", ROOT / audit_name)
+            module = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(module)
+            audit = module.audit(frames, console, LOCAL / "capture-host.py")
+            audit["saved_receiver_source"] = capture_meta
+        except Exception as error:
+            audit_error = type(error).__name__ + ": " + str(error)
+    final = bool(finished and stable and audit and audit.get("emitted_kernel_stream_through_timer_verified"))
+    state = "final_audited" if final else "provisional" if console is not None else "waiting_for_saved_console"
+    report = {"schema": 1, "state": state, "generated_at": datetime.datetime.now().astimezone().isoformat(),
+              "scope": "Host saved-file analysis only; author writes confined to evidence/touch-r32-20261120/runtime-review/; no device commands/query/USB open/boot/Fastboot/ADB/QEMU/Git/network.",
+              "image_sha256_expected": IMAGE_SHA, "image_hash_independently_rechecked_here": False,
