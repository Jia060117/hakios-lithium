+def write_markdown(report, path, json_sha):
+    runtime = report["runtime"]
+    single = runtime["singletons"]
+    lines = ["# R32 independent saved-log runtime review", "", f"State: **{report['state']}**. Generated {report['generated_at']}.", "",
+             report["scope"], "", f"JSON companion SHA256: `{json_sha}`.", "",
+             f"Diagnosis: **{runtime['diagnosis']}**; stopped at **{runtime['stop_stage']}**. Runtime transfer accepted: **{runtime['runtime_transfer_accepted']}**.", "",
+             "The saved raw evidence controls this conclusion; the result's NACK reason has priority over other simultaneously asserted STATUS error flags.", ""]
+    for kind in ["result", "progress", "counters", "initializer", "rx", "failure", "end"]:
+        lines += [f"- {kind}: `{json.dumps(single[kind], ensure_ascii=False)}`"]
+    lines += ["", "## Raw samples and count observations", "", "| Sample | ERROR | STATUS | OP | STATE | IN raw | OUT raw |", "|---|---:|---:|---:|---:|---:|---:|"]
+    for stage in STAGES:
+        v = runtime["samples"][stage]["registers"]
