+    result, progress, counts, rx, init, end = [single[k] for k in ["result", "progress", "counters", "rx", "initializer", "end"]]
+    ended = bool(end)
+    check("well_formed_transfer_records", not malformed, malformed)
+    for kind in single:
+        n = len(select(kind))
+        check("one_" + kind, n == 1, {"records": n}, ended or n > 0)
+    groups, field_rows = {}, []
+    specs = [(f"init.{p}.{q}", {"stage": "init", "phase": p, "pass": q}, CATALOG) for p in range(8) for q in range(2)]
+    specs += [(f"init_poll.{s}", {"stage": "init_poll", "slot": s}, SAMPLE_NAMES[:5]) for s in range(4)]
+    specs += [("guard", {"stage": "guard"}, CATALOG)]
+    specs += [(s, {"stage": s}, SAMPLE_NAMES) for s in STAGES]
+    for key, conditions, names in specs:
+        records = select("field", **conditions)
+        fields = []
+        for i, name in enumerate(names):
+            found = [r for r in records if r["values"].get("index") == i]
+            if len(found) == 1:
+                r = found[0]
+                v = r["values"]
+                okay = v.get("reg") == name and v.get("valid") in (0, 1) and (
+                    isinstance(v.get("value"), int) and 0 <= v["value"] <= 0xffffffff
+                    if v.get("valid") == 1 else v.get("value") is None)
+                fields.append({"index": i, "reg": name, "valid": v.get("valid"), "value": v.get("value"),
+                               "record_valid": okay, "line": r["line"], "byte_offset": r["byte_offset"]})
+            else:
