+#!/usr/bin/env python3
+"""One-shot, saved-file-only independent R32 review. No device or process APIs.
+
+Run with python -B. Outputs are confined beside this script. Re-run explicitly
+when new saved evidence is available; no polling thread, USB open, recovery,
+subprocess, network, Git, or edits to input files. Synthetic self-tests are
+separate from runtime evidence. Finality requires finished receiver + offline
+audit using scripts/hakios_usb_audit.py; success is never inferred from RX alone.
+"""
+import argparse
+import copy
+import datetime
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[2]
+LOCAL = ROOT / "reports/local/20261120-r32-touch-qup-transfer-approved"
+IMAGE_SHA = "b260776a3fff5513134b2c594e364eb58fb95a495c9a7625e6866354345fe767"
+P = "ports/hakios-lithium/peripherals/"
+PROTOCOL = "evidence/touch-r32-20261120/protocol/protocol-audit.md"
+PINNED = {
+    P + "touch-qup-transfer.inc": "6cdaa767f9cc3588080be71450d3f581780e40cc7ee9d0e394ca50d00f0d29b9",
+    P + "touch-qup-transfer-core.h": "204c640687190f5c16d1437ddfb85281cbbf91e0927c41c623357e35d90ff53d",
+    P + "touch-qup-phase-core.h": "6ff510c6deb801115929d70b3a6d1284e6640f63e2b1af02972ec9c723824fc9",
+    P + "touch-snapshot-core.h": "8f8e37552b2c05989a748827bda456a6b242398b4db797961099584bd6125b4f",
+    "scripts/hakios_usb_audit.py": "65b65ff0d99b7724a8f8673696385660e65b3c7766be9355fc830e22da1553cf",
+    "scripts/capture-hakios-usb.py": "d5a9aecdd3c5ac728b233628d9ae810a598a35ba05d9068d0db3ed70fde3791c",
+    PROTOCOL: "6bc5b2f7630676a3c657ad61fd7d9224e3255c4009a756ba26ec4a1b1b792ea0",
+    "evidence/touch-r31-20261120/protocol/micode-i2c-msm-v2.h": "2b8d8ef3070516fc8afff4b82545d2241d1afe6c40591a215d9450e0c90743f8",
+    "evidence/touch-r31-20261120/protocol/i2c-msm-prof-dbg.c": "53723fb856115c4ed1dd6e1ca66c0b1695523ecd1947d65acccb1c181cc94eba",
+}
+ANCHORS = {
+    P + "touch-qup-transfer.inc": [(17, 33), (92, 113), (139, 169), (170, 227)],
+    P + "touch-qup-transfer-core.h": [(98, 118), (193, 218), (224, 271), (300, 350), (363, 438), (475, 576)],
+    P + "touch-qup-phase-core.h": [(149, 164), (327, 398), (500, 555)],
+    P + "touch-snapshot-core.h": [(64, 87)],
+    "scripts/hakios_usb_audit.py": [(16, 66)],
+    "scripts/capture-hakios-usb.py": [(33, 66), (85, 105), (138, 172)],
+    PROTOCOL: [(66, 115), (119, 139), (193, 210)],
+    "evidence/touch-r31-20261120/protocol/micode-i2c-msm-v2.h": [(127, 141), (163, 171)],
+    "evidence/touch-r31-20261120/protocol/i2c-msm-prof-dbg.c": [(196, 214)],
+}
+
+# Independent numeric oracle: deliberately NOT parsed from production tables.
+ORACLE = [
+    (0x00c, 1), (0x004, 0), (0x000, 0x207), (0x020, 0x3c),
+    (0x028, 0x300), (0x408, 1), (0x020, 0), (0x028, 0x300),
+    (0x200, 0), (0x100, 0), (0x208, 3), (0x150, 9),
+    (0x000, 0x207), (0x008, 0xc0a5), (0x408, 1), (0x004, 1),
+    (0x400, 0x003e007c), (0x004, 3),
+    (0x110, 0x01827081), (0x110, 0x877181a3), (0x110, 1), (0x004, 1),
+]
+CATALOG = ["VERSION", "STATE", "CONFIG", "IO_MODES", "OPERATIONAL", "ERROR_FLAGS",
+           "ERROR_FLAGS_EN", "OPERATIONAL_MASK", "OUT_FIFO_COUNT", "IN_FIFO_COUNT",
+           "MX_OUTPUT", "MX_INPUT", "MX_READ", "MX_WRITE", "MASTER_CONFIG", "CLK_CTL", "I2C_STATUS"]
+SAMPLE_NAMES = ["VERSION", "ERROR", "STATUS", "OPERATIONAL", "STATE", "IN_COUNT", "OUT_COUNT"]
+STAGES = ["pre_load0", "pre_load1", "pre_load2", "pre_run", "completion", "post_rx", "stop", "first_failure"]
+PHASES = ["pre", "post_reset", "base", "setup", "run", "clock", "pause", "terminal"]
+UNVERIFIED = [
+    "Physical ACK/NACK, START/repeated-START/STOP waveforms and electrical cause.",
+    "Actual target at 0x38, returned chip identity and FT5x46 model; no identity is inferred.",
+    "Ownership/secure-world exclusion and concurrent handlers/other execution environments.",
+    "Complete error/completion visibility with ERROR_EN=0 and OP_MASK=0x300.",
+    "FIFO occupancy-count units, transient semantics and non-consuming count-port reads.",
+    "Numeric DAT/CLK/O/I FSM legality; the named dynamic fields are not a universal legal-state table.",
+    "BUS_MASTER deassertion universality; R32 STOP predicate is stricter than vendor BUS_ACTIVE alone.",
+    "Physical final screen, actual touch reports, IRQ/HID delivery and general touch functionality.",
+    "All firmware/daemon/original printf output; saved framed kernel stream has narrower audit scope.",
+    "Permanent MMIO hangs/aborts/SError/XPU faults are outside returning-call time bounds.",
+]
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def snapshot(path):
+    """Read an existing regular saved file; retain exact read bytes + stat bracket."""
+    if not path.is_file():
+        return None, {"path": str(path), "exists": False}
+    before = path.stat()
+    raw = path.read_bytes()
+    after = path.stat()
+    return raw, {"path": str(path), "exists": True, "bytes": len(raw), "sha256": sha(raw),
+                 "mtime_ns": after.st_mtime_ns,
+                 "read_stable": before.st_size == after.st_size == len(raw)
+                 and before.st_mtime_ns == after.st_mtime_ns}
+
+
+def sources():
+    result = {}
+    for name, expected in PINNED.items():
+        raw, meta = snapshot(ROOT / name)
+        meta.update(expected_sha256=expected, pinned_match=bool(raw and sha(raw) == expected))
+        lines = (raw or b"").splitlines(keepends=True)
+        meta["anchors"] = []
+        for first, last in ANCHORS.get(name, []):
+            excerpt = b"".join(lines[first - 1:last])
+            meta["anchors"].append({"first_line": first, "last_line": min(last, len(lines)),
+                                    "sha256": sha(excerpt), "text": excerpt.decode("utf-8")})
+        result[name] = meta
+    return result
+
+
+def scalar(value):
+    if value == "unread":
+        return None
+    if re.fullmatch(r"0x[0-9a-fA-F]+|[0-9]+", value):
+        return int(value, 16 if value.startswith("0x") else 10)
+    return value
+
+
+def decode_status(value):
+    if value is None:
+        return None
+    bitnames = {2: "BUS_ERROR", 3: "PACKET_NACKED", 4: "ARB_LOST", 5: "INVALID_WRITE",
+                6: "FAILED_bit6", 7: "FAIL_field_bit7", 23: "INVALID_TAG",
+                24: "INVALID_READ_ADDR", 25: "INVALID_READ_SEQ"}
+    return {"raw": value, "raw_hex": f"0x{value:08x}",
+            "error_mask_hex": f"0x{value & 0x038000fc:08x}",
+            "asserted_error_bits": [{"bit": b, "name": n} for b, n in bitnames.items() if value & (1 << b)],
+            "fail_two_bit_field": (value >> 6) & 3, "nack": bool(value & 8),
+            "unknown_bits_hex": f"0x{value & 0xf0400002:08x}",
+            "write_buffer_full": value & 1, "bus_active": (value >> 8) & 1,
+            "bus_master": (value >> 9) & 1, "dat_state": (value >> 10) & 7,
+            "clk_state": (value >> 13) & 7, "o_fsm": (value >> 16) & 7,
+            "i_fsm": (value >> 19) & 7, "sda": (value >> 26) & 1, "scl": (value >> 27) & 1}
+
+
+def parse(console):
+    rows, malformed, offset = [], [], 0
+    for line_no, raw in enumerate(console.splitlines(keepends=True), 1):
+        marker = b"LITHIUM TOUCH transfer "
+        where = raw.find(marker)
+        if where >= 0 and raw.endswith(b"\n"):
+            text = raw[where + len(marker):].decode("ascii", "replace").strip()
+            kind, _, rest = text.partition(" ")
+            pairs = re.findall(r"([a-z_]+)=([^\s]+)", rest)
+            row = {"kind": kind, "values": {k: scalar(v) for k, v in pairs},
+                   "line": line_no, "byte_offset": offset + where, "raw": raw.decode("utf-8", "replace").rstrip("\r\n")}
+            if len(pairs) != len(row["values"]) or " ".join(k + "=" + v for k, v in pairs) != rest:
+                malformed.append(row)
+            rows.append(row)
+        offset += len(raw)
+    return rows, malformed
+
+
+def analyze(console):
+    rows, malformed = parse(console)
+    checks = []
+    def check(name, condition, details=None, available=True):
+        checks.append({"name": name, "status": "pass" if condition else "fail" if available else "unverified", "details": details})
+    def select(kind, **conditions):
+        return [r for r in rows if r["kind"] == kind and all(r["values"].get(k) == v for k, v in conditions.items())]
+    def one(kind, **conditions):
+        found = select(kind, **conditions)
+        return found[0]["values"] if len(found) == 1 else {}
