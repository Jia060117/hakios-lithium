+/* Bit-by-bit oracle avoids duplicating production shift/mask expressions. */
+static uint32_t bits(uint64_t word, unsigned first, unsigned last)
+{
+    uint32_t v = 0u;
+    unsigned i;
+    for (i = first; i <= last; ++i)
+        if ((word & (UINT64_C(1) << i)) != 0u)
+            v |= UINT32_C(1) << (i - first);
+    return v;
