+#!/usr/bin/env python3
+"""One-shot G1 prerequisites capture runner. Default/--check is host-only.
+
+Only a future explicit main invocation of --boot or --verify-return permits
+device access. Reuse G0/R37 preflight, USB-before-boot, consumed guards and
+240..900s return window. Stage 1 and chip-ID acceptance stay disabled.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(value)
+    return value
+
+
+G0 = load("_g1_private_g0_runner", ROOT / "reports/local/run-gpu-g0.py")
+BASE = G0.BASE
+PKG = load("_g1_precheck_package_admission", ROOT / "scripts/package-hakios-gpu-g1.py")
+RunnerError = BASE.RunnerError
+PACKAGE_ROOT = PKG.PACKAGE_ROOT
+ATTEMPTS_ROOT = PACKAGE_ROOT / "runs"
+DEFAULT_ATTEMPT_ID = "gpu-g1-precheck-02"
+PHASE = "g1-precheck"
+
+
+def validate_attempt_id(attempt_id, phase=PHASE):
+    BASE.require(phase == PHASE and re.fullmatch(r"gpu-g1-precheck-[0-9]{2}", attempt_id) is not None,
+                 "use a new prerequisites capture attempt: gpu-g1-precheck-NN")
+    BASE.require(attempt_id.rsplit("-", 1)[1] in PKG.SUPPORTED_REVISIONS,
+                 "supported G1 precheck revisions are 01 and 02")
+
+
+def attempt_suffix(attempt_id, phase=PHASE):
+    validate_attempt_id(attempt_id, phase)
+    return attempt_id.rsplit("-", 1)[1]
+
+
+def package_for_attempt(attempt_id, phase=PHASE, artifacts_root=PACKAGE_ROOT):
+    return artifacts_root / f"g1-precheck-{attempt_suffix(attempt_id, phase)}"
+
+
+def resolve_package(phase, attempt_id, package, contract_path, artifacts_root=PACKAGE_ROOT):
+    expected = package_for_attempt(attempt_id, phase, artifacts_root)
+    selected = expected if package is None else Path(package)
+    BASE.require(selected.resolve() == expected.resolve(), "G1 precheck package/attempt mismatch")
+    contract = selected / "contract.json" if contract_path is None else Path(contract_path)
+    BASE.require(contract.resolve() == (selected / "contract.json").resolve(), "G1 contract mismatch")
+    return selected, contract
+
+
+def validate_package(package, contract_path, phase, attempt_id):
+    validate_attempt_id(attempt_id, phase)
+    BASE.require(contract_path == package / "contract.json", "G1 contract must be package-local")
+    result = PKG.verify_package(package, attempt_suffix(attempt_id, phase))
+    contract = BASE.load_json(contract_path)
+    BASE.validate_no_physical_ufs_proof(contract)
+    return {"contract": contract, "image": Path(result["image"]), "image_sha256": result["image_sha256"],
+            "image_bytes": result["image_bytes"], "cmdline": result["cmdline"],
+            "component_count": result["component_count"], "profile": contract["profile"],
+            "candidate": contract["candidate"]}
+
+
+BASE.validate_attempt_id = validate_attempt_id
+BASE.attempt_suffix = attempt_suffix
+BASE.package_for_attempt = package_for_attempt
+BASE.resolve_package = resolve_package
+BASE.validate_package = validate_package
+
+
+def boot(*, attempt_id=DEFAULT_ATTEMPT_ID, **kwargs):
+    validate_attempt_id(attempt_id)
+    return BASE.boot(phase=PHASE, attempt_id=attempt_id, attempts_root=ATTEMPTS_ROOT,
+                     artifacts_root=PACKAGE_ROOT, **kwargs)
+
+
+def verify_return(*, attempt_id=DEFAULT_ATTEMPT_ID, **kwargs):
+    validate_attempt_id(attempt_id)
+    local = kwargs.get("local") or ATTEMPTS_ROOT / attempt_id
+    target_path = kwargs.get("target_path", BASE.TARGET)
+    BASE.require((local / "target-at-boot.json").is_file(), "boot target snapshot missing; no query")
+    BASE.require(BASE.load_json(target_path) == BASE.load_json(local / "target-at-boot.json"),
+                 "configured target changed since boot; no return query")
+    return BASE.verify_return(phase=PHASE, attempt_id=attempt_id, attempts_root=ATTEMPTS_ROOT,
+                              artifacts_root=PACKAGE_ROOT, **kwargs)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    actions = parser.add_mutually_exclusive_group()
+    actions.add_argument("--check", action="store_true", help="host-only precheck package readback")
+    actions.add_argument("--boot", action="store_true", help="future explicit main invocation only")
+    actions.add_argument("--verify-return", action="store_true", help="future one-shot endpoint check")
+    parser.add_argument("--attempt-id", default=DEFAULT_ATTEMPT_ID)
+    args = parser.parse_args(argv)
+    try:
+        validate_attempt_id(args.attempt_id)
+        if args.boot:
+            boot(attempt_id=args.attempt_id)
+        elif args.verify_return:
