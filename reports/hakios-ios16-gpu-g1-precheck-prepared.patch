+static struct lgs_io io_for(struct mock *m)
+{
+    return (struct lgs_io){m, read32, write32, time_us, delay_us};
+}
+static struct lgs_route probe(struct mock *m, uint32_t sid)
+{
+    struct lgs_io io = io_for(m);
