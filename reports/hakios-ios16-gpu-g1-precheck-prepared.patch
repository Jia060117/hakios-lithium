+static enum lgs_error run(struct mock *m, const struct lgs_route *route,
+                          uint32_t sid, uint32_t addr, uint32_t len,
+                          struct lgs_result *r)
+{
+    struct lgs_io io = io_for(m);
+    return lgs_read(&io, route, sid, addr, len, r);
+}
