+"""Host-only pinned stock corner2 calculator. No device access or rail writes.
+
+python -B evidence/gpu-g1-20261123/fuses/calculate-stock133.py
+python -B evidence/gpu-g1-20261123/fuses/calculate-stock133.py \
+    --capture <two-pass-capture.json> --output <filename-in-fuses.json>
+
+Capture schema is demonstrated by pending-raw-input.json. Every valid row
+must cite a line of an existing captured console whose full SHA256 matches.
+Outputs stay in this script's directory. Missing rows produce no voltage.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+ROWS = (39, 41, 63, 64, 66, 68)
+PIN = "1492c8e4373b7428bb0accc4f4881e97b36508b9"
+G0 = ROOT / "evidence/gpu-g0-20261123/power-zap"
+EXPECTED = {
+    G0 / "sources/micode/drivers/regulator/cpr3-mmss-regulator.c":
+        "8864d338a4fc011b4ab3d5f2394d16e3589eccccb67b7b3a8a1877621d667fcf",
+    HERE / "micode-cpr3-util.c":
+        "46187dd2028533b6459d5506ab72c738c49039a3f3363f8b46b16d3c14cefe8a",
+    G0 / "sources/micode/drivers/regulator/cpr3-regulator.c":
+        "a8d2efa596f6a4d47dd4c1a000373eacc16285b918e3d58cb764e9a1f0382c06",
+    G0 / "sources/stock/lithium-stock.dts":
+        "2252e2fb6c8b28c4d5db6e390e3618e5e6a0a42d51779822f16d0ea640c45df8",
+    ROOT / "artifacts/stock/V9.5.2.0.NAHCNFA/dtbs/03.dtb":
+        "93dc50ef24a5a6e56c19346ce5c1aa43c11f1e1842970d150020cde6c3b79985",
+}
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def uint(value, width):
+    if isinstance(value, bool) or not isinstance(value, (int, str)):
+        raise ValueError("unsigned integer required")
+    value = int(value, 0) if isinstance(value, str) else value
+    if not 0 <= value < (1 << width):
+        raise ValueError(f"value does not fit uint{width}")
+    return value
+
+
+def signed_steps(code, width):
+    code = uint(code, width)
+    sign = 1 << (width - 1)
+    return -(code & (sign - 1)) if code & sign else code
+
+
+def cells(text, name):
+    m = re.search(r"(?m)^\s*" + re.escape(name) + r"\s*=\s*<([^>]+)>;", text)
+    if not m:
+        raise ValueError("missing pinned property " + name)
+    return [uint(x, 32) for x in m.group(1).split()]
+
+
+def array_property(values, size, combo, speedbin, combos=16, bins=2):
+    # Source cpr3-util.c:323-330 precedence, not guessed revision indexing.
+    if len(values) == size:
+        offset, selector = 0, "shared"
+    elif len(values) == size * combos:
+        offset, selector = size * combo, "fuse_combo"
+    elif len(values) == size * bins:
+        offset, selector = size * speedbin, "speed_bin"
+    else:
+        raise ValueError("invalid pinned DT array length")
+    return values[offset:offset + size], {"selector": selector, "offset": offset,
+                                        "cells": len(values), "tuple_size": size}
+
+
+def pinned_policy():
+    verified = {}
+    for path, expected in EXPECTED.items():
+        actual = sha(path.read_bytes())
+        if actual != expected:
+            raise ValueError("source pin mismatch: " + str(path))
+        verified[path.relative_to(ROOT).as_posix()] = actual
+    text = (G0 / "sources/stock/lithium-stock.dts").read_text()
+    begin = text.index("cpr3-ctrl@838000 {")
+    end = text.index("\n\t\t};", begin)
+    node = text[begin:end]
+    compatible = re.search(r'compatible = "([^"]+)";', node).group(1)
+    if compatible != "qcom,cpr3-msm8996pro-mmss-regulator":
+        raise ValueError("stock133 policy requires verified Pro compatible")
+    mmss = (G0 / "sources/micode/drivers/regulator/cpr3-mmss-regulator.c").read_text()
+    match = re.search(r"msm8996pro_mmss_fuse_ref_volt[^=]*=\s*\{([^}]+)\}", mmss)
+    refs = [int(x) for x in re.findall(r"\d+", match.group(1))]
+    if refs != [670000, 745000, 905000, 1065000]:
+        raise ValueError("unexpected pinned reference table")
+    if cells(node, "reg") != [0x838000, 0x4000, 0x74000, 0x1000]:
+        raise ValueError("unexpected fuse aperture")
+    if cells(node, "qcom,cpr-fuse-combos") != [16] or \
+            cells(node, "qcom,cpr-speed-bins") != [2] or \
+            cells(node, "qcom,cpr-corners") != [9] * 16 or \
+            cells(node, "qcom,cpr-speed-bin-corners") != [9, 9]:
+        raise ValueError("unsupported stock corner layout")
+    if "qcom,cpr-scaled-open-loop-voltage-as-ceiling;" not in node:
+        raise ValueError("unexpected ceiling policy")
+    if "qcom,cpr-open-loop-voltage-adjustment =" in node:
+        raise ValueError("unimplemented per-corner open-loop trim")
+    if "qcom,cpr-aging-derate =" in node:
+        raise ValueError("unimplemented aging derate")
+    return node, refs, verified, compatible
+
+
+def capture_rows(capture):
+    provenance = capture["provenance"]
+    if provenance["kind"] not in ("saved_console_partial", "captured_console"):
+        raise ValueError("actual console capture provenance required")
+    source = Path(provenance["source"])
+    if not source.is_absolute():
+        source = ROOT / source
+    data = source.read_bytes()
+    if sha(data) != provenance["sha256"]:
+        raise ValueError("capture source SHA256 mismatch")
+    lines = data.decode("utf-8").splitlines()
+    passes = capture["passes"]
+    if len(passes) != 2 or [p["pass"] for p in passes] != [0, 1]:
+        raise ValueError("exactly ordered pass0/pass1 required")
+    values, masks = [], []
+    last_line = 0
+    for p in passes:
+        if [r["rowid"] for r in p["rows"]] != list(ROWS):
+            raise ValueError("exact six-row order required")
+        decoded, actualmask = {}, 0
+        for index, row in enumerate(p["rows"]):
+            if uint(row["physical"], 64) != 0x74000 + 8 * row["rowid"]:
+                raise ValueError("row/address mismatch")
+            if row["bits"] != 64 or type(row["valid"]) is not bool:
+                raise ValueError("actual 64-bit validity required")
+            if not row["valid"]:
+                if row["raw"] is not None:
+                    raise ValueError("invalid rows cannot contain substitute raw")
+                continue
+            raw = uint(row["raw"], 64)
+            line_no = row["line"]
+            if type(line_no) is not int or not last_line < line_no <= len(lines):
+                raise ValueError("capture lines must be ordered and in range")
+            last_line = line_no
+            line = lines[line_no - 1]
+            fields = dict(re.findall(r"\b(pass|pa|bits|valid|raw)=([^\s]+)", line))
+            if any(uint(fields[key], width) != expected for key, width, expected in
+                   [("pass", 32, p["pass"]), ("pa", 64, 0x74000 + 8 * row["rowid"]),
+                    ("bits", 32, 64), ("valid", 32, 1), ("raw", 64, raw)]):
+                raise ValueError("raw row does not match actual cited log line")
