+    ranges = select("qcom,cpr-floor-to-ceiling-max-range", 9)
+    aging = select("qcom,cpr-aging-max-voltage-adjustment", 1)[0]
+    aging_allowed = select("qcom,allow-aging-voltage-adjustment", 1)[0]
+    aging_open = select("qcom,allow-aging-open-loop-voltage-adjustment", 1)[0]
