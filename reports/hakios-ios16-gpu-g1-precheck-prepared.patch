+        assert r["analog_voltage_uv"] is None and not r["settled_permission"]
+    assert not decode(raw(3, 8, 0, 96))["programmable_range_and_grid_valid"]
+    assert not decode(raw(3, 8, 1, 0))["preferred_selector_valid"]
+    assert not decode(raw(0x1c, 0x0a, 0x89, 3))["programmable_range_and_grid_valid"]
+    for typ, sub in [(3, 9), (3, 0x0a), (0x1c, 7), (0, 0), (0x21, 8)]:
+        assert decode(raw(typ, sub, 0, 42))["error"] == "unsupported_type_subtype"
+    assert decode(raw(3, 8, 2, 42))["error"] == "unknown_voltage_range"
+    assert decode(raw(3, 8, 0, 256))["error"] == "invalid_raw_byte"
+    assert decode(raw(3, 8, 0, True))["error"] == "invalid_raw_byte"
+    c = raw(3, 8, 0, 42); c["valid_fields"].remove("VSET")
+    assert decode(c)["error"] == "missing_valid_fields"
+    c = raw(3, 8, 0, 42); c["base"] = 0x1400
+    assert decode(c)["error"] == "unsupported_rail"
+    c = raw(3, 8, 0, 42, ENABLE=0x80)
+    assert decode(c)["digital_sw_enable_bit"]
+    c["fields"]["ENABLE"] = 0
+    assert not decode(c)["digital_sw_enable_bit"]
+    c["stable_fields"] = [{}]
+    assert not decode(c)["required_bytes_two_pass_stable"]
+    c["stable_fields"] = sorted(REQUIRED)
+    assert decode(c)["required_bytes_two_pass_stable"]
+    return dict(passed=True, source_literal_vectors=len(vectors), edge_checks=17,
+        hardware_verified=False, analog_voltage_measured=False)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input")
+    parser.add_argument("--self-check", action="store_true")
+    args = parser.parse_args()
