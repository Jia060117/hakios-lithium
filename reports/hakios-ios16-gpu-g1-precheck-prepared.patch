+        (3, 8, 0, 95, 1562500), (3, 8, 1, 0, 1550000),
+        (3, 8, 1, 63, 3125000), (0x1c, 8, 0, 181, 905000),
+        (0x1c, 8, 1, 128, 1280000), (0x1c, 9, 0, 165, 905000),
+        (0x1c, 9, 1, 120, 1360000), (0x1c, 0x0a, 0xb0, 4, 1200000),
+        (0x1c, 0x0a, 0x89, 3, 905000)]
