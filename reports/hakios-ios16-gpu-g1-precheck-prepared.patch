+            "combo": combo, "revision": fields["revision"],
+            "speedbin": fields["speedbin"], "stock_corner": 2,
+            "array_index": 1, "frequency_hz": 133000000, "fuse_corner_index": 0,
+            "interpolation_at_target": False, "array_selection": selections,
+            "reference_uv": refs, "fuse_adjustment_uv": trims,
+            "round_up_step_uv": step, "absolute_ceiling_uv": ceiling[1],
+            "initial_dt_floor_uv": floor[1], "max_floor_to_ceiling_range_uv": ranges[1],
+            "maximum_startup_aging_uv": aging,
+            "formula": {
