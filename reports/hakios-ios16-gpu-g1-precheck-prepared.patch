+"""Host-only interpretation of valid G1 raw bytes; never hardware/analog proof.
+
+Pinned MiCode 1492c8e4373b7428bb0accc4f4881e97b36508b9:
+  qpnp-regulator.c:67-109 (types/subtypes), 117-139 (layouts),
+  417-429,457-459 (ranges), 932-954,1139-1144 (actual get_voltage),
+  1637,1665-1667,1693-1694 (all-revision matches), 1697-1743 (selection).
+
+JSON input: {"sid":3,"base":5888,"fields":{"TYPE":3,"SUBTYPE":8,
+"RANGE":0,"VSET":42},"valid_fields":["TYPE","SUBTYPE","RANGE","VSET"]}
+Invoke with --input FILE, or run --self-check for source-literal cases.
+No production integration; no register writes or guessed chip subtype.
+"""
+import argparse
+import json
+
+REQUIRED = {"TYPE", "SUBTYPE", "RANGE", "VSET"}
+# (min_uV, step_uV, max_uV, preferred_min_uV, preferred_max_uV)
+LAYOUTS = {
+    (0x03, 0x08): ("SMPS/common", {
+        0: (375000, 12500, 1562500, 375000, 1562500),
+        1: (1550000, 25000, 3125000, 1575000, 3125000)}),
+    (0x1c, 0x08): ("FTSMPS/common", {
+        0: (0, 5000, 1275000, 350000, 1275000),
+        1: (0, 10000, 2040000, 1280000, 2040000)}),
+    (0x1c, 0x09): ("FTSMPS2p5/common", {
+        0: (80000, 5000, 1355000, 350000, 1355000),
+        1: (160000, 10000, 2200000, 1360000, 2200000)}),
+    (0x1c, 0x0a): ("FTSMPS426/common2-millivolts", {
+        0: (0, 4000, 1352000, 320000, 1352000)})
+}
+
+
+def byte(value):
+    return type(value) is int and 0 <= value <= 255
+
+
+def decode(capture):
+    result = dict(decoded=False, digital_setpoint_uv=None, analog_voltage_uv=None,
+        settled_permission=False, hardware_verified=False,
+        coherent_cross_field_snapshot_verified=False,
+        source="MiCode 1492c8e4373b7428bb0accc4f4881e97b36508b9 qpnp-regulator.c")
+    if not isinstance(capture, dict):
+        return dict(result, error="argument")
+    sid, base = capture.get("sid"), capture.get("base")
+    if type(sid) is not int or type(base) is not int or sid not in (1, 3) or base != 0x1700:
+        return dict(result, error="unsupported_rail")
+    fields = capture.get("fields")
+    valid = capture.get("valid_fields")
+    if not isinstance(fields, dict) or not isinstance(valid, list) or not all(isinstance(v, str) for v in valid):
+        return dict(result, error="explicit_valid_fields_required")
+    missing = sorted(REQUIRED - (set(valid) & set(fields)))
+    if missing:
+        return dict(result, error="missing_valid_fields", missing=missing)
+    if not all(byte(fields[name]) for name in REQUIRED):
+        return dict(result, error="invalid_raw_byte")
+    pair = (fields["TYPE"], fields["SUBTYPE"])
+    if pair not in LAYOUTS:
+        return dict(result, error="unsupported_type_subtype", type=pair[0], subtype=pair[1])
+    layout, ranges = LAYOUTS[pair]
+    if pair == (0x1c, 0x0a):
+        # The frozen table's RANGE/VSET labels mean LSB/MSB on common2.
+        uv = (fields["RANGE"] | fields["VSET"] << 8) * 1000
+        selector = None
+        limits = ranges[0]
+        interpretation = "0x40=millivolt LSB; 0x41=millivolt MSB"
+    else:
+        selector = fields["RANGE"]
+        if selector not in ranges:
+            return dict(result, error="unknown_voltage_range", layout=layout, range=selector)
+        limits = ranges[selector]
+        uv = limits[0] + fields["VSET"] * limits[1]
+        interpretation = "0x40=range selector; 0x41=8-bit voltage code"
+    minimum, step, maximum, preferred_minimum, preferred_maximum = limits
+    # Reproduce the source's read arithmetic even for off/unusual raw codes;
+    # report range/grid violations separately instead of silently clamping.
+    result.update(decoded=True, error=None, sid=sid, base=base, layout=layout,
+        register_interpretation=interpretation, range_selector=selector,
+        digital_setpoint_uv=uv,
+        programmable_range_and_grid_valid=(minimum <= uv <= maximum and
+                                           (uv - minimum) % step == 0),
+        preferred_selector_valid=(preferred_minimum <= uv <= preferred_maximum and
+                                   (uv - minimum) % step == 0))
