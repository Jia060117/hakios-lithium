+    CHECK(r.route.ppid == (sid == 3 ? 0x317u : 0x117u));
+    CHECK(r.route.observer_pa == m->observer && r.route.observer_bytes == 4096);
+    m->probe_only = 0; m->reads = 0; m->events = 0;
