+/* MIX observation budget: one window after the first submitted base layer.
+ * This is a display milestone, never a claim that SpringBoard is ready.
+ * The normal initial timeout remains when no image is submitted; any
+ * extension is bounded by the independent maximum from timer startup.
+ */
+#if defined(LITHIUM_ARMV8_0)
+static _Atomic uint64_t lithium_first_frame;
+static uint64_t lithium_observe_started, lithium_observe_limit;
+static uint32_t lithium_observe_seconds;
+static thread_call_t lithium_observe_call;
+
+void lithium_display_first_frame(void);
+void
+lithium_display_first_frame(void)
+{
+	uint64_t now = mach_absolute_time(), ns;
+	if (!lithium_observe_seconds ||
+	    !os_atomic_cmpxchg(&lithium_first_frame, 0, now, release)) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now - lithium_observe_started, &ns);
+	printf("LITHIUM UI OBSERVE: first base-layer frame at %llu ms; window %u seconds; desktop UNVERIFIED\n",
+	    (unsigned long long)(ns / NSEC_PER_MSEC), lithium_observe_seconds);
+}
+
+static bool
+lithium_observation_extend(void)
+{
+	uint64_t first = os_atomic_load(&lithium_first_frame, acquire), span, target, ns;
+	uint64_t now = mach_absolute_time();
+	if (!first || !lithium_observe_seconds) {
+		return false;
+	}
+	nanoseconds_to_absolutetime((uint64_t)lithium_observe_seconds * NSEC_PER_SEC, &span);
+	target = first + span;
+	if (target > lithium_observe_limit) target = lithium_observe_limit;
+	if (target <= now) return false;
+	absolutetime_to_nanoseconds(target - now, &ns);
+	printf("LITHIUM UI OBSERVE: extending %llu ms for first-frame observation; bounded total\n",
+	    (unsigned long long)(ns / NSEC_PER_MSEC));
+	thread_call_enter_delayed(lithium_observe_call, target);
+	return true;
+}
+#endif
+
