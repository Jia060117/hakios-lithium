+/* Maximum 28 physical rows at 57 columns, leaving room for the header and
+ * end banner in the board's 40-row console. Long/binary lines cannot wrap
+ * away the cause. Blank or control bytes are never interpreted as commands. */
+static uint32_t lithium_summary_rows;
+static const char *
+lithium_summary_line(const char *p, const char *end)
+{
+    uint32_t n=0, printable=0;
+    const char *next=p;
+    while (next<end && *next!='\n') {
+        if ((unsigned char)*next>=32 && (unsigned char)*next<127) printable++;
+        next++;
+    }
+    if (lithium_summary_rows>=28) return next<end ? next+1 : end;
+    if ((uint64_t)(next-p)>8 && printable*4<(uint64_t)(next-p)*3) {
+        print("[binary span omitted from display]\n"); lithium_summary_rows++;
+        return next<end ? next+1 : end;
+    }
+    for (;p<next && n<224 && (n/57)+lithium_summary_rows<28;p++,n++) {
+        unsigned char c=*p;
+        put_char(c>=32 && c<127 ? c : ' ');
+    }
+    put_char('\n'); lithium_summary_rows+=(n+56)/57 ? (n+56)/57 : 1;
+    return next<end ? next+1 : end;
+}
+
+static void
+lithium_summary_lines(const char *p, const char *end, unsigned count)
+{
+    while (p<end && count-- && lithium_summary_rows<28) p=lithium_summary_line(p,end);
+}
