+/* XNU 8796 kern/debug.h: packed embedded_panic_header v4 prefix.
+ * Read its declared text spans only; compressed kcdata stays in the raw RAM
+ * region and compose_logs. This decoder never changes the kernel panic path. */
+struct lithium_panic_prefix {
+    uint32_t magic, crc, version;
+    uint64_t flags;
+    uint32_t text_offset, text_len, stack_offset, stack_len;
+    uint32_t other_offset, other_len;
+} __attribute__((packed));
+_Static_assert(__builtin_offsetof(struct lithium_panic_prefix, text_offset)==20,
+    "XNU embedded panic header layout");
+
+static int
+lithium_panic_text(const void *region, uint64_t capacity, const char **text, uint64_t *bytes)
+{
+    struct lithium_panic_prefix h;
+    if (region==NULL || capacity<sizeof(h)) return 0;
+    memcpy(&h,region,sizeof(h));
+    if (h.magic!=0x46554e4b || h.version!=4 || h.text_offset<sizeof(h) ||
+        !h.text_len || h.text_offset>capacity || h.text_len>capacity-h.text_offset) return 0;
+    if (h.stack_len && (h.stack_offset<h.text_offset+h.text_len ||
+        h.stack_offset>capacity || h.stack_len>capacity-h.stack_offset)) return 0;
+    *text=(const char *)region+h.text_offset; *bytes=h.text_len;
+    return 1;
+}
+
+static const char *
+lithium_find(const char *text, uint64_t bytes, const char *key)
+{
+    uint64_t n=0;
+    while (key[n]) n++;
+    if (n>bytes) return NULL;
+    for (uint64_t i=0;i<=bytes-n;i++) if (memcmp(text+i,key,n)==0) return text+i;
+    return NULL;
+}
