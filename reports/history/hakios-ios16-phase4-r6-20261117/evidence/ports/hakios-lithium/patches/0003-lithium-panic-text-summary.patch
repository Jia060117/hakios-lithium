+    uint64_t text_bytes=bytes;
+    lithium_summary_rows=0;
+    print("LITHIUM IOS16 RETURN; RAW BYTES %d\n",bytes);
+    if (log==NULL) { print("Kernel did not supply a log\n"); return; }
