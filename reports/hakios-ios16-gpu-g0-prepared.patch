+        log = OUT / f"kernel-g0-01-attempt{n}.log"
+    with log.open("x", encoding="utf-8") as stream:
+        result = subprocess.run(["make", "kernel", "SHELL=/bin/bash",
+            "MAKEJOBS=--jobs=12", "DEVICE=lithium", "JOBS=12"], cwd=WORK,
