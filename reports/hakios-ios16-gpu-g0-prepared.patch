+#!/usr/bin/env python3
+"""G0 RAM one-shot runner. Default/--check is host-only and writes nothing.
+
+Only a future explicit main invocation of --boot or --verify-return authorizes
+device access. Reuse the R37 preflight, USB-before-boot, consumed intent and
+240..900s return window. G0 packages are independently reread before admission.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(value)
+    return value
+
+
+BASE = load("_g0_private_r37_runner", ROOT / "reports/local/run-cpu-r37-ram-measure.py")
+PKG = load("_g0_package_admission", ROOT / "scripts/package-hakios-gpu-g0.py")
+RunnerError = BASE.RunnerError
+PACKAGE_ROOT = PKG.PACKAGE_ROOT
+ATTEMPTS_ROOT = PACKAGE_ROOT / "runs"
+DEFAULT_ATTEMPT_ID = "gpu-g0-01"
+
+
+def validate_attempt_id(attempt_id, phase="g0"):
+    BASE.require(phase == "g0" and re.fullmatch(r"gpu-g0-[0-9]{2}", attempt_id) is not None,
+                 "use a new G0 attempt id: gpu-g0-NN")
+
+
+def attempt_suffix(attempt_id, phase="g0"):
+    validate_attempt_id(attempt_id, phase)
+    return attempt_id.rsplit("-", 1)[1]
+
+
+def package_for_attempt(attempt_id, phase="g0", artifacts_root=PACKAGE_ROOT):
+    return artifacts_root / f"g0-{attempt_suffix(attempt_id, phase)}"
+
+
+def resolve_package(phase, attempt_id, package, contract_path, artifacts_root=PACKAGE_ROOT):
+    expected = package_for_attempt(attempt_id, phase, artifacts_root)
+    selected = expected if package is None else Path(package)
+    BASE.require(selected.resolve() == expected.resolve(), "G0 package/attempt mismatch")
+    contract = selected / "contract.json" if contract_path is None else Path(contract_path)
+    BASE.require(contract.resolve() == (selected / "contract.json").resolve(), "G0 contract mismatch")
+    return selected, contract
+
+
+def validate_package(package, contract_path, phase, attempt_id):
+    validate_attempt_id(attempt_id, phase)
+    BASE.require(contract_path == package / "contract.json", "G0 contract must be package-local")
+    result = PKG.verify_package(package, attempt_suffix(attempt_id, phase))
+    contract = BASE.load_json(contract_path)
+    BASE.validate_no_physical_ufs_proof(contract)
+    return {"contract": contract, "image": Path(result["image"]),
+            "image_sha256": result["image_sha256"], "image_bytes": result["image_bytes"],
+            "cmdline": result["cmdline"], "component_count": result["component_count"],
+            "profile": contract["profile"], "candidate": contract["candidate"]}
+
+
+BASE.validate_attempt_id = validate_attempt_id
+BASE.attempt_suffix = attempt_suffix
+BASE.package_for_attempt = package_for_attempt
+BASE.resolve_package = resolve_package
+BASE.validate_package = validate_package
+_base_stop_capture = BASE.stop_capture
+_base_preflight = BASE.preflight
+
+
+def preflight(commands, target, image_bytes):
+    BASE.save_json(commands.path.parent / "target-at-boot.json", target)
+    return _base_preflight(commands, target, image_bytes)
+
+
+def stop_failed_capture(run_dir, process):
+    # A boot timeout/failure can leave a running kernel. Keep the same receiver
+    # for evidence, without reconnecting or issuing another device command.
+    state = BASE.load_json(run_dir / "result.json")
+    if state.get("boot_attempted") is True:
+        BASE.save_json(run_dir / "capture-preserved.json", {
+            "reason": "boot_attempted_outcome_uncertain", "pid": process.pid,
+            "receiver_preserved": True, "retry": False})
+        return
+    _base_stop_capture(run_dir, process)
+
+
+BASE.stop_capture = stop_failed_capture
+BASE.preflight = preflight
+
+
+def boot(*, attempt_id=DEFAULT_ATTEMPT_ID, **kwargs):
+    validate_attempt_id(attempt_id)
+    return BASE.boot(phase="g0", attempt_id=attempt_id, attempts_root=ATTEMPTS_ROOT,
+                     artifacts_root=PACKAGE_ROOT, **kwargs)
+
+
+def verify_return(*, attempt_id=DEFAULT_ATTEMPT_ID, **kwargs):
+    validate_attempt_id(attempt_id)
+    local = kwargs.get("local") or ATTEMPTS_ROOT / attempt_id
+    target_path = kwargs.get("target_path", BASE.TARGET)
+    BASE.require((local / "target-at-boot.json").is_file(), "boot target snapshot missing; no query")
+    BASE.require(BASE.load_json(target_path) == BASE.load_json(local / "target-at-boot.json"),
+                 "configured target changed since boot; no return query")
+    return BASE.verify_return(phase="g0", attempt_id=attempt_id, attempts_root=ATTEMPTS_ROOT,
+                              artifacts_root=PACKAGE_ROOT, **kwargs)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    actions = parser.add_mutually_exclusive_group()
+    actions.add_argument("--check", action="store_true", help="host-only saved package readback")
+    actions.add_argument("--boot", action="store_true", help="future explicit main invocation only")
+    actions.add_argument("--verify-return", action="store_true", help="future one-shot endpoint check")
+    parser.add_argument("--attempt-id", default=DEFAULT_ATTEMPT_ID)
+    args = parser.parse_args(argv)
+    try:
+        validate_attempt_id(args.attempt_id)
+        if args.boot:
+            boot(attempt_id=args.attempt_id)
+        elif args.verify_return:
+            return 0 if verify_return(attempt_id=args.attempt_id).get("passed") is True else 1
+        else:
+            result = PKG.verify_package(PKG.package_path(attempt_suffix(args.attempt_id)),
+                                        attempt_suffix(args.attempt_id))
+            import json
+            print(json.dumps(result, indent=2))
+        return 0
+    except Exception as error:
+        print(f"STOPPED WITHOUT RETRY: {error}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
