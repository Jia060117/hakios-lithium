+static void poison_and_resync(void)
+{
+    struct lithium_touch_delivery d = {0}; struct fake_queue q = {0};
+    uint8_t f[LITHIUM_TOUCH_FRAME_BYTES]; init(&d, &q); empty(f);
+    finger(f, 0, 0, 0, 100, 100); finger(f, 1, 1, 0, 200, 200);
+    assert(lithium_touch_delivery_prepare(&d, 1, 100, f, sizeof(f), false) == LITHIUM_DELIVERY_OK);
+    q.mode = PARTIAL;
+    assert(lithium_touch_delivery_submit(&d) == LITHIUM_DELIVERY_POISONED);
+    assert(q.published == 1 && d.committed.frames.active_count == 0 && d.pending);
+    assert(lithium_touch_delivery_submit(&d) == LITHIUM_DELIVERY_POISONED);
+    assert(lithium_touch_delivery_prepare(&d, 2, 200, NULL, 0, true) == LITHIUM_DELIVERY_POISONED);
+    assert(q.attempts == 1);
+    assert(lithium_touch_delivery_resync(&d) == LITHIUM_DELIVERY_POISONED);
+    assert(q.reset_calls == 1 && q.fence == 1 && d.poisoned);
+    q.reset_result = LITHIUM_SUBMIT_UNCERTAIN;
+    assert(lithium_touch_delivery_resync(&d) == LITHIUM_DELIVERY_POISONED);
+    q.reset_result = LITHIUM_SUBMIT_ACCEPT_ALL;
+    assert(lithium_touch_delivery_resync(&d) == LITHIUM_DELIVERY_OK);
+    assert(!d.poisoned && !d.pending && d.committed.frames.last_identity == 2);
+    assert(d.reserved_sequence == 1 && d.reserved_ns == 100);
+    assert(lithium_touch_delivery_prepare(&d, 1, 100, f, sizeof(f), false) == LITHIUM_DELIVERY_ORDER);
+    q.mode = NORMAL; send(&d, 2, f);
+    assert(d.committed.frames.active[0].identity == 3 && d.committed.frames.last_identity == 4);
+    assert(lithium_touch_delivery_resync(&d) == LITHIUM_DELIVERY_INVALID);
+    /* An unknown callback result also poisons, with no optional recovery hook. */
+    struct lithium_touch_delivery other = {0}; struct fake_queue oq = {0};
+    const struct lithium_touch_delivery_adapter a = {1, &oq, submit, NULL};
+    assert(lithium_touch_delivery_init(&other, &geometry, &a) == LITHIUM_DELIVERY_OK);
+    oq.mode = UNKNOWN;
+    assert(lithium_touch_delivery_prepare(&other, 1, 1, f, sizeof(f), false) == LITHIUM_DELIVERY_OK);
+    assert(lithium_touch_delivery_submit(&other) == LITHIUM_DELIVERY_POISONED);
+    assert(lithium_touch_delivery_resync(&other) == LITHIUM_DELIVERY_UNAVAILABLE);
+    assert(lithium_touch_delivery_submit(&other) == LITHIUM_DELIVERY_POISONED && oq.attempts == 1);
+}
+
+int main(void)
+{
+    down_move_up(); puts("PASS down/move/up, private state, timestamps, identity reuse prevention");
+    multi_and_retry(); puts("PASS 10 contacts/20 events, saturation, exact retry, no partial prefix");
+    loss_once(); puts("PASS explicit loss, rejected release retry, repeated loss, missing-ID release");
+    order_and_empty(); puts("PASS duplicate/decreasing sequence/time, empty/stationary, no wrap");
+    malformed(); puts("PASS malformed length/null/loss/IDs/events/coordinates, no mutation");
+    rotations(); puts("PASS immutable geometry: four rotations, midpoint, viewport");
+    reentrancy_and_unavailable(); puts("PASS callback recursion, absent atomic adapter, invalid API inputs");
+    poison_and_resync(); puts("PASS partial/unknown poison, no replay, failed/successful recovery fence");
+    puts("PASS 8 synthetic touch delivery groups; no physical queue or IOHID connected");
+    return 0;
+}
diff --git a/maintenance/hakios-lithium/peripherals-next/irq-affinity-audit.h b/maintenance/hakios-lithium/peripherals-next/irq-affinity-audit.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/maintenance/hakios-lithium/peripherals-next/irq-affinity-audit.h
@@ -0,0 +1,104 @@
+#ifndef LITHIUM_IRQ_AFFINITY_AUDIT_H
+#define LITHIUM_IRQ_AFFINITY_AUDIT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* MPIDR Aff3[39:32] plus Aff2:Aff0[23:0], excluding all non-affinity bits. */
+#define LITHIUM_AUDIT_MPIDR_AFFINITY_MASK UINT64_C(0x000000ff00ffffff)
+
+#define LITHIUM_AUDIT_IROUTER_IRM       UINT64_C(0x0000000080000000)
+#define LITHIUM_AUDIT_EXPECTED_AFFINITY UINT64_C(0x0000000000000001)
+#define LITHIUM_AUDIT_SPI_INTID_BASE   UINT32_C(32)
+#define LITHIUM_AUDIT_SPI_INTID_MAX    UINT32_C(1019)
+#define LITHIUM_AUDIT_SPI_NUMBER_MAX   (LITHIUM_AUDIT_SPI_INTID_MAX - LITHIUM_AUDIT_SPI_INTID_BASE)
+#define LITHIUM_AUDIT_TYPER_ITLINES_MASK UINT32_C(0x1f)
+
+/* Inputs are observations for validation only; this API performs no MMIO. */
+struct lithium_irq_affinity_candidate {
+    uint32_t spi_number;       /* DT GIC SPI number, before the +32 INTID bias. */
+    uint32_t intid;
+    uint32_t gicd_typer;
+    uint32_t xnu_cpu_count;    /* This fixed policy requires exactly one XNU CPU. */
+    uint64_t target_mpidr;     /* Raw MPIDR_EL1, not pre-masked. */
+    uint64_t route_value;      /* Proposed IROUTER value, not a register read. */
+    bool target_online;
+};
+
+enum lithium_irq_affinity_result {
+    LITHIUM_IRQ_AFFINITY_OK,
+    LITHIUM_IRQ_AFFINITY_BAD_ARGUMENT,
+    LITHIUM_IRQ_AFFINITY_BAD_CPU_COUNT,
+    LITHIUM_IRQ_AFFINITY_TARGET_OFFLINE,
+    LITHIUM_IRQ_AFFINITY_BAD_TARGET_AFFINITY,
+    LITHIUM_IRQ_AFFINITY_ROUTE_IRM_SET,
+    LITHIUM_IRQ_AFFINITY_ROUTE_RESERVED_BITS,
+    LITHIUM_IRQ_AFFINITY_BAD_ROUTE_AFFINITY,
+    LITHIUM_IRQ_AFFINITY_SPI_OUT_OF_RANGE,
+    LITHIUM_IRQ_AFFINITY_INTID_MISMATCH,
+    LITHIUM_IRQ_AFFINITY_INTID_OUT_OF_RANGE,
+    LITHIUM_IRQ_AFFINITY_NOT_SUPPORTED_BY_TYPER
+};
+
+/*
+ * Validate the fixed lithium single-core route contract before a future
+ * attach implementation touches hardware. The raw MPIDR is reduced with the
+ * architectural affinity-field mask; the route word must contain exactly
+ * affinity 0x1: IRM and every reserved bit
+ * must be clear. GICD_TYPER.ITLinesNumber is an upper bound, further capped
+ * at the architectural standard-SPI INTID ceiling 1019.
+ */
+static inline enum lithium_irq_affinity_result
+lithium_irq_affinity_audit(const struct lithium_irq_affinity_candidate *candidate)
+{
+    if (candidate == NULL) {
+        return LITHIUM_IRQ_AFFINITY_BAD_ARGUMENT;
+    }
+    if (candidate->xnu_cpu_count != 1) {
+        return LITHIUM_IRQ_AFFINITY_BAD_CPU_COUNT;
+    }
+    if (!candidate->target_online) {
+        return LITHIUM_IRQ_AFFINITY_TARGET_OFFLINE;
+    }
+    if ((candidate->target_mpidr & LITHIUM_AUDIT_MPIDR_AFFINITY_MASK) !=
+        LITHIUM_AUDIT_EXPECTED_AFFINITY) {
+        return LITHIUM_IRQ_AFFINITY_BAD_TARGET_AFFINITY;
+    }
+    if ((candidate->route_value & LITHIUM_AUDIT_IROUTER_IRM) != 0) {
+        return LITHIUM_IRQ_AFFINITY_ROUTE_IRM_SET;
+    }
+    if ((candidate->route_value &
+        ~(LITHIUM_AUDIT_MPIDR_AFFINITY_MASK | LITHIUM_AUDIT_IROUTER_IRM)) != 0) {
+        return LITHIUM_IRQ_AFFINITY_ROUTE_RESERVED_BITS;
+    }
+    if ((candidate->route_value & LITHIUM_AUDIT_MPIDR_AFFINITY_MASK) !=
+        LITHIUM_AUDIT_EXPECTED_AFFINITY) {
+        return LITHIUM_IRQ_AFFINITY_BAD_ROUTE_AFFINITY;
+    }
+    if (candidate->spi_number > LITHIUM_AUDIT_SPI_NUMBER_MAX) {
+        return LITHIUM_IRQ_AFFINITY_SPI_OUT_OF_RANGE;
+    }
+
+    const uint32_t expected_intid =
+        candidate->spi_number + LITHIUM_AUDIT_SPI_INTID_BASE;
+    if (candidate->intid < LITHIUM_AUDIT_SPI_INTID_BASE ||
+        candidate->intid > LITHIUM_AUDIT_SPI_INTID_MAX) {
+        return LITHIUM_IRQ_AFFINITY_INTID_OUT_OF_RANGE;
+    }
+    if (candidate->intid != expected_intid) {
+        return LITHIUM_IRQ_AFFINITY_INTID_MISMATCH;
+    }
+
+    const uint32_t itlines =
+        candidate->gicd_typer & LITHIUM_AUDIT_TYPER_ITLINES_MASK;
+    const uint32_t max_intid_by_typer = (itlines + 1u) * 32u - 1u;
+    const uint32_t max_intid = max_intid_by_typer < LITHIUM_AUDIT_SPI_INTID_MAX
+        ? max_intid_by_typer : LITHIUM_AUDIT_SPI_INTID_MAX;
+    if (candidate->intid > max_intid) {
+        return LITHIUM_IRQ_AFFINITY_NOT_SUPPORTED_BY_TYPER;
+    }
+    return LITHIUM_IRQ_AFFINITY_OK;
+}
+
+#endif
diff --git a/maintenance/hakios-lithium/peripherals-next/irq-affinity-audit-test.c b/maintenance/hakios-lithium/peripherals-next/irq-affinity-audit-test.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/maintenance/hakios-lithium/peripherals-next/irq-affinity-audit-test.c
@@ -0,0 +1,128 @@
+#include "irq-affinity-audit.h"
+
+#include <assert.h>
+#include <stdio.h>
+
+static struct lithium_irq_affinity_candidate
+valid_candidate(uint32_t spi_number)
+{
+    return (struct lithium_irq_affinity_candidate){
+        .spi_number = spi_number,
+        .intid = spi_number + LITHIUM_AUDIT_SPI_INTID_BASE,
+        .gicd_typer = LITHIUM_AUDIT_TYPER_ITLINES_MASK,
+        .xnu_cpu_count = 1,
+        .target_mpidr = UINT64_C(0x80000001),
+        .route_value = LITHIUM_AUDIT_EXPECTED_AFFINITY,
+        .target_online = true
+    };
+}
+
+static void
+test_exact_masks_and_board_routes(void)
+{
+    assert(LITHIUM_AUDIT_MPIDR_AFFINITY_MASK == UINT64_C(0x000000ff00ffffff));
+    assert((UINT64_C(0x80000001) & LITHIUM_AUDIT_MPIDR_AFFINITY_MASK) == 1);
+    assert(lithium_irq_affinity_audit(&(struct lithium_irq_affinity_candidate){
+        .spi_number = 208, .intid = 240, .gicd_typer = 31, .xnu_cpu_count = 1,
+        .target_mpidr = UINT64_C(0x80000001), .route_value = 1, .target_online = true
+    }) == LITHIUM_IRQ_AFFINITY_OK);
+    assert(lithium_irq_affinity_audit(&(struct lithium_irq_affinity_candidate){
+        .spi_number = 300, .intid = 332, .gicd_typer = 31, .xnu_cpu_count = 1,
+        .target_mpidr = UINT64_C(0x80000001), .route_value = 1, .target_online = true
+    }) == LITHIUM_IRQ_AFFINITY_OK);
+}
+
+static void
+test_every_standard_spi_mapping(void)
+{
+    unsigned accepted = 0;
+    for (uint32_t spi = 0; spi <= LITHIUM_AUDIT_SPI_NUMBER_MAX; ++spi) {
+        struct lithium_irq_affinity_candidate candidate = valid_candidate(spi);
+        assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_OK);
+        ++accepted;
+    }
+    assert(accepted == 988);
+}
+
+static void
+test_single_core_online_and_affinity_rejections(void)
+{
+    struct lithium_irq_affinity_candidate candidate = valid_candidate(208);
+    candidate.xnu_cpu_count = 2;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_BAD_CPU_COUNT);
+
+    candidate = valid_candidate(208);
+    candidate.target_online = false;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_TARGET_OFFLINE);
+
+    candidate = valid_candidate(208);
+    candidate.target_mpidr = UINT64_C(0x80000101);
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_BAD_TARGET_AFFINITY);
+
+    candidate = valid_candidate(208);
+    candidate.route_value = UINT64_C(0x100);
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_BAD_ROUTE_AFFINITY);
+}
+
+static void
+test_affinity_and_irouter_invalid_encodings(void)
+{
+    struct lithium_irq_affinity_candidate candidate = valid_candidate(208);
+    candidate.target_mpidr = UINT64_C(0x0000000100000001); /* Aff3 is not phys 1. */
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_BAD_TARGET_AFFINITY);
+
+    candidate = valid_candidate(208);
+    candidate.route_value |= LITHIUM_AUDIT_IROUTER_IRM;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_ROUTE_IRM_SET);
+
+    candidate = valid_candidate(208);
+    candidate.route_value |= UINT64_C(1) << 24;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_ROUTE_RESERVED_BITS);
+    candidate.route_value = UINT64_C(1) | (UINT64_C(1) << 63);
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_ROUTE_RESERVED_BITS);
+}
+
+static void
+test_intid_and_typer_boundaries(void)
+{
+    struct lithium_irq_affinity_candidate candidate = valid_candidate(208);
+    candidate.intid = 241;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_INTID_MISMATCH);
+    candidate.intid = 1020;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_INTID_OUT_OF_RANGE);
+    candidate.intid = 31;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_INTID_OUT_OF_RANGE);
+
+    candidate = valid_candidate(988);
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_SPI_OUT_OF_RANGE);
+    candidate = valid_candidate(UINT32_MAX);
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_SPI_OUT_OF_RANGE);
+
+    candidate = valid_candidate(191); /* INTID 223: last in TYPER ITLinesNumber=6. */
+    candidate.gicd_typer = 6;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_OK);
+    candidate = valid_candidate(192); /* INTID 224 lies beyond that TYPER bound. */
+    candidate.gicd_typer = 6;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_NOT_SUPPORTED_BY_TYPER);
+
+    candidate = valid_candidate(0); /* ITLinesNumber=0 implements no standard SPI. */
+    candidate.gicd_typer = 0;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_NOT_SUPPORTED_BY_TYPER);
+
+    candidate = valid_candidate(987); /* Architectural standard SPI ceiling: INTID 1019. */
+    candidate.gicd_typer = UINT32_C(0xa5ffffe0) | 31u;
+    assert(lithium_irq_affinity_audit(&candidate) == LITHIUM_IRQ_AFFINITY_OK);
+}
+
+int
+main(void)
+{
+    assert(lithium_irq_affinity_audit(NULL) == LITHIUM_IRQ_AFFINITY_BAD_ARGUMENT);
+    test_exact_masks_and_board_routes();
+    test_every_standard_spi_mapping();
+    test_single_core_online_and_affinity_rejections();
+    test_affinity_and_irouter_invalid_encodings();
+    test_intid_and_typer_boundaries();
+    puts("irq-affinity-audit: 988 SPI mappings, fixed affinity, reserved-bit, offline, and TYPER boundaries passed");
+    return 0;
+}
diff --git a/maintenance/hakios-lithium/peripherals-next/a5xx-fence-packet.h b/maintenance/hakios-lithium/peripherals-next/a5xx-fence-packet.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/maintenance/hakios-lithium/peripherals-next/a5xx-fence-packet.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LITHIUM_A5XX_FENCE_PACKET_H
+#define LITHIUM_A5XX_FENCE_PACKET_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/*
+ * Host-testable A5xx CP_EVENT_WRITE/CACHE_FLUSH_TS packet encoder.
+ *
+ * The caller supplies an already mapped fence GPU IOVA within the active
+ * device aperture. This codec checks the Linux msm/adreno fence-slot minimum
+ * and 32-bit store alignment; it does not establish mapping, ownership,
+ * cache visibility, ring readiness, or any hardware state.
+ *
+ * Source basis: Linux v6.12 adc218676eef25575469234709c2d87185ca223a,
+ * drivers/gpu/drm/msm/adreno/a5xx_gpu.c:219-227; adreno_gpu.h:637-664;
+ * registers/adreno/adreno_pm4.xml:14-17,302,1614-1634.
+ */
+enum { A5XX_FENCE_PACKET_WORDS = 5 };
+
+enum a5xx_fence_packet_result {
+    A5XX_FENCE_PACKET_OK = 0,
+    A5XX_FENCE_PACKET_INVALID_ARGUMENT,
+    A5XX_FENCE_PACKET_INVALID_IOVA,
+    A5XX_FENCE_PACKET_NO_SPACE
+};
+
+#define A5XX_FENCE_PACKET_MIN_IOVA UINT64_C(0x01000000)
+#define A5XX_FENCE_PACKET_TYPE7 UINT32_C(0x70000000)
+#define A5XX_FENCE_PACKET_OPCODE_CP_EVENT_WRITE UINT32_C(0x46)
+#define A5XX_FENCE_PACKET_EVENT_CACHE_FLUSH_TS UINT32_C(0x04)
+#define A5XX_FENCE_PACKET_IRQ UINT32_C(0x80000000)
+
+/* Linux PM4_PARITY: 1 for even parity, 0 for odd parity. */
+static inline uint32_t
+a5xx_fence_packet_pm4_parity(uint32_t value)
+{
+    const uint32_t folded = value ^ (value >> 4) ^ (value >> 8) ^
+        (value >> 12) ^ (value >> 16) ^ (value >> 20) ^
+        (value >> 24) ^ (value >> 28);
+
+    return (UINT32_C(0x9669) >> (folded & UINT32_C(0x0f))) & UINT32_C(1);
+}
+
+/*
+ * Emit atomically: on any error, out_words is unchanged. capacity is in
+ * uint32_t words and must cover the type-7 header plus four payload words.
+ * seq is the raw 32-bit fence value; zero is representable and is not
+ * reserved by the pinned Linux fence sequence path.
+ *
+ * The CP_EVENT_WRITE packet has two complete 32-bit address payload words,
+ * so encoding itself accepts the full uint64_t wire address. The actual
+ * IOMMU aperture is dynamic and must be enforced by the mapping owner.
+ */
+static inline enum a5xx_fence_packet_result
+a5xx_fence_packet_encode(uint64_t fence_gpu_iova, uint32_t seq,
+    uint32_t *out_words, size_t capacity)
+{
+    if (out_words == NULL)
+        return A5XX_FENCE_PACKET_INVALID_ARGUMENT;
+    if (fence_gpu_iova < A5XX_FENCE_PACKET_MIN_IOVA ||
+        (fence_gpu_iova & UINT64_C(3)) != 0)
+        return A5XX_FENCE_PACKET_INVALID_IOVA;
+    if (capacity < A5XX_FENCE_PACKET_WORDS)
+        return A5XX_FENCE_PACKET_NO_SPACE;
+
+    const uint32_t count = UINT32_C(4);
+    const uint32_t opcode = A5XX_FENCE_PACKET_OPCODE_CP_EVENT_WRITE;
+    const uint32_t staged[A5XX_FENCE_PACKET_WORDS] = {
+        A5XX_FENCE_PACKET_TYPE7 | count |
+            (a5xx_fence_packet_pm4_parity(count) << 15) |
+            (opcode << 16) |
+            (a5xx_fence_packet_pm4_parity(opcode) << 23),
+        A5XX_FENCE_PACKET_EVENT_CACHE_FLUSH_TS | A5XX_FENCE_PACKET_IRQ,
+        (uint32_t)fence_gpu_iova,
+        (uint32_t)(fence_gpu_iova >> 32),
+        seq
+    };
+
+    memcpy(out_words, staged, sizeof(staged));
+    return A5XX_FENCE_PACKET_OK;
+}
+
+#endif
diff --git a/maintenance/hakios-lithium/peripherals-next/a5xx-fence-packet-test.c b/maintenance/hakios-lithium/peripherals-next/a5xx-fence-packet-test.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/maintenance/hakios-lithium/peripherals-next/a5xx-fence-packet-test.c
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "a5xx-fence-packet.h"
+
+#include <stdio.h>
+
+#define SENTINEL UINT32_C(0xfeedface)
+#define CHECK(condition) do { \
+    if (!(condition)) { \
+        fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #condition); \
+        return 1; \
+    } \
+} while (0)
+
+/* Independent reference: count set bits directly rather than using the
+ * nibble-fold/table expression used by the production encoder. */
+static uint32_t
+golden_even_parity(uint32_t value)
+{
+    unsigned ones = 0;
+    while (value != 0) {
+        ones += value & UINT32_C(1);
+        value >>= 1;
+    }
+    return (ones & 1u) ? UINT32_C(0) : UINT32_C(1);
+}
+
+static uint32_t
+golden_type7_header(uint32_t opcode, uint32_t payload_words)
+{
+    return UINT32_C(0x70000000) | payload_words |
+        (golden_even_parity(payload_words) << 15) |
+        (opcode << 16) | (golden_even_parity(opcode) << 23);
+}
+
+static int
+expect_packet(uint64_t iova, uint32_t seq, size_t capacity)
+{
+    uint32_t actual[A5XX_FENCE_PACKET_WORDS + 2] = {
+        SENTINEL, SENTINEL, SENTINEL, SENTINEL, SENTINEL, SENTINEL, SENTINEL
+    };
+    const uint32_t golden[A5XX_FENCE_PACKET_WORDS] = {
+        golden_type7_header(UINT32_C(0x46), UINT32_C(4)),
+        UINT32_C(0x80000004),
+        (uint32_t)iova,
+        (uint32_t)(iova >> 32),
+        seq
+    };
+
+    CHECK(golden[0] == UINT32_C(0x70460004));
+    CHECK(a5xx_fence_packet_encode(iova, seq, actual, capacity) ==
+        A5XX_FENCE_PACKET_OK);
+    for (size_t i = 0; i < A5XX_FENCE_PACKET_WORDS; ++i)
+        CHECK(actual[i] == golden[i]);
+    for (size_t i = A5XX_FENCE_PACKET_WORDS; i <
+        A5XX_FENCE_PACKET_WORDS + 2; ++i)
+        CHECK(actual[i] == SENTINEL);
+    return 0;
+}
+
+static int
+test_golden_and_sequence_boundaries(void)
+{
+    CHECK(expect_packet(UINT64_C(0x123456789abcdef0), UINT32_C(0),
+        A5XX_FENCE_PACKET_WORDS) == 0);
+    CHECK(expect_packet(A5XX_FENCE_PACKET_MIN_IOVA, UINT32_MAX,
+        A5XX_FENCE_PACKET_WORDS + 2) == 0);
+    /* The packet carries two address dwords; aperture validation belongs to
+     * the caller that owns the IOMMU mapping, not this wire encoder. */
+    CHECK(expect_packet(UINT64_C(0xfffffffffffffffc), UINT32_C(0x80000000),
+        A5XX_FENCE_PACKET_WORDS) == 0);
+    return 0;
+}
+
+static int
+test_iova_alignment_and_linux_minimum(void)
+{
+    uint32_t words[A5XX_FENCE_PACKET_WORDS + 1];
+    for (size_t i = 0; i < A5XX_FENCE_PACKET_WORDS + 1; ++i)
+        words[i] = SENTINEL;
+
+    CHECK(a5xx_fence_packet_encode(A5XX_FENCE_PACKET_MIN_IOVA - 4, 1,
+        words, A5XX_FENCE_PACKET_WORDS) == A5XX_FENCE_PACKET_INVALID_IOVA);
+    CHECK(a5xx_fence_packet_encode(A5XX_FENCE_PACKET_MIN_IOVA + 1, 1,
+        words, A5XX_FENCE_PACKET_WORDS) == A5XX_FENCE_PACKET_INVALID_IOVA);
+    CHECK(a5xx_fence_packet_encode(A5XX_FENCE_PACKET_MIN_IOVA + 2, 1,
+        words, A5XX_FENCE_PACKET_WORDS) == A5XX_FENCE_PACKET_INVALID_IOVA);
+    CHECK(a5xx_fence_packet_encode(A5XX_FENCE_PACKET_MIN_IOVA + 3, 1,
+        words, A5XX_FENCE_PACKET_WORDS) == A5XX_FENCE_PACKET_INVALID_IOVA);
+    for (size_t i = 0; i < A5XX_FENCE_PACKET_WORDS + 1; ++i)
+        CHECK(words[i] == SENTINEL);
+    return 0;
+}
+
+static int
+test_capacity_and_failure_transaction(void)
+{
+    uint32_t words[A5XX_FENCE_PACKET_WORDS + 1];
+    for (size_t i = 0; i < A5XX_FENCE_PACKET_WORDS + 1; ++i)
+        words[i] = SENTINEL;
+
+    CHECK(a5xx_fence_packet_encode(A5XX_FENCE_PACKET_MIN_IOVA, 0, NULL,
+        A5XX_FENCE_PACKET_WORDS) == A5XX_FENCE_PACKET_INVALID_ARGUMENT);
+    for (size_t capacity = 0; capacity < A5XX_FENCE_PACKET_WORDS; ++capacity) {
+        CHECK(a5xx_fence_packet_encode(A5XX_FENCE_PACKET_MIN_IOVA, 0, words,
+            capacity) == A5XX_FENCE_PACKET_NO_SPACE);
+        for (size_t i = 0; i < A5XX_FENCE_PACKET_WORDS + 1; ++i)
+            CHECK(words[i] == SENTINEL);
+    }
+    CHECK(a5xx_fence_packet_encode(A5XX_FENCE_PACKET_MIN_IOVA - 4, 7, words,
+        A5XX_FENCE_PACKET_WORDS) == A5XX_FENCE_PACKET_INVALID_IOVA);
+    for (size_t i = 0; i < A5XX_FENCE_PACKET_WORDS + 1; ++i)
+        CHECK(words[i] == SENTINEL);
+    return 0;
+}
+
+int
+main(void)
+{
+    CHECK(test_golden_and_sequence_boundaries() == 0);
+    CHECK(test_iova_alignment_and_linux_minimum() == 0);
+    CHECK(test_capacity_and_failure_transaction() == 0);
+    puts("PASS: A5xx CP_EVENT_WRITE fence packet golden/boundary/transaction tests");
+    return 0;
+}
