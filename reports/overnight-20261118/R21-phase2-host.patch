+#!/usr/bin/env python3
+"""Test isolated touch follow-ups without changing frozen R19 evidence or hardware."""
+
+import argparse
+from contextlib import nullcontext
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / 'maintenance/hakios-lithium/peripherals-next'
+CONTRACT = ROOT / 'artifacts/hakios/lithium-ios16/phase4-r19/contract.json'
+CONTRACT_SHA = 'ab5fcf8c87d5a604da1a881e6e44628ec700eb1ff655fcbf3cb2ebe257162904'
+SUITES = ('qup-combined', 'touch-delivery', 'irq-affinity-audit', 'a5xx-fence-packet')
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def frozen_check():
+    if digest(CONTRACT) != CONTRACT_SHA:
+        raise RuntimeError('Frozen R19 contract changed; do not refresh it for these tests')
+    contract = json.loads(CONTRACT.read_text(encoding='utf-8'))
+    for name, expected in contract['evidence_sha256'].items():
+        if digest(ROOT / name) != expected:
+            raise RuntimeError('Frozen R19 live evidence changed: ' + name)
+    size = 0
+    for name, entry in contract['evidence_snapshots'].items():
+        live, saved = (ROOT / name).read_bytes(), (ROOT / entry['path']).read_bytes()
+        if live != saved or hashlib.sha256(saved).hexdigest() != entry['sha256']:
+            raise RuntimeError('Frozen R19 snapshot differs: ' + name)
+        size += len(saved)
+    for name, expected in contract['inputs']['port_files'].items():
+        if digest(ROOT / 'ports/hakios-lithium' / name) != expected:
+            raise RuntimeError('Frozen R19 port source changed: ' + name)
+    if digest(ROOT / contract['image_path']) != contract['image_sha256']:
+        raise RuntimeError('Frozen R19 image changed')
+    baseline = ROOT / 'artifacts/hakios/lithium-ios16/baseline-desktop-r15.img'
+    if digest(baseline) != 'ed4994d39144494a0413b2259b9cca10ae98d3872c1ea4876aba8d0b2ceffd55':
+        raise RuntimeError('Desktop R15 baseline changed')
+    return {'live_evidence': len(contract['evidence_sha256']),
+            'snapshots': len(contract['evidence_snapshots']),
+            'snapshot_bytes': size, 'port_files': len(contract['inputs']['port_files']),
+            'r15_and_r19_images_unchanged': True}
+
+
+def sources(selected):
+    files = [SOURCE / (suite + suffix) for suite in selected
+             for suffix in ('.h', '-test.c')]
+    previous = ROOT / 'reports/overnight-20261118/accepted-host-tests/passed.json'
+    names = json.loads(previous.read_text(encoding='utf-8'))['source_sha256']
+    files += [ROOT / name for name in names]
+    files += [Path(__file__).resolve()]
+    return {p.relative_to(ROOT).as_posix(): digest(p) for p in files}
+
+
+def run(argv, timeout, env):
+    started = time.monotonic()
+    result = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=env)
+    print(result.stdout, end='', flush=True)
+    if result.stderr:
+        print(result.stderr, end='', file=sys.stderr, flush=True)
+    return {'argv': argv, 'exit_code': result.returncode, 'stdout': result.stdout,
+            'stderr': result.stderr, 'elapsed_seconds': time.monotonic() - started}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--compiler', default='clang')
+    parser.add_argument('--suite', choices=SUITES, action='append')
+    parser.add_argument('--skip-existing', action='store_true',
+                        help='Run only the selected new suites; not a full regression')
+    parser.add_argument('--build-dir', type=Path, help='New directory for retained local evidence')
+    args = parser.parse_args()
+    selected = args.suite or list(SUITES)
+    before = frozen_check()
+    for suite in selected:
+        if not (SOURCE / (suite + '-test.c')).is_file():
+            parser.error('Missing test source: ' + suite)
+    original = sources(selected)
+    if args.build_dir:
+        output = args.build_dir.resolve()
+        output.mkdir(parents=True, exist_ok=False)
+        destination = nullcontext(output)
+    else:
+        destination = tempfile.TemporaryDirectory(prefix='lithium-touch-next-')
+    env = {**os.environ, 'ASAN_OPTIONS': 'halt_on_error=1',
+           'UBSAN_OPTIONS': 'halt_on_error=1:print_stacktrace=1',
+           'PYTHONDONTWRITEBYTECODE': '1'}
+    with destination as directory:
+        output = Path(directory)
+        checks = []
+        if not args.skip_existing:
+            print('RUN existing 14 peripheral suites', flush=True)
+            checks.append(run([sys.executable, '-B', str(ROOT / 'scripts/test-hakios-lithium-peripherals.py'),
+                               '--compiler', args.compiler, '--build-dir', str(output / 'previous')],
+                              300, env))
+        for suite in selected:
+            binary = output / (suite + '-test')
+            print('BUILD ' + suite, flush=True)
+            build = run([args.compiler, '-std=c11', '-pedantic', '-Wall', '-Wextra', '-Werror',
+                         '-g', '-O1', '-fno-omit-frame-pointer', '-fsanitize=address,undefined',
+                         str(SOURCE / (suite + '-test.c')), '-o', str(binary)], 60, env)
+            checks.append(build)
+            if build['exit_code'] == 0:
+                test = run([str(binary)], 30, env)
+                test.update(suite=suite, binary_sha256=digest(binary))
+                checks.append(test)
+        after = frozen_check()
+        if original != sources(selected):
+            raise RuntimeError('Sources changed during tests; no pass evidence published')
+        passed = all(c['exit_code'] == 0 for c in checks) and before == after
+        evidence = {'scope': 'isolated host-only QUP, touch delivery, IRQ affinity policy, and A5xx packet models; no hardware',
+                    'passed': passed, 'full_existing_regression': not args.skip_existing,
+                    'new_suites': selected, 'checks': checks, 'source_sha256': original,
+                    'frozen_before': before, 'frozen_after': after,
+                    'production_kernel_integration': False, 'device_operations': False,
+                    'physical_touch_verified': False, 'gpu_hardware_verified': False}
+        if args.build_dir:
+            (output / ('passed.json' if passed else 'failed.json')).write_text(
+                json.dumps(evidence, indent=2) + chr(10), encoding='utf-8')
+        print(('PASS' if passed else 'FAIL') + ': isolated next-phase host tests; R19 frozen inputs preserved')
+        if not passed:
+            raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
