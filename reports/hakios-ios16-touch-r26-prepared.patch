+    image_directory = work / "userland" if image_directory is None else Path(image_directory)
+    volumes, results = {}, {}
+    for name, payload_name, program, path in (
+        ("root.apfs", "ramdisk", "init", "/sbin/init"),
+        ("flashboot.apfs", "resident", "stage0", "/sbin/launchd"),
