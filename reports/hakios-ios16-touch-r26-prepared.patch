+	static const char *const storage[] = {
+		"root_apfs=ufs_userdata", "root_apfs=", "root_apfs", "root_apfs=0",
+		"var_hfs=ufs_darwin_data", "var_hfs=", "var_hfs", "var_store=0", "var_custom=1",
