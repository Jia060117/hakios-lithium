+	}
+	static const char *const ufs_bad[] = {
+		"", "ufs", "ufs=", "ufs=1", "ufs=2", "ufs=00", "ufs=-0", "ufs=0x0",
+		"ufs=0 ufs=0", "ufs=0 ufs=2", "ufs=2 ufs=0", "ufs=0x",
+	};
+	for (unsigned i = 0; i < sizeof(ufs_bad) / sizeof(ufs_bad[0]); i++) {
+		char args[512];
