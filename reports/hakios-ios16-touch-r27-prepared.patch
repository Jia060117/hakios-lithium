+ID_PROBE_MARKER = b"LITHIUM TOUCH id begin"
+ID_CORE_MARKER = b"raw_id_clean_stop_identity_owner_unverified"
+R25_INIT_SHA = "36ecab89d975c902b9250a1cfc56c6a673b50372798fb3dbaa0e7af220c8cff9"
+R25_STAGE0_SHA = "7590c8831bd1fbfac6e810b1f3089519ee65eb6e021bebe72776ffa35e244d18"
+LOADER_DISK_MARKER = b"it is the root (md0), the payload ramdisk is md1"
+PROVIDER_NAME = "lithiumufsdxe"
+PROVIDER_GUID = "f24b2ac8-cc8e-4611-8d36-df569312d1c7"
+
+
+def require(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha(path):
+    result = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            result.update(block)
+    return result.hexdigest()
+
+
+def read(path):
+    return json.loads(Path(path).read_text(encoding="utf-8"))
+
+
+def module(name, filename):
+    path = ROOT / "scripts" / filename
+    require(path.is_file(), "Required integration module is not ready: " + str(path))
+    spec = importlib.util.spec_from_file_location(name, path)
+    result = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(result)
+    return result
+
+
+def inside(path, parent):
+    """Resolve before checking so an evidence symlink cannot escape its scope."""
+    path, parent = Path(path).resolve(), Path(parent).resolve()
+    require(path.is_relative_to(parent), "Path escapes expected scope: " + str(path))
+    return path
+
+
+def source_map_check(values):
+    require(isinstance(values, dict) and values, "Missing host source hashes")
+    for name, expected in values.items():
+        require(not Path(name).is_absolute(), "Host source must be repository relative")
+        path = inside(ROOT / name, ROOT)
+        require(sha(path) == expected, "Host-test source changed: " + name)
+
+
+def r26_evidence_hash(contract, name):
+    """R26 recorded WSL paths; compare the repository-relative suffix exactly."""
+    values = [value for key, value in contract["evidence_sha256"].items()
+              if key.replace("\\", "/").endswith("/" + name)]
+    require(len(values) == 1, "Missing/ambiguous immutable R26 evidence: " + name)
+    return values[0]
+
+
+def protected_snapshot():
+    pins = {
+        R26_DIR / "contract.json": R26_CONTRACT_SHA,
+        R26_DIR / R26_IMAGE_NAME: R26_IMAGE_SHA,
+        R25_DIR / "contract.json": R25_CONTRACT_SHA,
+        R25_DIR / R25_IMAGE_NAME: R25_IMAGE_SHA,
+        BASE / "phase4-r20-display/contract.json": R20_CONTRACT_SHA,
+        BASE / "phase4-r20-display/lithium-hakios-ios16-r20-display.img": R20_IMAGE_SHA,
+        BASE / "baseline-desktop-r15.img": R15_IMAGE_SHA,
+    }
+    for path, expected in pins.items():
+        require(sha(path) == expected, "Immutable baseline changed: " + str(path))
+    files = set(pins)
+    old_evidence = read(R25_DIR / "contract.json")["evidence_sha256"]
+    for name in ("scripts/package-hakios-ios16-touch-stage1.py", "scripts/hakios_touch_stage1.py"):
+        require(sha(ROOT / name) == old_evidence[name], "Immutable R25 script changed: " + name)
+        files.add(ROOT / name)
+    r26 = read(R26_DIR / "contract.json")
+    for name in ("scripts/package-hakios-ios16-touch-r26.py", "scripts/hakios_touch_r26.py",
+                 R26_HOST_PATH.relative_to(ROOT).as_posix(),
+                 (R26_HOST_PATH.parent / "previous/passed.json").relative_to(ROOT).as_posix()):
+        path = ROOT / name
+        require(sha(path) == r26_evidence_hash(r26, name), "Immutable R26 evidence changed: " + name)
+        files.add(path)
+    for directory in (R26_DIR, R25_DIR, BASE / "phase4-r20-display"):
+        files.update(p for p in directory.rglob("*") if p.is_file())
+    return {p.relative_to(ROOT).as_posix(): sha(p) for p in sorted(files)}
+
+
+def command_line(base, version):
+    require(base == R26_ARGS, "R26 command line differs from the frozen contract")
+    require(R27_ARGS == base + " touch_id_probe=1",
+            "R27 must append only touch_id_probe=1 to the exact R26 arguments")
+    require(version and version.isascii() and
+            all(c.isalnum() or c in ".-+_" for c in version),
+            "Invalid actual kernel version")
+    words = R27_ARGS.split()
+    names = [word.partition("=")[0] for word in words]
+    require(len(names) == len(set(names)), "Duplicate R27 boot argument")
+    require(all(words.count(word) == 1 for word in (
+        "bootcpu=1", "cpus=1", "ufs=0", "lithiumusb=2", "gl=0", "metal=0",
+        "fbwidth=1080", "fbheight=2040", "loader_return_after=180",
+        "touch_stage=1", "touch_clock_init=1", "touch_diag=1", "touch_id_probe=1")),
+        "R27 CPU/display/diagnostic contract differs")
+    # No disk selectors are added. The loader contributes rd=md0 itself.
+    require(not any(name.startswith(("root", "var_", "ufs_")) or name in (
+        "rd", "apfs_volume", "hfs_bench", "fsdiag", "hfsdiag", "lsdbfinal")
+        for name in names), "Storage-backed boot option in R27")
+    prefix = ("debug=0x8 rd=md0 ufs_shared_pa=0x" + "0" * 16 +
+              " hakios_kver=" + version + " ")
+    size = len((prefix + "hv_wdt_pet=1 " + R27_ARGS).encode("ascii")) + 1
+    require(size <= 608, "Complete loader command exceeds its 608-byte buffer")
+    return R27_ARGS, dict(capacity_including_nul=608,
+                         conservative_reserved_bytes=size,
+                         spare_bytes=608 - size, conservative_prefix=prefix)
+
+
+def verify_r26_ancestry(codec, production, helper, work, current):
+    """Bind the new reviewed port delta to the actual immutable R26 image."""
+    require(sha(R26_DIR / "contract.json") == R26_CONTRACT_SHA and
+            sha(R26_DIR / R26_IMAGE_NAME) == R26_IMAGE_SHA,
+            "Actual R26 contract/image differs from pinned ancestry")
+    prior = read(R26_DIR / "contract.json")
+    require(prior.get("passed") is True and prior.get("revision") == "R26-touch-clock" and
+            prior["image_sha256"] == R26_IMAGE_SHA and prior["cmdline"] == R26_ARGS,
+            "Unexpected frozen R26 contract")
+    blob = (R26_DIR / R26_IMAGE_NAME).read_bytes()
+    raw, dtbs, fat, header = codec.decode_android(blob)
+    production.check_boot(blob, raw, dtbs, fat, header)
+    payload = (R26_DIR / "payload.bin").read_bytes()
+    entries = codec.parse_payload(payload)
+    require(raw == (R26_DIR / "Image").read_bytes() and
+            raw[XNUP_START:XNUP_START + len(payload)] == payload and
+            raw[XNUP_START + len(payload):] == NOP * ((-len(payload)) % 16 // 4),
+            "Actual R26 Image/XNUP extent differs")
+    require(digest(raw[0x1000:XNUP_START]) == prior["ram_mu_sha256"] == MU_SHA and
+            digest(fat) == prior["readonly_fat_sha256"] == FAT_SHA,
+            "Actual R26 RAM-only Mu/readonly FAT provenance differs")
+    require(set(entries) == {"kernel", "ramdisk", "resident", "cmdline", "kernel.ver"} and
+            entries["cmdline"] == R26_ARGS.encode("ascii") + b"\0" and
+            digest(entries["kernel"]) == prior["kernel_sha256"],
+            "Actual R26 kernel/command-line ancestry differs")
+    for name, data in entries.items():
+        require(prior["payload_entries"][name] == dict(bytes=len(data), sha256=digest(data)),
+                "Actual R26 payload differs: " + name)
+    before = prior["inputs"]
+    require({k: v for k, v in before.items() if k != "port_files"} ==
+            {k: v for k, v in current.items() if k != "port_files"},
+            "R27 changed non-port R26 inputs")
+    old, now = before["port_files"], current["port_files"]
+    changed = {name for name in set(old) | set(now) if old.get(name) != now.get(name)}
+    reviewed = helper.REVIEWED_DELTA
+    require(isinstance(reviewed, dict) and reviewed and changed == set(reviewed),
+            "R27 helper must pin the exact post-R26 source delta")
+    for name, expected in reviewed.items():
+        require(now.get(name) == expected and
+                sha(inside(ROOT / "ports/hakios-lithium" / name,
+                           ROOT / "ports/hakios-lithium")) == expected and
+                sha(inside(work / "devices/lithium" / name,
+                           work / "devices/lithium")) == expected,
+                "R27 reviewed production source differs: " + name)
+    for name in ("patches/0022-lithium-touch-diagnostic-init.patch", "peripherals/touch-stage1.inc"):
+        require(now.get(name) == old[name] and
+                sha(ROOT / "ports/hakios-lithium" / name) == old[name] and
+                sha(work / "devices/lithium" / name) == old[name],
+                "Keep R26 Stage1 whitelist and diagnostic init byte-identical: " + name)
+    new_code = sorted(name for name in changed - set(old)
+                      if name.startswith("peripherals/") and Path(name).suffix in (".h", ".inc"))
+    require(set(new_code) == {"peripherals/touch-id-core.h", "peripherals/touch-id.inc"},
+            "R27 new production code must be exactly the ID core and mapped-page adapter")
+    return prior, dict(passed=True, image_sha256=digest(blob), contract_sha256=R26_CONTRACT_SHA,
+                       actual_image_decoded=True, actual_payload_hashes_verified=True,
+                       exact_post_r26_source_delta=sorted(changed), new_code=new_code,
+                       stage1_unchanged=True, diagnostic_init_unchanged=True)
+
