+static uint64_t tid_for_hash(unsigned hash, unsigned ordinal)
+{
+    for (uint64_t tid = 1; tid < UINT64_C(10000000); ++tid) {
+        if ((tid ^ (tid >> 7)) % LR37_SLOTS == hash) {
+            if (!ordinal--) return tid;
+        }
+    }
+    CHECK(false);
+    return 0;
+}
