+static void *concurrent_writer(void *argument)
+{
+    unsigned cpu = (unsigned)(uintptr_t)argument;
+    for (unsigned i = 0; i < ITERATIONS; ++i) {
+        lithium_sched_r37_switch(&a, cpu, 1000 + i * 10, 1003 + i * 10);
