+/* Bounded, default-off R37 observations. Scheduler hot path never prints. */
+#ifndef LITHIUM_CPU_SCHED_R37_H
+#define LITHIUM_CPU_SCHED_R37_H
+#define LR37_CPUS 4u
+#define LR37_SLOTS 128u
+struct lr37_row {
+    uint64_t tid, task_id;
+    uint64_t ticks[LR37_CPUS], switches[LR37_CPUS], expiries[LR37_CPUS];
+    uint64_t last_tick, backwards;
+};
+void lithium_sched_r37_enable(void);
+void lithium_sched_r37_select(unsigned group, uint64_t task_id);
+unsigned lithium_sched_r37_snapshot(struct lr37_row *rows, unsigned capacity,
+    uint64_t *dropped);
+void lithium_sched_r37_init(void);
+void lithium_slowcores_r37_report(void);
+#endif
diff --git a/ports/hakios-lithium/diagnostics/cpu-sched-r37.inc b/ports/hakios-lithium/diagnostics/cpu-sched-r37.inc
new file mode 100644
index 0000000..14bdebd
--- /dev/null
+++ b/ports/hakios-lithium/diagnostics/cpu-sched-r37.inc
@@ -0,0 +1,97 @@
+/* Included by sched_prim.c, with private thread/task/processor definitions.
+ * Fixed-size atomics only; no names, process lookup, logging or allocations in
+ * context-switch or timer-interrupt paths. Online CPUs are never powered off. */
+#include "cpu-sched-r37.h"
+static struct lr37_row lr37_rows[LR37_SLOTS];
+static uint64_t lr37_task_ids[2], lr37_started, lr37_dropped;
+static bool lr37_enabled;
+
+void
+lithium_sched_r37_enable(void)
+{
+    lr37_started = mach_absolute_time();
+    __atomic_store_n(&lr37_enabled, true, __ATOMIC_RELEASE);
+}
+
+void
+lithium_sched_r37_select(unsigned group, uint64_t task_id)
+{
+    if (group < 2) __atomic_store_n(&lr37_task_ids[group], task_id, __ATOMIC_RELEASE);
+}
+
+static struct lr37_row *
+lr37_get(thread_t thread)
+{
+    if (!__atomic_load_n(&lr37_enabled, __ATOMIC_ACQUIRE)) return NULL;
+    const uint64_t task_id = get_threadtask(thread)->task_uniqueid;
+    if (!task_id || (task_id != __atomic_load_n(&lr37_task_ids[0], __ATOMIC_ACQUIRE) &&
+        task_id != __atomic_load_n(&lr37_task_ids[1], __ATOMIC_ACQUIRE))) return NULL;
+    const uint64_t tid = thread_tid(thread);
+    if (!tid) return NULL;
+    const unsigned hash = (unsigned)((tid ^ (tid >> 7)) % LR37_SLOTS);
+    for (unsigned i = 0; i < 8; ++i) {
+        struct lr37_row *row = &lr37_rows[(hash + i) % LR37_SLOTS];
+        uint64_t key = __atomic_load_n(&row->tid, __ATOMIC_ACQUIRE);
+        if (!key) {
+            uint64_t expected = 0;
+            if (__atomic_compare_exchange_n(&row->tid, &expected, tid, false,
+                __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) key = tid;
+            else key = expected;
+        }
+        if (key == tid) {
+            /* TIDs are system-unique. Publish task identity independently;
+             * snapshots may initially observe zero, and explicitly skip it. */
+            __atomic_store_n(&row->task_id, task_id, __ATOMIC_RELEASE);
+            return row;
+        }
+    }
+    __atomic_fetch_add(&lr37_dropped, 1, __ATOMIC_RELAXED);
+    return NULL;
+}
+
+static void
+lithium_sched_r37_switch(thread_t old, unsigned cpu, uint64_t start, uint64_t end)
+{
+    if (cpu >= LR37_CPUS) return;
+    struct lr37_row *row = lr37_get(old);
+    if (!row) return;
+    if (start < lr37_started) start = lr37_started;
+    if (end < start) {
+        __atomic_fetch_add(&row->backwards, 1, __ATOMIC_RELAXED);
+        return;
+    }
+    __atomic_fetch_add(&row->ticks[cpu], end - start, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&row->switches[cpu], 1, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->last_tick, end, __ATOMIC_RELAXED);
+}
+
+static void
+lithium_sched_r37_expiry(thread_t target, unsigned callback_cpu)
+{
+    if (callback_cpu >= LR37_CPUS) return;
+    struct lr37_row *row = lr37_get(target);
+    if (row) __atomic_fetch_add(&row->expiries[callback_cpu], 1, __ATOMIC_RELAXED);
+}
+
+unsigned
+lithium_sched_r37_snapshot(struct lr37_row *rows, unsigned capacity, uint64_t *dropped)
+{
+    unsigned count = 0;
+    for (unsigned i = 0; i < LR37_SLOTS && count < capacity; ++i) {
+        const struct lr37_row *src = &lr37_rows[i];
+        uint64_t tid = __atomic_load_n(&src->tid, __ATOMIC_ACQUIRE);
+        uint64_t task_id = __atomic_load_n(&src->task_id, __ATOMIC_ACQUIRE);
+        if (!tid || !task_id) continue;
+        struct lr37_row *dst = &rows[count++];
+        *dst = (struct lr37_row){.tid = tid, .task_id = task_id};
+        for (unsigned cpu = 0; cpu < LR37_CPUS; ++cpu) {
+            dst->ticks[cpu] = __atomic_load_n(&src->ticks[cpu], __ATOMIC_RELAXED);
+            dst->switches[cpu] = __atomic_load_n(&src->switches[cpu], __ATOMIC_RELAXED);
+            dst->expiries[cpu] = __atomic_load_n(&src->expiries[cpu], __ATOMIC_RELAXED);
+        }
+        dst->last_tick = __atomic_load_n(&src->last_tick, __ATOMIC_RELAXED);
+        dst->backwards = __atomic_load_n(&src->backwards, __ATOMIC_RELAXED);
+    }
+    *dropped = __atomic_load_n(&lr37_dropped, __ATOMIC_RELAXED);
+    return count;
+}
diff --git a/ports/hakios-lithium/diagnostics/cpu-sched-report-r37.inc b/ports/hakios-lithium/diagnostics/cpu-sched-report-r37.inc
new file mode 100644
index 0000000..4062936
--- /dev/null
+++ b/ports/hakios-lithium/diagnostics/cpu-sched-report-r37.inc
@@ -0,0 +1,142 @@
+/* Ordinary thread_call only. Names/main tags are discovery metadata, never
+ * read from an unlocked proc in a scheduler/interrupt callback. */
+#include "cpu-sched-r37.h"
+static thread_call_t lr37_report_call;
+static struct lr37_row *lr37_snap, *lr37_previous;
+static unsigned lr37_report_sequence;
+static struct {
+    uint64_t tid, task_id;
+    bool main;
+    unsigned group;
+    char name[64];
+} lr37_names[LR37_SLOTS];
+static unsigned lr37_name_count;
+
+static void
+lr37_discover(void)
+{
+    task_t found[2] = {TASK_NULL, TASK_NULL}, task;
+    lck_mtx_lock(&tasks_threads_lock);
+    queue_iterate(&tasks, task, task_t, tasks) {
+        struct proc *proc = get_bsdtask_info(task);
+        if (!proc) continue;
+        const char *name = proc_best_name(proc);
+        int group = !strcmp(name, "SpringBoard") ? 0 :
+            !strcmp(name, "backboardd") ? 1 : -1;
+        if (group >= 0 && !found[group]) {
+            task_reference(task);
+            found[group] = task;
+        }
+    }
+    lck_mtx_unlock(&tasks_threads_lock);
+    for (unsigned group = 0; group < 2; ++group) {
+        task = found[group];
+        if (!task) continue;
+        /* Match lr37_get(), not the unrelated BSD process unique ID. */
+        const uint64_t unique = task->task_uniqueid;
+        lithium_sched_r37_select(group, unique);
+        task_lock(task);
+        thread_t thread;
+        queue_iterate(&task->threads, thread, thread_t, task_threads) {
+            const uint64_t tid = thread_tid(thread);
+            unsigned slot;
+            for (slot = 0; slot < lr37_name_count; ++slot)
+                if (lr37_names[slot].tid == tid) break;
+            if (slot == LR37_SLOTS) continue;
+            if (slot == lr37_name_count) ++lr37_name_count;
+            lr37_names[slot].tid = tid;
+            lr37_names[slot].task_id = unique;
+            lr37_names[slot].group = group;
+            lr37_names[slot].main = !!(thread_get_tag(thread) & THREAD_TAG_MAINTHREAD);
+            lr37_names[slot].name[0] = 0;
+            if (get_bsdthread_info(thread))
+                bsd_getthreadname(get_bsdthread_info(thread), lr37_names[slot].name);
+            lr37_names[slot].name[63] = 0;
+        }
+        task_unlock(task);
+        task_deallocate(task);
+    }
+}
+
+static uint64_t
+lr37_us(uint64_t ticks)
+{
+    uint64_t ns;
+    absolutetime_to_nanoseconds(ticks, &ns);
+    return ns / 1000;
+}
+
+static void
+lr37_report(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+    lr37_discover();
+    lithium_slowcores_r37_report();
+    uint64_t dropped = 0, at = mach_absolute_time();
+    unsigned count = lithium_sched_r37_snapshot(lr37_snap, LR37_SLOTS, &dropped);
+    printf("LITHIUM SCHED window=%u at_abs=%llu uptime_us=%llu rows=%u dropped=%llu scope=completed_switch_residency timer_role=callback_not_execution\n",
+        lr37_report_sequence, at, lr37_us(at), count, dropped);
+    unsigned emitted = 0, incidental = 0, omitted = 0;
+    for (unsigned i = 0; i < count; ++i) {
+        struct lr37_row *row = &lr37_snap[i], *previous = NULL;
+        for (unsigned j = 0; j < LR37_SLOTS; ++j)
+            if (lr37_previous[j].tid == row->tid) { previous = &lr37_previous[j]; break; }
+        const char *name = "";
+        const char *process = "unknown";
+        bool main = false;
+        for (unsigned j = 0; j < lr37_name_count; ++j)
+            if (lr37_names[j].tid == row->tid) {
+                name = lr37_names[j].name;
+                process = lr37_names[j].group == 0 ? "SpringBoard" : "backboardd";
+                main = lr37_names[j].main;
+                break;
+            }
+        for (unsigned cpu = 0; cpu < LR37_CPUS; ++cpu) {
+            uint64_t ticks = row->ticks[cpu] - (previous ? previous->ticks[cpu] : 0);
+            uint64_t sw = row->switches[cpu] - (previous ? previous->switches[cpu] : 0);
+            uint64_t expiry = row->expiries[cpu] - (previous ? previous->expiries[cpu] : 0);
+            if (!ticks && !sw && !expiry) continue;
+            /* Main and timer expiry rows are always emitted. Bound incidental
+             * worker noise to 24 rows/window to avoid recreating UI log load. */
+            if (!main && !expiry && (lr37_us(ticks) < 1000 || incidental >= 24)) {
+                ++omitted;
+                continue;
+            }
+            if (!main && !expiry) ++incidental;
+            ++emitted;
+            printf("LITHIUM SCHED thread window=%u at_abs=%llu task=%llu tid=%llu main_tag=%u process=%s name=%s logical=%u residency_us=%llu switches=%llu timer_expiries_on_cpu=%llu last_abs=%llu backwards=%llu\n",
+                lr37_report_sequence, at, row->task_id, row->tid, main, process, name,
+                cpu, lr37_us(ticks), sw, expiry, row->last_tick, row->backwards);
+        }
+    }
+    printf("LITHIUM SCHED window_end=%u emitted=%u omitted_low_activity=%u completed_intervals_only=1\n",
+        lr37_report_sequence, emitted, omitted);
+    bzero(lr37_previous, sizeof(*lr37_previous) * LR37_SLOTS);
+    memcpy(lr37_previous, lr37_snap, sizeof(*lr37_snap) * count);
+    if (++lr37_report_sequence < 360) {
+        uint64_t deadline;
+        clock_interval_to_deadline(5, NSEC_PER_SEC, &deadline);
+        thread_call_enter_delayed(lr37_report_call, deadline);
+    } else printf("LITHIUM SCHED stopped reason=bounded_360_windows\n");
+}
+
+void
+lithium_sched_r37_init(void)
+{
+    unsigned enabled = 0;
+    PE_parse_boot_argn("ui_sched_diag", &enabled, sizeof(enabled));
+    if (enabled != 1 || lr37_report_call) return;
+    lr37_snap = kalloc_data(sizeof(*lr37_snap) * LR37_SLOTS, Z_WAITOK | Z_ZERO);
+    lr37_previous = kalloc_data(sizeof(*lr37_previous) * LR37_SLOTS, Z_WAITOK | Z_ZERO);
+    if (!lr37_snap || !lr37_previous) {
+        printf("LITHIUM SCHED disabled reason=allocation\n");
+        return;
+    }
+    lr37_report_call = thread_call_allocate(lr37_report, NULL);
+    if (!lr37_report_call) {
+        printf("LITHIUM SCHED disabled reason=thread_call\n");
+        return;
+    }
+    lithium_sched_r37_enable();
+    thread_call_enter(lr37_report_call);
+    printf("LITHIUM SCHED armed interval_ms=5000 windows=360 main_source=THREAD_TAG_MAINTHREAD counter=on_cpu_residency_including_interrupts\n");
+}
diff --git a/ports/hakios-lithium/diagnostics/cpu-slowcores-r37.inc b/ports/hakios-lithium/diagnostics/cpu-slowcores-r37.inc
new file mode 100644
index 0000000..42bb4c9
--- /dev/null
+++ b/ports/hakios-lithium/diagnostics/cpu-slowcores-r37.inc
@@ -0,0 +1,101 @@
+/* Included in sched_prim.c. Software recommendation policy only, no CPU_OFF,
+ * clock/voltage access, hardware topology change or scheduler lock bypass.
+ * Not a strict user-thread ban: bound work, direct handoff, sleep and failsafe
+ * can bypass ordinary recommendation-based placement. */
+#include <pexpert/pexpert.h>
+static bool lr37_slowcore_applied;
+
+static void
+lr37_policy_snapshot(void)
+{
+    for (unsigned cpu = 0; cpu < 3; ++cpu) {
+        processor_t p = cpu_to_processor((int)cpu);
+        spl_t level = splsched();
+        pset_lock(p->processor_set);
+        unsigned state = p->state, recommended = p->is_recommended;
+        uint64_t mask = p->processor_set->recommended_bitmask;
+        pset_unlock(p->processor_set);
+        splx(level);
+        printf("LITHIUM CPU POLICY logical=%u state=%u recommended=%u pset_mask=0x%llx online_preserved=1 at_abs=%llu\n",
+            cpu, state, recommended, mask, mach_absolute_time());
+    }
+}
+
+void
+lithium_slowcores_r37_report(void)
+{
+    if (__atomic_load_n(&lr37_slowcore_applied, __ATOMIC_ACQUIRE)) lr37_policy_snapshot();
+}
+
+void
+lithium_slowcores_r37(void)
+{
+    unsigned enabled = 0;
+    PE_parse_boot_argn("slowcores_idle", &enabled, sizeof(enabled));
+    /* Omitted/zero does not look up CPUs or mutate any scheduler mask. */
+    if (enabled != 1 || __atomic_load_n(&lr37_slowcore_applied, __ATOMIC_ACQUIRE)) return;
+    if (!ml_get_interrupts_enabled() || ml_at_interrupt_context() ||
+        !preemption_enabled() || ml_get_max_cpu_number() != 2) {
+        printf("LITHIUM CPU POLICY declined reason=context_or_topology mask_changed=0\n");
+        return;
+    }
+    processor_t cpus[3];
+    for (unsigned i = 0; i < 3; ++i) {
+        cpus[i] = cpu_to_processor((int)i);
+        if (!cpus[i] || cpus[i]->cpu_id != (int)i) {
+            printf("LITHIUM CPU POLICY declined reason=offline_or_slot mask_changed=0\n");
+            return;
+        }
+        spl_t level = splsched();
+        pset_lock(cpus[i]->processor_set);
+        bool online = cpus[i]->state == PROCESSOR_RUNNING || cpus[i]->state == PROCESSOR_IDLE;
+        pset_unlock(cpus[i]->processor_set);
+        splx(level);
+        if (!online) {
+            printf("LITHIUM CPU POLICY declined reason=offline_or_slot mask_changed=0\n");
+            return;
+        }
+    }
+    if (cpus[0] != master_processor) {
+        printf("LITHIUM CPU POLICY declined reason=master_map mask_changed=0\n");
+        return;
+    }
+    uint64_t affinities[3] = {0};
+    processor_t original = thread_bind(cpus[0]);
+    bool match = true;
+    const uint64_t expected[3] = {1, 0x100, 0x101};
+    for (unsigned i = 0; i < 3; ++i) {
+        thread_bind(cpus[i]);
+        thread_block(THREAD_CONTINUE_NULL);
+        affinities[i] = __builtin_arm_rsr64("MPIDR_EL1") & 0x000000ff00ffffffULL;
+        if (cpu_number() != (int)i || affinities[i] != expected[i]) match = false;
+    }
+    thread_bind(original);
+    thread_block(THREAD_CONTINUE_NULL);
+    if (!match) {
+        printf("LITHIUM CPU POLICY declined reason=physical_map actual=0x%llx,0x%llx,0x%llx mask_changed=0\n",
+            affinities[0], affinities[1], affinities[2]);
+        return;
+    }
+    bool old_requests[2];
+    spl_t level = splsched();
+    simple_lock(&sched_available_cores_lock, LCK_GRP_NULL);
+    old_requests[0] = !!(usercontrol_requested_recommended_cores & (1ULL << 1));
+    old_requests[1] = !!(usercontrol_requested_recommended_cores & (1ULL << 2));
+    simple_unlock(&sched_available_cores_lock);
+    splx(level);
+    kern_return_t r1 = sched_processor_enable(cpus[1], FALSE);
+    kern_return_t r2 = r1 == KERN_SUCCESS ? sched_processor_enable(cpus[2], FALSE) : KERN_FAILURE;
+    if (r1 != KERN_SUCCESS || r2 != KERN_SUCCESS) {
+        kern_return_t restore1 = sched_processor_enable(cpus[1], old_requests[0]);
+        kern_return_t restore2 = sched_processor_enable(cpus[2], old_requests[1]);
+        printf("LITHIUM CPU POLICY failed rc1=%d rc2=%d restore1=%d restore2=%d\n",
+            r1, r2, restore1, restore2);
+        lr37_policy_snapshot();
+        return;
+    }
+    __atomic_store_n(&lr37_slowcore_applied, true, __ATOMIC_RELEASE);
+    printf("LITHIUM CPU POLICY requested slowcores_idle=1 keep_affinity=0x1 unrecommend=0x100,0x101 rc1=%d rc2=%d bound_handoff_overrides_possible=1 clocks_changed=0\n",
+        r1, r2);
+    lr37_policy_snapshot();
+}
