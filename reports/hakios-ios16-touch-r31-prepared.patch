+def command_line(base, version):
+    require(base == R30_ARGS, "R30 command line differs from the frozen contract")
+    suffix = " touch_qup_state=1"
+    require(base.endswith(suffix) and R31_ARGS == base[:-len(suffix)] + " touch_qup_phase=1",
+            "R31 must replace only the final R30 state flag with touch_qup_phase=1")
+    require(version and version.isascii() and
+            all(c.isalnum() or c in ".-+_" for c in version),
+            "Invalid actual kernel version")
+    words = R31_ARGS.split()
+    names = [word.partition("=")[0] for word in words]
+    require(len(names) == len(set(names)), "Duplicate R31 boot argument")
+    require(not {"touch_id_probe", "touch_snapshot", "touch_qup_init", "touch_qup_state"}.intersection(names),
+            "R31 must not carry an old ID, snapshot, QUP-init, or QUP-state probe, even disabled/bare")
+    require(all(words.count(word) == 1 for word in (
+        "bootcpu=1", "cpus=1", "ufs=0", "lithiumusb=2", "gl=0", "metal=0",
+        "fbwidth=1080", "fbheight=2040", "loader_return_after=180",
+        "touch_stage=1", "touch_clock_init=1", "touch_diag=1", "touch_qup_phase=1")),
+        "R31 CPU/display/diagnostic contract differs")
+    # No disk selectors are added. The loader contributes rd=md0 itself.
+    require(not any(name.startswith(("root", "var_", "ufs_")) or name in (
+        "rd", "apfs_volume", "hfs_bench", "fsdiag", "hfsdiag", "lsdbfinal")
+        for name in names), "Storage-backed boot option in R31")
+    prefix = ("debug=0x8 rd=md0 ufs_shared_pa=0x" + "0" * 16 +
+              " hakios_kver=" + version + " ")
+    size = len((prefix + "hv_wdt_pet=1 " + R31_ARGS).encode("ascii")) + 1
+    require(size <= 608, "Complete loader command exceeds its 608-byte buffer")
+    return R31_ARGS, dict(capacity_including_nul=608,
+                         conservative_reserved_bytes=size,
+                         spare_bytes=608 - size, conservative_prefix=prefix)
