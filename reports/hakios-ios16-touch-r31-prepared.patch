+def validate_observation_metadata(value):
+    """Fail closed on omitted, mistyped, or broadened R31 scope declarations."""
+    require(isinstance(value, dict), "R31 observation metadata must be an object")
+    for name, expected in observation_metadata().items():
+        require(name in value and same_typed(value[name], expected),
+                "R31 observation scope/claim differs: " + name)
+    validate_source_claims(value)
