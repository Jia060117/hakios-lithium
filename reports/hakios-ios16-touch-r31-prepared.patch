+def verify_r30_ancestry(codec, production, helper, work, current):
+    """Bind the new reviewed port delta to the actual immutable R30 image."""
+    require(sha(R30_DIR / "contract.json") == R30_CONTRACT_SHA and
+            sha(R30_DIR / R30_IMAGE_NAME) == R30_IMAGE_SHA,
+            "Actual R30 contract/image differs from pinned ancestry")
+    prior = read(R30_DIR / "contract.json")
+    require(prior.get("passed") is True and prior.get("revision") == "R30-touch-qup-state" and
+            prior["image_sha256"] == R30_IMAGE_SHA and prior["cmdline"] == R30_ARGS,
+            "Unexpected frozen R30 contract")
+    blob = (R30_DIR / R30_IMAGE_NAME).read_bytes()
+    raw, dtbs, fat, header = codec.decode_android(blob)
+    production.check_boot(blob, raw, dtbs, fat, header)
+    payload = (R30_DIR / "payload.bin").read_bytes()
+    entries = codec.parse_payload(payload)
+    require(raw == (R30_DIR / "Image").read_bytes() and
+            raw[XNUP_START:XNUP_START + len(payload)] == payload and
+            raw[XNUP_START + len(payload):] == NOP * ((-len(payload)) % 16 // 4),
+            "Actual R30 Image/XNUP extent differs")
+    require(digest(raw[0x1000:XNUP_START]) == prior["ram_mu_sha256"] == MU_SHA and
+            digest(fat) == prior["readonly_fat_sha256"] == FAT_SHA,
+            "Actual R30 RAM-only Mu/readonly FAT provenance differs")
+    require(set(entries) == {"kernel", "ramdisk", "resident", "cmdline", "kernel.ver"} and
+            entries["cmdline"] == R30_ARGS.encode("ascii") + b"\0" and
+            digest(entries["kernel"]) == prior["kernel_sha256"] == R30_KERNEL_SHA,
+            "Actual R30 kernel/command-line ancestry differs")
+    for name, data in entries.items():
+        require(prior["payload_entries"][name] == dict(bytes=len(data), sha256=digest(data)),
+                "Actual R30 payload differs: " + name)
+    changed, new_code = verify_source_delta(prior, helper, work, current)
+    return prior, dict(passed=True, image_sha256=digest(blob), contract_sha256=R30_CONTRACT_SHA,
