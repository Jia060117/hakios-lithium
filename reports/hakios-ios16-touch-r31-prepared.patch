+                    phases[phase],pass,i,ltsn_registers[i].name,snapshot_offsets[i],
+                    s->values[pass][i],(unsigned long long)s->at_us[pass][i],
+                    (unsigned long long)s->read_elapsed_us[pass][i]);
+            } else {
