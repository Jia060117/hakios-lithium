+struct r37_stats {
+	uint64_t count, sum, min, max;
+	unsigned overflow;
+};
+
+static int
+r37_add(struct r37_stats *s, uint64_t v)
+{
+	if (s->sum > R37_U64_MAX - v || s->count == R37_U64_MAX) {
+		s->overflow = 1;
+		return 0;
+	}
+	if (!s->count || v < s->min) {
+		s->min = v;
+	}
+	if (!s->count || v > s->max) {
+		s->max = v;
+	}
+	s->count++;
+	s->sum += v;
+	return 1;
+}
+
+static uint64_t
+r37_avg(const struct r37_stats *s)
+{
+	return s->count && !s->overflow ? s->sum / s->count : 0;
