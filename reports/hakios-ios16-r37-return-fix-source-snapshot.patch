+struct r37_cycle_stamp {
+	uint64_t v0, cycles, v1;
+};
+
+static struct r37_cycle_stamp
+r37_cycle_stamp(void)
+{
+	struct r37_cycle_stamp s;
+	R37_ISB();
+	s.v0 = R37_READ(CNTVCT_EL0);
+	R37_ISB();
+	s.cycles = R37_READ(PMCCNTR_EL0);
+	R37_ISB();
+	s.v1 = R37_READ(CNTVCT_EL0);
+	return s;
