+#if TEST_UNOWNED
+		if (scenario == 7) CHECK(strstr(log_buffer, "cycle_interrupt_unbounded"));
+#endif
+		CHECK(!preemption_level && !binding);
+	}
+#if TEST_UNOWNED
+	borrow_mock(); owner_after = 2;
