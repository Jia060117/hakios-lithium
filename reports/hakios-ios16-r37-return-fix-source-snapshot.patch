+mock_printf(const char *fmt, ...)
+{
+	assert(!preemption_level); /* Never print while borrowing the PMU. */
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(log_buffer + log_used, sizeof(log_buffer) - log_used, fmt, ap);
+	va_end(ap);
