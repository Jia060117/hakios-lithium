+static int
+r37_setup_allowed(const struct r37_pmu *p, unsigned request, unsigned unowned)
+{
+	/* Do not take over a disabled-but-reserved cycle/event counter. */
+	return request == 1 && unowned && !p->enable && !p->interrupt &&
+	       !(p->pmcr & (1u << 4));
