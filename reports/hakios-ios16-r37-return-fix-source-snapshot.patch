+#!/usr/bin/env python3
+"""Rebuild only PID1 and its isolated RAM volume, preserving old volumes."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+sys.dont_write_bytecode = True
+import hakios
+
