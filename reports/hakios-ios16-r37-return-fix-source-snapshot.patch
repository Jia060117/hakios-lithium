+            return subprocess.CompletedProcess(argv, 0, f"{self.serial}\tfastboot\n", "")
+        if tail[-2:] == ("oem", "device-info"):
+            return subprocess.CompletedProcess(argv, 0, "Device unlocked: true\n", "")
