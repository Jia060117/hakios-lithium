+#!/usr/bin/env python3
+"""Run one R37 RAM SMP frequency/timer measurement package.
+
+The module is host-only until invoked with --boot or --verify-return.  It
+never flashes, erases, accesses partitions, uses ADB, or boots Android or
+Recovery.  The package manifest must prove that its loader and Mu have no
+physical UFS provider before any device command is allowed.
+"""
+
+from __future__ import annotations
+
+import argparse
+from datetime import datetime, timedelta
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import time
+from typing import Callable, Sequence
+
+
+ROOT = Path(__file__).resolve().parents[2]
+ARTIFACTS_ROOT = ROOT / "artifacts/hakios/lithium-ios16"
+ATTEMPTS_ROOT = ROOT / "reports/local/r37-attempts"
+DEFAULT_PHASE = "frequency"
+DEFAULT_ATTEMPT_ID = "r37-frequency-03"
+TARGET = ROOT / "reports/local/hakios-device-target.json"
+FASTBOOT = Path(r"C:\platform-tools\fastboot.exe")
+USB_PYTHON = Path(r"E:\IOS-MIX1-artifacts\host-usb-venv\Scripts\python.exe")
+USB_SOURCE = ROOT / "scripts/capture-hakios-usb.py"
+USB_SOURCE_SHA256 = "d5a9aecdd3c5ac728b233628d9ae810a598a35ba05d9068d0db3ed70fde3791c"
+
+EXPECTED_ARGS = {
+    "ufs": "0",
+    "bootcpu": "1",
+    "cpus": "3",
+    "ram_smp_return": "1",
+    "loader_return_after": "180",
+    "return_fastboot": "1",
+    "return_fastboot_delay": "10",
+}
+RETURN_MIN_SECONDS = 240
+RETURN_MAX_SECONDS = 900
+USB_WAIT_SECONDS = 180
+# The receiver's duration starts after log-device enumeration. Cover the
+# latest return window, both return-query timeouts, and a scheduling margin if
+# verification is delayed until the deadline. Accepted runs stop it only after
+# the one-shot return verifier completes; this is the hard upper bound.
+USB_CAPTURE_MARGIN_SECONDS = 90 + 2 * 20 + 60
+USB_CAPTURE_SECONDS = RETURN_MAX_SECONDS + USB_CAPTURE_MARGIN_SECONDS
+
+
+class RunnerError(RuntimeError):
+    pass
+
+
+def now() -> str:
+    return datetime.now().astimezone().isoformat()
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_json(path: Path):
+    with path.open(encoding="utf-8") as stream:
+        return json.load(stream)
+
+
+def save_json(path: Path, value) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(path.name + ".tmp")
+    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n",
+                         encoding="utf-8")
+    temporary.replace(path)
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise RunnerError(message)
+
+
+def validate_attempt_id(attempt_id: str, phase: str) -> None:
+    require(phase in {"frequency", "timer"}, "phase must be frequency or timer")
+    require(re.fullmatch(r"r37-(frequency|timer)-[0-9]{2,}", attempt_id) is not None,
+            "attempt id must be phase-scoped, e.g. r37-frequency-01")
+    require(attempt_id.startswith(f"r37-{phase}-"),
+            "attempt id phase does not match the selected diagnostic phase")
+
+
+def attempt_suffix(attempt_id: str, phase: str) -> str:
+    validate_attempt_id(attempt_id, phase)
+    return attempt_id.rsplit("-", 1)[1]
+
+
+def attempt_paths(attempt_id: str, phase: str,
+                  attempts_root: Path = ATTEMPTS_ROOT) -> tuple[Path, Path, Path]:
+    validate_attempt_id(attempt_id, phase)
+    local = attempts_root / attempt_id
+    return local, local / "boot-intent.json", local / "return-verification-intent.json"
+
+
+def package_for_attempt(attempt_id: str, phase: str,
+                       artifacts_root: Path = ARTIFACTS_ROOT) -> Path:
+    suffix = attempt_suffix(attempt_id, phase)
+    return artifacts_root / f"phase4-r37-ram-{phase}-{suffix}"
+
+
+def resolve_package(phase: str, attempt_id: str, package: Path | None,
+                    contract_path: Path | None,
+                    artifacts_root: Path = ARTIFACTS_ROOT) -> tuple[Path, Path]:
+    expected = package_for_attempt(attempt_id, phase, artifacts_root)
+    selected = expected if package is None else package
+    require(selected.name == expected.name,
+            f"package must be the phase-scoped package {expected.name}")
+    selected_contract = selected / "contract.json" if contract_path is None else contract_path
+    require(selected_contract.name == "contract.json" and
+            selected_contract.parent == selected,
+            "contract must be the selected package's contract.json")
+    return selected, selected_contract
+
+
+def unique_arg(tokens: list[str], name: str) -> str:
+    values = [token.split("=", 1)[1] for token in tokens
+              if token.startswith(name + "=")]
+    require(len(values) == 1, f"boot arguments must contain one {name}= token")
+    return values[0]
+
+
+def validate_no_physical_ufs_proof(contract: dict) -> None:
+    """Require the explicit RAM loader/Mu proof used by prior RAM packages."""
+    required = (
+        "physical_ufs_provider_absent",
+        "ufs_bridge_disabled",
+        "root_data_storage_arguments_absent",
+        "persistent_log_disabled",
+    )
+    missing = [name for name in required if contract.get(name) is not True]
+    require(not missing,
+            "manifest lacks explicit no-physical-UFS loader/Mu proof: " +
+            ", ".join(missing))
+    require(contract.get("normal_boot_may_write_userdata") is False,
+            "RAM package must declare that normal boot does not write userdata")
+    require(contract.get("partition_operations") is False,
+            "RAM package must declare partition operations disabled")
+
+
+def validate_package(package: Path, contract_path: Path, phase: str,
+                     attempt_id: str) -> dict:
+    require(phase in {"frequency", "timer"}, "phase must be frequency or timer")
+    validate_attempt_id(attempt_id, phase)
+    require(contract_path.is_file(), "R37 RAM measurement contract is missing")
+    contract = load_json(contract_path)
+    require(contract.get("passed") is True, "RAM measurement package did not pass")
+    require(contract.get("profile") == f"r37-{phase}",
+            f"manifest profile must be r37-{phase}")
+    require(contract.get("candidate") == f"R37-{phase}-{attempt_suffix(attempt_id, phase)}",
+            "manifest candidate does not match the unique phase-scoped attempt")
+    require(contract.get("ram_smp_return") is True,
+            "manifest does not explicitly enable ram_smp_return")
+    require(contract.get("return_fastboot") is True,
+            "manifest does not explicitly enable return_fastboot")
+    validate_no_physical_ufs_proof(contract)
+
+    args = contract.get("cmdline")
+    require(isinstance(args, str) and args.strip(), "manifest boot arguments are missing")
+    tokens = args.split()
+    for name, expected in EXPECTED_ARGS.items():
+        require(unique_arg(tokens, name) == expected,
+                f"boot argument {name} must equal {expected}")
+    required_diag = "cpu_freq_diag" if phase == "frequency" else "timer_migrate_diag"
+    excluded_diag = "timer_migrate_diag" if phase == "frequency" else "cpu_freq_diag"
+    require(unique_arg(tokens, required_diag) == "1",
+            f"{phase} contract requires {required_diag}=1")
+    require(not any(token.startswith(excluded_diag + "=") for token in tokens),
+            f"{phase} package must omit {excluded_diag}; diagnostics run separately")
+
+    image_info = contract.get("image")
+    require(isinstance(image_info, dict), "manifest image metadata is missing")
+    image_name = image_info.get("path")
+    require(isinstance(image_name, str) and image_name == Path(image_name).name,
+            "manifest image path must be package-local")
+    image = package / image_name
+    require(image.is_file(), "RAM measurement image is missing")
+    image_sha = image_info.get("sha256")
+    image_bytes = image_info.get("bytes")
+    require(isinstance(image_sha, str) and re.fullmatch(r"[0-9a-f]{64}", image_sha) is not None,
+            "manifest image SHA256 is invalid")
+    require(isinstance(image_bytes, int) and image_bytes > 0,
+            "manifest image size is invalid")
+    require(sha256(image) == image_sha and image.stat().st_size == image_bytes,
+            "RAM measurement image SHA256 or size differs from manifest")
+
+    components = contract.get("components")
+    require(isinstance(components, dict) and components,
+            "manifest component SHA256 map is missing")
+    for name, entry in components.items():
+        require(isinstance(name, str) and name == Path(name).name,
+                f"component path is not package-local: {name!r}")
+        component = package / name
+        require(component.is_file(), f"manifest component is missing: {name}")
+        expected = entry.get("sha256") if isinstance(entry, dict) else None
+        require(isinstance(expected, str) and re.fullmatch(r"[0-9a-f]{64}", expected) is not None,
+                f"component SHA256 is invalid: {name}")
+        require(sha256(component) == expected,
+                f"component SHA256 differs: {name}")
+
+    return {"contract": contract, "image": image, "image_sha256": image_sha,
+            "image_bytes": image_bytes, "cmdline": args,
+            "component_count": len(components), "profile": contract["profile"],
+            "candidate": contract["candidate"]}
+
+
+def validate_fastboot_command(argv: Sequence[str], fastboot: Path = FASTBOOT) -> None:
+    """Keep all device commands within the R34-style read/temporary-boot set."""
+    values = tuple(str(value) for value in argv)
+    require(values and Path(values[0]).resolve() == fastboot.resolve(),
+            "unexpected executable in device command")
+    tail = values[1:]
+    if tail == ("devices",):
+        return
+    if len(tail) == 4 and tail[0] == "-s" and tail[2] == "getvar" and \
+            tail[3] in {"product", "battery-soc-ok", "max-download-size"}:
+        return
+    if len(tail) == 4 and tail[0] == "-s" and tail[2:] == ("oem", "device-info"):
+        return
+    if len(tail) == 4 and tail[0] == "-s" and tail[2] == "boot":
+        return
+    raise RunnerError("Fastboot command is outside the runner allowlist")
+
+
+class CommandLog:
+    def __init__(self, path: Path, fastboot: Path = FASTBOOT,
+                 invoke: Callable = subprocess.run, *, require_existing: bool = False):
+        self.path = path
+        self.fastboot = fastboot
+        self.invoke = invoke
+        if path.exists():
+            rows = load_json(path)
+            require(isinstance(rows, list) and all(isinstance(row, dict) for row in rows),
+                    "device command history is malformed")
+            self.rows = rows
+        else:
+            require(not require_existing, "device command history is missing; no return query")
+            self.rows: list[dict] = []
+
+    def call(self, argv: Sequence[str], *, phase: str, timeout: int = 20):
+        validate_fastboot_command(argv, self.fastboot)
+        row = {"started_at": now(), "phase": phase,
+               "argv": list(map(str, argv)), "retry": False}
+        self.rows.append(row)
+        save_json(self.path, self.rows)
+        try:
+            result = self.invoke(list(map(str, argv)), capture_output=True, text=True,
+                                 encoding="utf-8", errors="replace", timeout=timeout)
+            row.update(returncode=result.returncode, stdout=result.stdout or "",
+                       stderr=result.stderr or "", launched=True)
+        except Exception as error:
+            row.update(returncode=None, stdout="", stderr="",
+                       exception=str(error), launched=False)
+            save_json(self.path, self.rows)
+            raise RunnerError(f"device command failed without retry: {error}") from error
+        row["finished_at"] = now()
+        save_json(self.path, self.rows)
+        return result
+
+
+def output(result) -> str:
+    return (result.stdout or "") + (result.stderr or "")
+
+
+def getvar(commands: CommandLog, serial: str, key: str, phase: str) -> str:
+    result = commands.call([commands.fastboot, "-s", serial, "getvar", key],
+                           phase=phase)
+    require(result.returncode == 0, f"getvar {key} failed")
+    match = re.search(re.escape(key) + r":\s*([^\r\n]+)", output(result), re.IGNORECASE)
+    require(match is not None, f"getvar {key} returned no value")
+    return match.group(1).strip()
+
+
+def preflight(commands: CommandLog, target: dict, image_bytes: int) -> dict:
+    serial = target["serial"]
+    result = commands.call([commands.fastboot, "devices"], phase="preflight")
+    require(result.returncode == 0, "fastboot devices failed")
+    rows = [line.split() for line in output(result).splitlines() if line.strip()]
+    require(rows == [[serial, "fastboot"]], "configured Fastboot target is not the sole device")
+    require(getvar(commands, serial, "product", "preflight") == target["product"],
+            "Fastboot product mismatch")
+    unlocked = commands.call([commands.fastboot, "-s", serial, "oem", "device-info"],
+                             phase="preflight")
+    require(unlocked.returncode == 0 and
+            re.search(r"Device unlocked:\s*true", output(unlocked), re.IGNORECASE),
+            "bootloader is not confirmed unlocked")
+    require(getvar(commands, serial, "battery-soc-ok", "preflight").lower() == "yes",
+            "battery-soc-ok is not yes")
+    download = getvar(commands, serial, "max-download-size", "preflight")
+    require(re.fullmatch(r"(?:0[xX])?[0-9a-fA-F]+", download) is not None,
+            "max-download-size is malformed")
+    require(int(download, 16) >= image_bytes, "Fastboot download window is too small")
+    return {"passed": True, "finished_at": now(), "device_commands": 5,
+            "retry": False}
+
+
+def start_capture(run_dir: Path, image_name: str, usb_python: Path,
+                  usb_source: Path, usb_source_sha: str, popen: Callable,
+                  *, duration: int = USB_CAPTURE_SECONDS):
+    require(usb_python.is_file(), "USB capture Python environment is missing")
+    require(sha256(usb_source) == usb_source_sha, "USB receiver source SHA256 differs")
+    receiver = run_dir / "capture-host.py"
+    shutil.copyfile(usb_source, receiver)
+    require(sha256(receiver) == usb_source_sha, "private USB receiver copy differs")
+    with (run_dir / "usb-host.txt").open("x", encoding="utf-8") as host_log:
+        process = popen(
+            [str(usb_python), "-B", "-u", str(receiver),
+             "--output", str(run_dir / "console.log"),
+             "--status", str(run_dir / "usb-status.json"),
+             "--wait", str(USB_WAIT_SECONDS), "--duration", str(duration),
+             "--stop-file", str(run_dir / "stop-usb")],
+            stdout=host_log, stderr=subprocess.STDOUT,
+            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+    save_json(run_dir / "usb-process.json", {
+        "pid": process.pid, "started_at": now(),
+        "receiver_sha256": usb_source_sha, "duration_seconds": duration,
+        "device_commands_sent": False})
+    status = run_dir / "usb-status.json"
+    deadline = time.monotonic() + 30
+    while time.monotonic() < deadline:
+        if status.is_file() or process.poll() is not None:
+            break
+        time.sleep(0.1)
+    require(status.is_file() and process.poll() is None,
+            "USB capture did not initialize; no boot issued")
+    return process
+
+
+def stop_capture(run_dir: Path, process) -> None:
+    if process is None or process.poll() is not None:
+        return
+    (run_dir / "stop-usb").touch()
+    try:
+        process.wait(timeout=10)
+    except subprocess.TimeoutExpired:
+        process.terminate()
+        process.wait(timeout=10)
+
+
+def validate_boot_history(rows: list[dict]) -> None:
+    """Require the complete successful preflight and one accepted boot record."""
+    require(len(rows) == 6, "device command history is incomplete; no return query")
+    require(sum(row.get("phase") == "preflight" for row in rows) == 5 and
+            sum(row.get("phase") == "boot" for row in rows) == 1,
+            "device command history lacks the five preflight rows and one boot row")
+    require(all(row.get("launched") is True and row.get("returncode") == 0 and
+                row.get("retry") is False for row in rows),
+            "device command history contains an incomplete or failed command")
+    boot_rows = [row for row in rows if row.get("phase") == "boot"]
+    require(re.search(r"Booting\s+OKAY", boot_rows[0].get("stdout", "") +
+                      boot_rows[0].get("stderr", ""), re.IGNORECASE) is not None,
+            "device command history does not prove the accepted temporary boot")
+
+
+def boot(*, package: Path | None = None, contract_path: Path | None = None,
+         phase: str = DEFAULT_PHASE, attempt_id: str = DEFAULT_ATTEMPT_ID,
+         local: Path | None = None, boot_guard: Path | None = None,
+         attempts_root: Path = ATTEMPTS_ROOT,
+         artifacts_root: Path = ARTIFACTS_ROOT,
+         target_path: Path = TARGET, fastboot: Path = FASTBOOT,
+         usb_python: Path = USB_PYTHON, usb_source: Path = USB_SOURCE,
+         usb_source_sha: str = USB_SOURCE_SHA256,
+         command_invoke: Callable = subprocess.run,
+         popen: Callable = subprocess.Popen) -> dict:
+    validate_attempt_id(attempt_id, phase)
+    default_local, default_boot_guard, _ = attempt_paths(attempt_id, phase, attempts_root)
+    local = local or default_local
+    boot_guard = boot_guard or (local / "boot-intent.json" if local != default_local
+                                else default_boot_guard)
+    package, contract_path = resolve_package(phase, attempt_id, package,
+                                             contract_path, artifacts_root)
+    admission = validate_package(package, contract_path, phase, attempt_id)
+    readback = admission["contract"].get("readback", {})
+    require(readback.get("shim_copy_length") is True and
+            readback.get("modeled_relocation_exact") is True and
+            readback.get("smp_pid1_hold") is True and
+            readback.get("seeded_uefi_owner") is True,
+            "new boot requires complete BootShim relocation and SMP PID1 hold readback")
+    require(fastboot.is_file(), "Fastboot executable is missing")
+    require(target_path.is_file(), "device target record is missing")
+    target = load_json(target_path)
+    require(isinstance(target.get("serial"), str) and target["serial"],
+            "device serial is missing")
+    require(isinstance(target.get("product"), str) and target["product"],
+            "device product is missing")
+    require(not boot_guard.exists(), "RAM measurement boot guard already exists; no retry")
+    require(not local.exists(), "RAM measurement run directory already exists; no retry")
+    local.mkdir(parents=True, exist_ok=False)
+    with boot_guard.open("x", encoding="utf-8") as stream:
+        json.dump({"attempt_id": attempt_id, "phase": phase,
+                   "started_at": now(), "accepted": False, "retry": False,
+                   "image_sha256": admission["image_sha256"]}, stream, indent=2)
+
+    commands = CommandLog(local / "commands.json", fastboot, command_invoke)
+    state = {
+        "schema": 1, "revision": "R37-ram-measure", "phase": phase,
+        "attempt_id": attempt_id, "started_at": now(),
+        "package": str(package), "candidate": admission["candidate"],
+        "profile": admission["profile"],
+        "image_sha256": admission["image_sha256"],
+        "image_bytes": admission["image_bytes"], "boot_args": admission["cmdline"],
+        "preflight_passed": False, "boot_attempted": False,
+        "command_accepted": False, "automatic_retry": False,
+        "partition_commands": 0, "flash_commands": 0, "erase_commands": 0,
+        "adb_commands": 0, "android_recovery_boots": 0, "qemu": False,
+    }
+    save_json(local / "authorization.json", state)
+    save_json(local / "result.json", state)
+    process = None
+    try:
+        state["preflight"] = preflight(commands, target, admission["image_bytes"])
+        state["preflight_passed"] = True
+        private = local / admission["image"].name
+        shutil.copyfile(admission["image"], private)
+        require(sha256(private) == admission["image_sha256"] and
+                private.stat().st_size == admission["image_bytes"],
+                "private image copy differs")
+        state["private_image"] = str(private)
+        save_json(local / "result.json", state)
+
+        # USB capture is live before the one and only boot command.
+        process = start_capture(local, private.name, usb_python, usb_source,
+                                usb_source_sha, popen)
+        state["usb_capture_started_at"] = now()
+        state["boot_attempted"] = True
+        save_json(local / "result.json", state)
+        result = commands.call([fastboot, "-s", target["serial"], "boot", private],
+                               phase="boot", timeout=90)
+        state["boot_output"] = output(result)
+        state["boot_returncode"] = result.returncode
+        accepted = result.returncode == 0 and re.search(
+            r"Booting\s+OKAY", output(result), re.IGNORECASE) is not None
+        require(accepted, "temporary boot was not accepted; no retry")
+        accepted_at = now()
+        state.update(command_accepted=True, accepted_at=accepted_at,
+                     outcome="boot_accepted_observation_pending")
+        save_json(local / "result.json", state)
+        guard = load_json(boot_guard)
+        guard.update(accepted=True, accepted_at=accepted_at)
+        save_json(boot_guard, guard)
+        print("R37 RAM measurement image accepted once; USB capture is running.")
+        return state
+    except Exception as error:
+        state.update(outcome="stopped_no_retry", failure=str(error), stopped_at=now())
+        save_json(local / "result.json", state)
+        if process is not None:
+            stop_capture(local, process)
+        raise
+
+
+def verify_return(*, phase: str = DEFAULT_PHASE, attempt_id: str = DEFAULT_ATTEMPT_ID,
+                  local: Path | None = None, return_guard: Path | None = None,
+                  attempts_root: Path = ATTEMPTS_ROOT,
+                  artifacts_root: Path = ARTIFACTS_ROOT,
+                  target_path: Path = TARGET, fastboot: Path = FASTBOOT,
+                  command_invoke: Callable = subprocess.run) -> dict:
+    validate_attempt_id(attempt_id, phase)
+    default_local, _, default_return_guard = attempt_paths(attempt_id, phase, attempts_root)
+    local = local or default_local
+    return_guard = return_guard or (local / "return-verification-intent.json"
+                                    if local != default_local else default_return_guard)
+    require(local.is_dir(), "RAM measurement run directory is missing")
+    require(not return_guard.exists(), "return verification guard already exists; no retry")
+    state = load_json(local / "result.json")
+    require(state.get("command_accepted") is True, "accepted RAM boot is required")
+    require(state.get("attempt_id") == attempt_id and state.get("phase") == phase,
+            "run result does not belong to this phase-scoped attempt")
+    accepted_at = datetime.fromisoformat(state["accepted_at"])
+    elapsed = (datetime.now().astimezone() - accepted_at).total_seconds()
+    require(RETURN_MIN_SECONDS <= elapsed <= RETURN_MAX_SECONDS,
+            "return verification is outside the one-shot 240..900 second window")
+    require(fastboot.is_file(), "Fastboot executable is missing")
+    target = load_json(target_path)
+    require(isinstance(target.get("serial"), str) and target["serial"] and
+            isinstance(target.get("product"), str) and target["product"],
+            "Fastboot target identity is incomplete; no return query")
+    with return_guard.open("x", encoding="utf-8") as stream:
+        json.dump({"started_at": now(), "elapsed_seconds": elapsed,
+                   "retry": False}, stream, indent=2)
+    serial = target["serial"]
+    result = {"started_at": now(), "elapsed_seconds": elapsed,
+              "devices_query_count": 0, "product_query_count": 0,
+              "device_rows": [], "same_serial_fastboot": False,
+              "observed_product": None, "product_verified": False,
+              "passed": False, "retry": False,
+              "attempt_id": attempt_id, "phase": phase}
+    try:
+        package, contract_path = resolve_package(phase, attempt_id, None, None,
+                                                 artifacts_root)
+        admission = validate_package(package, contract_path, phase, attempt_id)
+        require(state.get("package") == str(package) and
+                state.get("candidate") == admission["candidate"] and
+                state.get("profile") == admission["profile"] and
+                state.get("image_sha256") == admission["image_sha256"],
+                "selected package differs from the accepted phase-scoped attempt")
+        commands = CommandLog(local / "commands.json", fastboot, command_invoke,
+                              require_existing=True)
+        validate_boot_history(commands.rows)
+        result["devices_query_count"] = 1
+        devices = commands.call([fastboot, "devices"], phase="post_run_verify")
+        rows = [line.split() for line in output(devices).splitlines() if line.strip()]
+        devices_ok = devices.returncode == 0 and rows == [[serial, "fastboot"]]
+        result.update(device_rows=rows, same_serial_fastboot=devices_ok)
+        if not devices_ok:
+            result["failure"] = "expected sole Fastboot target not found; product query skipped"
+        else:
+            result["product_query_count"] = 1
+            product = commands.call([fastboot, "-s", serial, "getvar", "product"],
+                                    phase="post_run_verify")
+            match = re.search(r"product:\s*([^\r\n]+)", output(product), re.IGNORECASE)
+            observed = match.group(1).strip() if match else None
+            product_ok = product.returncode == 0 and observed == target["product"]
+            result.update(observed_product=observed, product_verified=product_ok,
+                          passed=product_ok)
+            if not product_ok:
+                result["failure"] = "Fastboot product did not match the configured target"
+    except Exception as error:
+        result["failure"] = str(error)
+    finally:
+        try:
+            (local / "stop-usb").touch(exist_ok=True)
+            result["capture_stop_requested"] = True
+        except Exception as error:
+            result["capture_stop_requested"] = False
+            result["capture_stop_error"] = str(error)
+        result["finished_at"] = now()
+        save_json(local / "return-verification.json", result)
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+    return result
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    actions = parser.add_mutually_exclusive_group(required=True)
+    actions.add_argument("--boot", action="store_true")
+    actions.add_argument("--verify-return", action="store_true")
+    parser.add_argument("--phase", choices=("frequency", "timer"), default=DEFAULT_PHASE)
+    parser.add_argument("--attempt-id", default=DEFAULT_ATTEMPT_ID)
+    args = parser.parse_args(argv)
+    try:
+        if args.boot:
+            boot(phase=args.phase, attempt_id=args.attempt_id)
+        else:
+            result = verify_return(phase=args.phase, attempt_id=args.attempt_id)
+            if result.get("passed") is not True:
+                return 1
+    except Exception as error:
+        print(f"STOPPED WITHOUT RETRY: {error}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
