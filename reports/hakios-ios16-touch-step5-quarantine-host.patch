+int main(void)
+{
+    lengths(); invalid(); faults(); adapter(); touch_adapter_helpers(); cleanup_edges(); no_software_reset(); r21_admission();
+    puts("PASS: combined FIFO lengths/tags/gates/capacity/faults/cleanup/32+31 adapter");
