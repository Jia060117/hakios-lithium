+        raw_head = bytearray(0x1000)
+        struct.pack_into("<2Q", raw_head, 8, 0x80000, pkg.IMAGE_RESERVATION)
+        raw = bytes(raw_head) + mu + payload + pkg.NOP * ((-len(payload)) % 16 // 4)
+        header = bytes(head)
+        blob = pkg.make_android(raw, dtbs, fat, header)
