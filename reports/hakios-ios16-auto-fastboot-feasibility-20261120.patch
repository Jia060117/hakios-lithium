diff --git a/evidence/fastboot-return-audit-20261120/verify-reset-audit.py b/evidence/fastboot-return-audit-20261120/verify-reset-audit.py
new file mode 100755
index 0000000..b2f200f
--- /dev/null
+++ b/evidence/fastboot-return-audit-20261120/verify-reset-audit.py
@@ -0,0 +1,92 @@
+"""Host-only, independent evidence checks; never opens a device or emits firmware."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = Path(__file__).resolve().parent
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+manifest = json.loads((OUT / "reset/source-manifest.json").read_text())
+checks = []
+range_defects = []
+for item in manifest["local_sources"]:
+    data = (ROOT / item["path"]).read_bytes()
+    assert sha(data) == item["sha256"], item["path"]
+    lines = data.decode().splitlines()
+    for first, last in item.get("reviewed_lines_1based", []):
+        if not 1 <= first <= last <= len(lines):
+            range_defects.append({"path": item["path"], "first": first,
+                                  "last": last, "actual_lines": len(lines)})
+    checks.append(item["key"])
+
+acquired = json.loads((OUT / "reset/acquired-sources.json").read_text())
+for item in acquired["sources"]:
+    data = (ROOT / item["local_path"]).read_bytes()
+    assert sha(data) == item["sha256"], item["local_path"]
+    blob = hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest()
+    assert blob == item["expected_git_blob_sha1"], item["local_path"]
+    checks.append(item["key"])
+
+metadata = json.loads((OUT / "reset/stock-dt-evidence.json").read_text())
+boot = (ROOT / metadata["source"]).read_bytes()
+assert sha(boot) == metadata["source_sha256"]
+dtbs = []
+for item in metadata["candidate_dtbs"]:
+    start = int(item["boot_image_offset"], 16)
+    data = boot[start:start + item["dtb_bytes"]]
+    assert sha(data) == item["dtb_sha256"]
+    magic, total, so, strings, _, _, _, _, string_size, struct_size = struct.unpack_from(">10I", data)
+    assert magic == 0xD00DFEED and total == len(data)
+    assert strings + string_size <= total and so + struct_size <= total
+    pos, stack, nodes, ended = so, [], {}, False
+    while pos < so + struct_size:
+        token, = struct.unpack_from(">I", data, pos)
+        pos += 4
+        if token == 1:
+            end = data.index(b"\0", pos, so + struct_size)
+            stack.append(data[pos:end].decode())
+            pos = (end + 4) & ~3
+            nodes["/" + "/".join(stack[1:])] = {}
+        elif token == 2:
+            stack.pop()
+        elif token == 3:
+            length, nameoff = struct.unpack_from(">II", data, pos)
+            pos += 8
+            assert nameoff < string_size and pos + length <= so + struct_size
+            nameend = data.index(b"\0", strings + nameoff, strings + string_size)
+            name = data[strings + nameoff:nameend].decode()
+            nodes["/" + "/".join(stack[1:])][name] = data[pos:pos + length]
+            pos = (pos + length + 3) & ~3
+        elif token == 4:
+            pass
+        elif token == 9:
+            assert not stack
+            ended = True
+            break
+        else:
+            raise AssertionError(("FDT token", token))
+    assert ended
+    parent = nodes["/soc/qcom,msm-imem@66bf000"]
+    base = struct.unpack(">III", parent["ranges"])[1]
+    offset, size = struct.unpack(">II", nodes["/soc/qcom,msm-imem@66bf000/restart_reason@65c"]["reg"])
+    assert base + offset == 0x066BF65C and size == 4
+    pon = [props for props in nodes.values() if "qcom,system-reset" in props]
+    assert pon and any("qcom,store-hard-reset-reason" in props for props in pon)
+    dtbs.append({"offset": item["boot_image_offset"], "hash_matches": True,
+                 "address_independently_derived": hex(base + offset), "store_hard_reset_reason": True})
+
+result = {"passed": not range_defects, "source_files_checked": len(checks), "source_keys": checks,
+          "source_range_defects": range_defects,
+          "stock_boot_hash_matches": True, "independently_parsed_dtbs": dtbs,
+          "hardware_access_retention_and_fastboot_result": "unverified",
+          "device_operations": 0}
+(OUT / "reset-main-verification.json").write_text(json.dumps(result, indent=2) + "\n")
+print(json.dumps({"passed": not range_defects, "source_files": len(checks), "parsed_dtbs": len(dtbs),
+                  "source_range_defects": range_defects, "device_operations": 0}))
+assert not range_defects, "Source ranges require correction; other evidence checks completed"
