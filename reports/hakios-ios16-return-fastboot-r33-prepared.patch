new file mode 100644
index 0000000..725c681
--- /dev/null
+++ b/scripts/check-hakios-return-fastboot-offline.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Independent byte-level R33 readback; never opens a device."""
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+import zlib
+sys.dont_write_bytecode = True
+import hakios
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT/'artifacts/hakios/lithium-ios16/phase4-r33-return-fastboot'
+EVIDENCE = ROOT/'evidence/fastboot-return-impl-20261120/main'
+ARGS = ('bootcpu=1 cpus=1 serial=3 -v ufs=0 lithiumusb=2 gl=0 metal=0 '
+    'fbwidth=1080 fbheight=2040 fb_threads=1 fb_filter=0 loader_return_after=180 '
+    'usertraps=1 epoch=1794940756 fastboot_return_test=1 return_fastboot=1 return_fastboot_delay=10')
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def main():
+    contract=json.loads((OUT/'contract.json').read_text())
+    image=Path(contract['image_path']).read_bytes()
+    assert sha(image)==contract['image_sha256'] and len(image)==contract['image_bytes']
+    assert image[:8]==b'ANDROID!'
+    ks,_,rs,_,ss,_,_,page=struct.unpack_from('<8I',image,8)
+    assert page==4096 and ss==0
+    align=lambda n:(n+4095)&~4095
+    packed=image[page:page+ks]
+    fat=image[page+align(ks):page+align(ks)+rs]
+    assert len(image)==page+align(ks)+align(rs)
+    digest=hashlib.sha1()
+    for part in (packed,fat,b''): digest.update(part);digest.update(struct.pack('<I',len(part)))
+    assert image[576:596]==digest.digest()
+    decoder=zlib.decompressobj(31)
+    raw=decoder.decompress(packed)+decoder.flush()
+    assert decoder.eof and decoder.unused_data and not decoder.unconsumed_tail
+    assert raw==(OUT/'Image').read_bytes()
+    assert raw[0x1000:0x301000]==(OUT/'lithium.fd').read_bytes()
+    payload=(OUT/'payload.bin').read_bytes()
+    assert raw[0x301000:0x301000+len(payload)]==payload
+    magic,total=struct.unpack_from('<II',payload)
+    assert magic==0x50554e58 and total==len(payload)-8
+    at,entries=8,{}
+    while at+24<=len(payload):
+        name,count,reserved=struct.unpack_from('<16sII',payload,at)
+        at+=24
+        assert reserved==0
+        if name==bytes(16):
+            assert count==0 and at==len(payload)
+            break
+        name=name.split(b'\0',1)[0].decode()
+        assert name not in entries and at+count<=len(payload)
+        entries[name]=payload[at:at+count]
+        at+=(count+15)&~15
+    assert set(entries)=={'kernel','ramdisk','resident','cmdline','kernel.ver'}
+    assert entries['cmdline']==ARGS.encode()+b'\0'
+    assert entries['kernel']==(OUT/'hakios-kernel').read_bytes()
+    assert entries['ramdisk']==(OUT/'root.apfs').read_bytes()
+    assert entries['resident']==(OUT/'flashboot.apfs').read_bytes()
+    kernel=entries['kernel']
+    header=struct.unpack_from('<8I',kernel)
+    assert header[0]==0xfeedfacf and header[1]==0x100000c and header[2]==0
+    expected=bytearray(128)
+    expected[:8]=b'HKFBRET1'
+    for offset,value in ((8,1),(12,128),(20,1),(40,10)):
+        struct.pack_into('<I',expected,offset,value)
+    locations=[];start=0
+    while True:
+        hit=kernel.find(expected,start)
+        if hit<0:break
+        locations.append(hit);start=hit+1
+    assert len(locations)==1
+    file_at=locations[0]
+    at=32;vm_address=None
+    for _ in range(header[4]):
+        cmd,size=struct.unpack_from('<II',kernel,at)
+        assert size>=8 and at+size<=32+header[5]
+        if cmd==25:
+            vm,vmsize,off,count=struct.unpack_from('<4Q',kernel,at+24)
+            if off<=file_at and file_at+128<=off+count:
+                assert vm_address is None
+                vm_address=vm+file_at-off
+        at+=size
+    assert vm_address is not None and vm_address%64==0
+    for rel,digest in contract['frozen_baselines_sha256'].items():
+        assert sha(Path(rel).read_bytes())==digest,rel
+    source=hakios.inputs(hakios.read(hakios.MANIFEST))
+    assert source==contract['inputs']
+    checked=0
+    for name,digest in contract['evidence_sha256'].items():
+        p=Path(name)
+        if not p.is_absolute(): p=ROOT/p
+        assert sha(p.read_bytes())==digest,name
+        checked+=1
+    result=dict(passed=True,scope='independent current-byte readback, not hardware acceptance',
+        image_sha256=contract['image_sha256'],image_bytes=len(image),android_sha1=True,
+        gzip=True,mu_exact=True,xnup_exact=True,arguments_exact=True,
+        arm64_not_arm64e=True,initial_wire_candidates=locations,
+        initial_wire_vm_address=hex(vm_address),initial_wire_aligned64=True,
+        source_closure_current=True,evidence_files_rehashed=checked,
+        frozen_baselines_unchanged=True,device_operations=0,
+        automatic_fastboot_hardware_verified=False,physical_touch_verified=False)
+    (EVIDENCE/'final-offline-readback.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps(result))
+
+
+if __name__=='__main__':
+    main()
diff --git a/scripts/export-hakios-return-fastboot-checkpoint.py b/scripts/export-hakios-return-fastboot-checkpoint.py
new file mode 100644
index 0000000..e00705f
--- /dev/null
+++ b/scripts/export-hakios-return-fastboot-checkpoint.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Export an exact reversible source/document delta; never modifies Git staging."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT=Path(__file__).resolve().parents[1]
+MAIN=ROOT/'evidence/fastboot-return-impl-20261120/main'
+BEFORE=MAIN/'before'
+STEM=ROOT/'reports/hakios-ios16-return-fastboot-r33-prepared'
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def main():
+    before=json.loads((MAIN/'snapshot.json').read_text())
+    names=set(before['files'])
+    names.update(p.relative_to(ROOT).as_posix() for p in
+        (ROOT/'ports/hakios-lithium').rglob('*') if p.is_file() and '__pycache__' not in p.parts)
+    names.update(p.relative_to(ROOT).as_posix() for p in (ROOT/'scripts').glob('*return*fastboot*.py'))
+    names.update({'scripts/hakios_return_fastboot.py',
+        'reports/hakios-ios16-return-fastboot-r33-prepared.md',
+        'reports/hakios-ios16-return-fastboot-r33-prepared.json',
+        'reports/hakios-ios16-return-fastboot-build.json',
+        'reports/hakios-ios16-return-fastboot-build-checks.json',
+        'evidence/fastboot-return-impl-20261120/main/common-transform.json',
+        'evidence/fastboot-return-impl-20261120/main/final-offline-readback.json',
+        'evidence/fastboot-return-impl-20261120/main/linked-feature-review.json'})
+    changed=[]
+    for name in sorted(names):
+        old=BEFORE/name;new=ROOT/name
+        a=old.read_bytes() if old.is_file() else None
+        b=new.read_bytes() if new.is_file() else None
+        if a!=b:
+            assert b is None or b'\0' not in b, 'No firmware/binary in source checkpoint: '+name
+            changed.append((name,a,b))
+    patch=STEM.with_suffix('.patch')
+    assert not patch.exists()
+    env=dict(os.environ,GIT_OPTIONAL_LOCKS='0')
+    chunks=[]
+    with tempfile.TemporaryDirectory(prefix='rfbt-source-diff-') as temporary:
+        temp=Path(temporary)
+        for name,a,b in changed:
+            old=temp/'old';new=temp/'new'
+            if a is not None:old.write_bytes(a)
+            if b is not None:new.write_bytes(b)
+            args=['git','diff','--no-index','--binary','--',
+                'old' if a is not None else '/dev/null',
+                'new' if b is not None else '/dev/null']
+            p=subprocess.run(args,cwd=temp,env=env,capture_output=True)
+            assert p.returncode==1,(name,p.stderr)
+            # Rewrite only diff headers, never matching string literals in a
+            # hunk (including this exporter's own source).
+            lines=[]
+            for line in p.stdout.splitlines(keepends=True):
+                if line.startswith(b'diff --git '):
+                    line=('diff --git a/'+name+' b/'+name+'\n').encode()
+                elif line==b'--- a/old\n':
+                    line=('--- a/'+name+'\n').encode()
+                elif line==b'+++ b/new\n':
+                    line=('+++ b/'+name+'\n').encode()
+                lines.append(line)
+            data=b''.join(lines)
+            chunks.append(data)
+    patch.write_bytes(b''.join(chunks))
+    with tempfile.TemporaryDirectory(prefix='rfbt-source-rollback-') as temporary:
+        temp=Path(temporary)
+        for name,a,_ in changed:
+            if a is not None:
+                p=temp/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(a)
+        for args in (['git','apply','--check',str(patch)],['git','apply',str(patch)]):
+            subprocess.run(args,cwd=temp,env=env,check=True,capture_output=True)
+        for name,_,b in changed:
+            p=temp/name
+            assert (p.read_bytes() if p.exists() else None)==b,name
+        for args in (['git','apply','--reverse','--check',str(patch)],
+                     ['git','apply','--reverse',str(patch)]):
+            subprocess.run(args,cwd=temp,env=env,check=True,capture_output=True)
+        for name,a,_ in changed:
+            p=temp/name
+            assert (p.read_bytes() if p.exists() else None)==a,name
+    result=dict(schema=1,patch_path=patch.relative_to(ROOT).as_posix(),
+        patch_sha256=sha(patch.read_bytes()),files=len(changed),
+        forward_exact=True,reverse_exact=True,git_staging_modified=False,
+        firmware_binaries_in_patch=False,device_operations=0,
+        source_files={n:dict(before_sha256=sha(a) if a is not None else None,
+            after_sha256=sha(b) if b is not None else None) for n,a,b in changed},
+        scope='Exact source/project-document rollback; local logs and frozen firmware remain archived')
+    STEM.with_name(STEM.name+'-checkpoint.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps({k:v for k,v in result.items() if k!='source_files'}))
+
+
+if __name__=='__main__':
+    main()
