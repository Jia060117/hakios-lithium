+{
+    uint32_t crc = rfbt_crc32(wire, 112);
+    rfbt_put32(wire + 112, crc);
+    rfbt_put32(wire + 116, ~crc);
+}
+
+static uint32_t rng_state = UINT32_C(0x20f66a31);
+static uint32_t random32(void)
