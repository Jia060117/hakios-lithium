diff --git a/ports/hakios-lithium/return-fastboot/contract.h b/ports/hakios-lithium/return-fastboot/contract.h
new file mode 100644
index 0000000..ea187e3
--- /dev/null
+++ b/ports/hakios-lithium/return-fastboot/contract.h
@@ -0,0 +1,702 @@
+/*
+ * HakiOS XNU8796 -> UEFI automatic Fastboot return, software contract v1.
+ * Freestanding C99; no libc calls, allocation, I/O, clocks or reset primitive.
+ * Copyright (c) 2026. SPDX-License-Identifier: MIT
+ *
+ * Integration obligations (not established by this header):
+ * - Feed BOTH peers the complete, bounded command line, without its final NUL.
+ *   complete must be exactly 1 only when the source guarantees no truncation.
+ * - Supply a nonzero, current-boot cookie from the trusted handoff context;
+ *   do not obtain the expected cookie from the candidate record itself.
+ * - Report actual timer/storage/drain outcomes, never infer them from text,
+ *   return reason 0, a successful lookup, or a previous boot's record.
+ * - RAM_NONE means an explicitly isolated RAM run with NO mounted/writable
+ *   Data, no outstanding persistent writes, and no physical storage provider.
+ *   UNKNOWN/failed storage is never converted into this exception.
+ * - Offsets are exclusive, monotonic lithium_log_total USB console offsets,
+ *   NOT offsets into the complete retained RAM/firmware log. BOTH drains run
+ *   in XNU: primary_target is captured before the first drain; print its result,
+ *   then capture final_target and do the second drain. No further printf into
+ *   this USB stream follows the second drain. Read the real atomic delivered
+ *   counter after each drain; do not fabricate tail from target or a return code.
+ *   Each successful drain has tail >= its target; targets and tails cannot
+ *   decrease; final_target >= kernel_tail because it is captured AFTER the
+ *   first completion. ud_log_delivered is published on host bulk completion, not mere
+ *   submission. Retained RAM may continue appending msgbuf/panic independently.
+ *   UEFI has no USB drain duty and must not restart USB for this protocol.
+ * - Complete and check persistent Data sync AND device flush before UFS_SYNC_OK.
+ * - Pass the ACTUAL x2 return reason and exception syndrome captured by UEFI;
+ *   never substitute record.reason. Both eligibility and claim require the
+ *   independent RFBT_RETURN_REASON marker and ctx_esr == 0. Public panic return
+ *   (0), early exception (1), and any other context fail even with a READY wire.
+ * - Serialize access and map the same retained record on both sides. Publish
+ *   and make CLAIMED visible, using platform cache/barrier operations, BEFORE
+ *   invoking the firmware Fastboot primitive. Volatile stores below are NOT
+ *   architecture barriers. CRC/commit detect corruption, not authenticity or
+ *   arbitrary concurrent writers; decode requires a stable, readable snapshot.
+ * - A once object has a single owner. Initialize it ONCE per loader invocation,
+ *   never per poll/retry. Preserve the consumed wire record for that boot.
+ * - Distinct pointer objects passed to any mutating API must not overlap:
+ *   args/config output, record/config, wire/record or cookie output, and
+ *   wire/once/config. Overlap returns E_ARGUMENT BEFORE any write (including
+ *   latch consumption); outputs then retain their old bytes and are not valid
+ *   new results. Callers must STOP on this storage-precondition failure.
+ * - waited_ms is trusted monotonic elapsed time SINCE UEFI accepted this READY
+ *   record/context; do not include kernel time or pass wrapped clock arithmetic.
+ * - A successful claim only permits ONE firmware Fastboot request. It proves
+ *   neither actual Fastboot entry nor receipt/persistence on the host. If that
+ *   request returns, call rfbt_handoff_returned and retain the failure summary.
+ *   There is deliberately no ordinary-reboot, recovery, or retry fallback API.
+ *
+ * Wire format: 128 bytes, little endian, no native struct layout dependency.
+ *  0 magic:u64, 8 version:u32, 12 size:u32, 16 flags:u32, 20 phase:u32,
+ * 24 reason:u32, 28 storage:u32, 32 kernel_drain:u32, 36 tail_drain:u32,
+ * 40 delay_seconds:u32, 44 failure:u32, 48 boot_cookie:u64,
+ * 56 primary_target:u64, 64 final_target:u64, 72 kernel_tail:u64, 80 tail_tail:u64,
+ * 88..111 reserved zero, 112 CRC32/IEEE of bytes 0..111, 116 inverse CRC,
+ * 120 commit:u64. Exact size/version only; extensions require a new contract.
+ * Producer invalidates commit first and writes it last. Do not cast this wire
+ * buffer to struct rfbt_record, or copy a native struct across the boundary.
+ */
+#ifndef HAKIOS_RETURN_FASTBOOT_CONTRACT_H
+#define HAKIOS_RETURN_FASTBOOT_CONTRACT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define RFBT_VERSION UINT32_C(1)
+#define RFBT_WIRE_SIZE 128u
+#define RFBT_RECORD_ALIGNMENT 64u
+#define RFBT_ARGS_MAX 4096u
+#define RFBT_DEFAULT_DELAY UINT32_C(10)
+#define RFBT_MAX_DELAY UINT32_C(60)
+#define RFBT_MAGIC UINT64_C(0x3154455242464b48) /* "HKFBRET1" */
+#define RFBT_COMMIT UINT64_C(0x31444d4354424652) /* "RFBTCMD1" */
+#define RFBT_RETURN_REASON UINT64_C(0x46425331) /* Independent x2 ABI: "FBS1". */
+
+/*
+ * Use ONCE in the kernel, with a static 128-byte array aligned to 64 bytes.
+ * This header defines no storage and no second instance for a loader scan.
+ * Static INITIAL has no cookie and no commit, so is recognizable but invalid.
+ * Example declaration (GNU C): static uint8_t handoff[RFBT_WIRE_SIZE]
+ * __attribute__((aligned(RFBT_RECORD_ALIGNMENT))) = RFBT_WIRE_INITIALIZER;
+ */
+#define RFBT_WIRE_INITIALIZER { \
+    [0] = 0x48, [1] = 0x4b, [2] = 0x46, [3] = 0x42, \
+    [4] = 0x52, [5] = 0x45, [6] = 0x54, [7] = 0x31, \
+    [8] = 1, [12] = 128, [20] = 1, [40] = 10 \
+}
+
+enum rfbt_result {
+    RFBT_OK = 0,
+    RFBT_E_ARGUMENT = 1,
+    RFBT_E_ARGS_TRUNCATED = 2,
+    RFBT_E_ARGS_TOO_LONG = 3,
+    RFBT_E_TOKEN = 4,
+    RFBT_E_DUPLICATE = 5,
+    RFBT_E_VALUE = 6,
+    RFBT_E_CONFIG = 7,
+    RFBT_E_WIRE_LENGTH = 8,
+    RFBT_E_MAGIC = 9,
+    RFBT_E_VERSION = 10,
+    RFBT_E_SIZE = 11,
+    RFBT_E_COMMIT = 12,
+    RFBT_E_CHECKSUM = 13,
+    RFBT_E_RESERVED = 14,
+    RFBT_E_FLAGS = 15,
+    RFBT_E_STATE = 16,
+    RFBT_E_COOKIE = 17,
+    RFBT_E_DISABLED = 18,
+    RFBT_E_REASON = 19,
+    RFBT_E_STORAGE = 20,
+    RFBT_E_KERNEL_DRAIN = 21,
+    RFBT_E_TAIL_DRAIN = 22,
+    RFBT_E_LOG_BOUNDS = 23,
+    RFBT_E_DELAY = 24,
+    RFBT_E_CONSUMED = 25,
+    RFBT_E_HANDOFF_RETURNED = 26,
+    RFBT_E_NOT_READY = 27,
+    RFBT_E_CTX_REASON = 28,
+    RFBT_E_CTX_ESR = 29
+};
+
+#define RFBT_SEEN_SWITCH UINT32_C(1)
+#define RFBT_SEEN_DELAY UINT32_C(2)
+
+struct rfbt_config {
+    uint32_t enabled;
+    uint32_t delay_seconds;
+    uint32_t seen;
+    uint32_t error;
+};
+
+enum rfbt_phase {
+    RFBT_PHASE_INITIAL = 1,
+    RFBT_PHASE_PRIMARY_DONE = 2,
+    RFBT_PHASE_READY = 3,
+    RFBT_PHASE_CLAIMED = 4,
+    RFBT_PHASE_FAILED = 5
+};
+enum rfbt_reason {
+    RFBT_REASON_UNKNOWN = 0,
+    RFBT_REASON_NORMAL_TIMER = 1,
+    RFBT_REASON_PANIC = 2,
+    RFBT_REASON_CHECKPOINT = 3
+};
+enum rfbt_storage {
+    RFBT_STORAGE_UNKNOWN = 0,
+    RFBT_STORAGE_UFS_SYNC_OK = 1,
+    RFBT_STORAGE_RAM_NONE = 2,
+    RFBT_STORAGE_FAILED = 3
+};
+enum rfbt_drain {
+    RFBT_DRAIN_UNREPORTED = 0,
+    RFBT_DRAIN_OK = 1,
+    RFBT_DRAIN_FAILED = 2
+};
+
+#define RFBT_F_REQUESTED UINT32_C(0x001)
+#define RFBT_F_NORMAL_TIMER UINT32_C(0x002)
+#define RFBT_F_UFS_SYNC_OK UINT32_C(0x004)
+#define RFBT_F_RAM_NONE UINT32_C(0x008)
+#define RFBT_F_KERNEL_DRAIN_OK UINT32_C(0x010)
+#define RFBT_F_TAIL_DRAIN_OK UINT32_C(0x020)
+#define RFBT_F_KERNEL_SEALED UINT32_C(0x040)
+#define RFBT_F_TAIL_SEALED UINT32_C(0x080)
+#define RFBT_F_ATTEMPTED UINT32_C(0x100)
+#define RFBT_F_FAILED UINT32_C(0x200)
+#define RFBT_F_ALL UINT32_C(0x3ff)
+#define RFBT_F_CONTROL (RFBT_F_REQUESTED | RFBT_F_KERNEL_SEALED | \
+                        RFBT_F_TAIL_SEALED | RFBT_F_ATTEMPTED | RFBT_F_FAILED)
+
+/* Native working state only. Caller owns it; never used as a packed ABI. */
+struct rfbt_record {
+    uint32_t flags, phase, reason, storage;
+    uint32_t kernel_drain, tail_drain, delay_seconds, failure;
+    uint64_t boot_cookie, primary_target, final_target, kernel_tail, tail_tail;
+};
+
+/* Zero-init ONCE. summary remains available on all failures and on consumption. */
+struct rfbt_once {
+    uint32_t used;
+    uint32_t result;
+    struct rfbt_record summary;
+};
+
+/* Address differences avoid overflowing end pointers; no memory is accessed. */
+static inline int rfbt_ranges_overlap(const void *a, size_t a_size,
+                                      const void *b, size_t b_size)
+{
+    uintptr_t ap = (uintptr_t)a, bp = (uintptr_t)b;
+    if (a == NULL || b == NULL || a_size == 0 || b_size == 0) return 0;
+    return ap <= bp ? bp - ap < a_size : ap - bp < b_size;
+}
+
+static inline int rfbt_space(unsigned char c)
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n' ||
+           c == '\v' || c == '\f';
+}
+
+static inline int rfbt_bytes_equal(const char *a, size_t n,
+                                   const char *b, size_t m)
+{
+    size_t i;
+    if (n != m) return 0;
+    for (i = 0; i < n; ++i) if (a[i] != b[i]) return 0;
+    return 1;
+}
+
+static inline void rfbt_config_default(struct rfbt_config *c)
+{
+    if (c != NULL) {
+        c->enabled = 0;
+        c->delay_seconds = RFBT_DEFAULT_DELAY;
+        c->seen = 0;
+        c->error = RFBT_OK;
+    }
+}
+
+static inline uint32_t rfbt_config_error(struct rfbt_config *c, uint32_t e)
+{
+    rfbt_config_default(c);
+    if (c != NULL) c->error = e;
+    return e;
+}
+
+/*
+ * ASCII whitespace tokens; unrelated tokens are ignored. Every token beginning
+ * "return_fastboot" is reserved: misspellings, quoting, bare keys and suffixes
+ * fail closed. Embedded NUL/control/non-ASCII bytes fail anywhere in the input.
+ * Delay accepts 1..2 ASCII decimal digits, including 00..09, in range 0..60.
+ * A delay alone never enables the feature. No prefix/substring/last-wins parse.
+ */
+static inline uint32_t rfbt_parse_args(const char *args, size_t length,
+                                      int complete, struct rfbt_config *out)
+{
+    size_t i = 0;
+    uint32_t enabled = 0, delay = RFBT_DEFAULT_DELAY, seen = 0;
+    if (out == NULL) return RFBT_E_ARGUMENT;
+    if (rfbt_ranges_overlap(args, length, out, sizeof *out)) return RFBT_E_ARGUMENT;
+    rfbt_config_default(out);
+    if (complete != 1) return rfbt_config_error(out, RFBT_E_ARGS_TRUNCATED);
+    if (length > RFBT_ARGS_MAX) return rfbt_config_error(out, RFBT_E_ARGS_TOO_LONG);
+    if (args == NULL && length != 0) return rfbt_config_error(out, RFBT_E_ARGUMENT);
+    for (i = 0; i < length; ++i) {
+        unsigned char c = (unsigned char)args[i];
+        if ((c < 0x21u && !rfbt_space(c)) || c > 0x7eu)
+            return rfbt_config_error(out, RFBT_E_TOKEN);
+    }
+    i = 0;
+    while (i < length) {
+        size_t start, end, equal, j;
+        uint32_t bit, value = 0;
+        while (i < length && rfbt_space((unsigned char)args[i])) ++i;
+        start = i;
+        while (i < length && !rfbt_space((unsigned char)args[i])) ++i;
+        end = i;
+        if (start == end) continue;
+        equal = start;
+        while (equal < end && args[equal] != '=') ++equal;
+        if (rfbt_bytes_equal(args + start, equal - start, "return_fastboot", 15u))
+            bit = RFBT_SEEN_SWITCH;
+        else if (rfbt_bytes_equal(args + start, equal - start,
+                                  "return_fastboot_delay", 21u))
+            bit = RFBT_SEEN_DELAY;
+        else {
+            size_t quoted = start;
+            while (quoted < end && (args[quoted] == '\'' || args[quoted] == '"'))
+                ++quoted;
+            /* Match the WHOLE reserved stem, never an enabling substring. */
+            if (end - start >= 15u &&
+                rfbt_bytes_equal(args + start, 15u, "return_fastboot", 15u))
+                return rfbt_config_error(out, RFBT_E_TOKEN);
+            if (quoted != start && end - quoted >= 15u &&
+                rfbt_bytes_equal(args + quoted, 15u, "return_fastboot", 15u))
+                return rfbt_config_error(out, RFBT_E_TOKEN);
+            continue;
+        }
+        if ((seen & bit) != 0) return rfbt_config_error(out, RFBT_E_DUPLICATE);
+        if (equal == end) return rfbt_config_error(out, RFBT_E_VALUE);
+        j = equal + 1u;
+        if (j == end || end - j > (bit == RFBT_SEEN_SWITCH ? 1u : 2u))
+            return rfbt_config_error(out, RFBT_E_VALUE);
+        while (j < end) {
+            if (args[j] < '0' || args[j] > '9')
+                return rfbt_config_error(out, RFBT_E_VALUE);
+            value = value * 10u + (uint32_t)(args[j] - '0');
+            ++j;
+        }
+        if (value > (bit == RFBT_SEEN_SWITCH ? 1u : RFBT_MAX_DELAY))
+            return rfbt_config_error(out, RFBT_E_VALUE);
+        seen |= bit;
+        if (bit == RFBT_SEEN_SWITCH) enabled = value;
+        else delay = value;
+    }
+    out->enabled = enabled;
+    out->delay_seconds = delay;
+    out->seen = seen;
+    return RFBT_OK;
+}
+
+static inline uint32_t rfbt_config_check(const struct rfbt_config *c)
+{
+    if (c == NULL || c->error != RFBT_OK || c->enabled > 1u ||
+        c->delay_seconds > RFBT_MAX_DELAY ||
+        (c->seen & ~(RFBT_SEEN_SWITCH | RFBT_SEEN_DELAY)) != 0 ||
+        ((c->seen & RFBT_SEEN_SWITCH) == 0 && c->enabled != 0) ||
+        ((c->seen & RFBT_SEEN_DELAY) == 0 && c->delay_seconds != RFBT_DEFAULT_DELAY))
+        return RFBT_E_CONFIG;
+    return RFBT_OK;
+}
+
+static inline void rfbt_record_zero(struct rfbt_record *r)
+{
+    if (r == NULL) return;
+    r->flags = 0; r->phase = 0; r->reason = 0; r->storage = 0;
+    r->kernel_drain = 0; r->tail_drain = 0;
+    r->delay_seconds = 0; r->failure = 0;
+    r->boot_cookie = 0; r->primary_target = 0; r->final_target = 0;
+    r->kernel_tail = 0; r->tail_tail = 0;
+}
+
+static inline uint32_t rfbt_observed_flags(const struct rfbt_record *r)
+{
+    uint32_t f = r->flags & RFBT_F_CONTROL;
+    if (r->reason == RFBT_REASON_NORMAL_TIMER) f |= RFBT_F_NORMAL_TIMER;
+    if (r->storage == RFBT_STORAGE_UFS_SYNC_OK) f |= RFBT_F_UFS_SYNC_OK;
+    if (r->storage == RFBT_STORAGE_RAM_NONE) f |= RFBT_F_RAM_NONE;
+    if (r->kernel_drain == RFBT_DRAIN_OK) f |= RFBT_F_KERNEL_DRAIN_OK;
+    if (r->tail_drain == RFBT_DRAIN_OK) f |= RFBT_F_TAIL_DRAIN_OK;
+    return f;
+}
+
+static inline uint32_t rfbt_kernel_policy(const struct rfbt_record *r)
+{
+    if ((r->flags & RFBT_F_REQUESTED) == 0) return RFBT_E_DISABLED;
+    if (r->reason != RFBT_REASON_NORMAL_TIMER) return RFBT_E_REASON;
+    if (r->storage != RFBT_STORAGE_UFS_SYNC_OK && r->storage != RFBT_STORAGE_RAM_NONE)
+        return RFBT_E_STORAGE;
+    if (r->primary_target == 0) return RFBT_E_LOG_BOUNDS;
+    if (r->kernel_drain != RFBT_DRAIN_OK || r->kernel_tail < r->primary_target)
+        return RFBT_E_KERNEL_DRAIN;
+    return RFBT_OK;
+}
+
+/* Structural validation includes semantic flag/state consistency. */
+static inline uint32_t rfbt_record_check(const struct rfbt_record *r)
+{
+    uint32_t control, e;
+    if (r == NULL) return RFBT_E_ARGUMENT;
+    if ((r->flags & ~RFBT_F_ALL) != 0 || r->flags != rfbt_observed_flags(r))
+        return RFBT_E_FLAGS;
+    if (r->boot_cookie == 0) return RFBT_E_COOKIE;
+    if (r->delay_seconds > RFBT_MAX_DELAY) return RFBT_E_DELAY;
+    if (r->reason > RFBT_REASON_CHECKPOINT || r->storage > RFBT_STORAGE_FAILED ||
+        r->kernel_drain > RFBT_DRAIN_FAILED || r->tail_drain > RFBT_DRAIN_FAILED)
+        return RFBT_E_STATE;
+    control = r->flags & (RFBT_F_KERNEL_SEALED | RFBT_F_TAIL_SEALED |
+                          RFBT_F_ATTEMPTED | RFBT_F_FAILED);
+    if (r->phase == RFBT_PHASE_FAILED) {
+        if ((control & RFBT_F_FAILED) == 0 || r->failure == RFBT_OK ||
+            r->failure > RFBT_E_CTX_ESR ||
+            ((control & RFBT_F_TAIL_SEALED) != 0 &&
+             (control & RFBT_F_KERNEL_SEALED) == 0) ||
+            ((control & RFBT_F_ATTEMPTED) != 0 &&
+             (control & RFBT_F_TAIL_SEALED) == 0)) return RFBT_E_STATE;
+        return RFBT_OK; /* Retain raw failed tails/statuses; never eligible. */
+    }
+    if (r->failure != RFBT_OK) return RFBT_E_STATE;
+    if (r->phase == RFBT_PHASE_INITIAL) {
+        if (control != 0 || r->reason != RFBT_REASON_UNKNOWN ||
+            r->storage != RFBT_STORAGE_UNKNOWN ||
+            r->kernel_drain != RFBT_DRAIN_UNREPORTED ||
+            r->tail_drain != RFBT_DRAIN_UNREPORTED ||
+            r->primary_target != 0 || r->final_target != 0 ||
+            r->kernel_tail != 0 || r->tail_tail != 0)
+            return RFBT_E_STATE;
+        return RFBT_OK;
+    }
+    if (r->phase == RFBT_PHASE_PRIMARY_DONE) {
+        if (control != RFBT_F_KERNEL_SEALED ||
+            r->tail_drain != RFBT_DRAIN_UNREPORTED || r->tail_tail != 0 ||
+            r->final_target != 0)
+            return RFBT_E_STATE;
+    } else if (r->phase == RFBT_PHASE_READY || r->phase == RFBT_PHASE_CLAIMED) {
+        uint32_t expected = RFBT_F_KERNEL_SEALED | RFBT_F_TAIL_SEALED;
+        if (r->phase == RFBT_PHASE_CLAIMED) expected |= RFBT_F_ATTEMPTED;
+        if (control != expected) return RFBT_E_STATE;
+        if (r->final_target < r->primary_target ||
+            r->final_target < r->kernel_tail) return RFBT_E_LOG_BOUNDS;
+        if (r->tail_drain != RFBT_DRAIN_OK || r->tail_tail < r->final_target ||
+            r->tail_tail < r->kernel_tail) return RFBT_E_TAIL_DRAIN;
+    } else return RFBT_E_STATE;
+    e = rfbt_kernel_policy(r);
+    return e;
+}
+
+static inline void rfbt_fail(struct rfbt_record *r, uint32_t error)
+{
+    r->phase = RFBT_PHASE_FAILED;
+    r->failure = error;
+    r->flags |= RFBT_F_FAILED;
+    r->flags = rfbt_observed_flags(r);
+}
+
+static inline uint32_t rfbt_record_init(struct rfbt_record *r,
+                                       const struct rfbt_config *c,
+                                       uint64_t boot_cookie)
+{
+    uint32_t e;
+    if (r == NULL) return RFBT_E_ARGUMENT;
+    if (rfbt_ranges_overlap(r, sizeof *r, c, sizeof *c)) return RFBT_E_ARGUMENT;
+    rfbt_record_zero(r);
+    e = rfbt_config_check(c);
+    if (e != RFBT_OK) return e;
+    if (boot_cookie == 0) return RFBT_E_COOKIE;
+    r->flags = c->enabled != 0 ? RFBT_F_REQUESTED : 0;
+    r->phase = RFBT_PHASE_INITIAL;
+    r->delay_seconds = c->delay_seconds;
+    r->boot_cookie = boot_cookie;
+    return RFBT_OK;
+}
+
+/* XNU first drain: INITIAL -> PRIMARY_DONE or FAILED. */
+static inline uint32_t rfbt_kernel_finish(struct rfbt_record *r,
+                                         uint32_t reason, uint32_t storage,
+                                         uint64_t target, uint32_t drain,
+                                         uint64_t tail)
+{
+    uint32_t e = rfbt_record_check(r);
+    if (e != RFBT_OK) return e;
+    if (r->phase != RFBT_PHASE_INITIAL) return RFBT_E_CONSUMED;
+    r->reason = reason <= RFBT_REASON_CHECKPOINT ? reason : RFBT_REASON_UNKNOWN;
+    r->storage = storage <= RFBT_STORAGE_FAILED ? storage : RFBT_STORAGE_UNKNOWN;
+    r->kernel_drain = drain <= RFBT_DRAIN_FAILED ? drain : RFBT_DRAIN_UNREPORTED;
+    r->primary_target = target;
+    r->kernel_tail = tail;
+    r->phase = RFBT_PHASE_PRIMARY_DONE;
+    r->flags |= RFBT_F_KERNEL_SEALED;
+    r->flags = rfbt_observed_flags(r);
+    if (reason > RFBT_REASON_CHECKPOINT || storage > RFBT_STORAGE_FAILED ||
+        drain > RFBT_DRAIN_FAILED) e = RFBT_E_STATE;
+    else e = rfbt_kernel_policy(r);
+    if (e != RFBT_OK) rfbt_fail(r, e);
+    return e;
+}
+
+/* XNU second drain: PRIMARY_DONE -> READY or FAILED. No USB printf after it. */
+static inline uint32_t rfbt_tail_finish(struct rfbt_record *r,
+                                       uint64_t final_target,
+                                       uint32_t drain, uint64_t tail)
+{
+    uint32_t e = rfbt_record_check(r);
+    if (e != RFBT_OK) return e;
+    if (r->phase != RFBT_PHASE_PRIMARY_DONE) return RFBT_E_CONSUMED;
+    r->tail_drain = drain <= RFBT_DRAIN_FAILED ? drain : RFBT_DRAIN_UNREPORTED;
+    r->final_target = final_target;
+    r->tail_tail = tail;
+    r->phase = RFBT_PHASE_READY;
+    r->flags |= RFBT_F_TAIL_SEALED;
+    r->flags = rfbt_observed_flags(r);
+    if (drain > RFBT_DRAIN_FAILED) e = RFBT_E_STATE;
+    else if (final_target < r->primary_target || final_target < r->kernel_tail)
+        e = RFBT_E_LOG_BOUNDS;
+    else if (drain != RFBT_DRAIN_OK || tail < final_target || tail < r->kernel_tail)
+        e = RFBT_E_TAIL_DRAIN;
+    if (e != RFBT_OK) rfbt_fail(r, e);
+    return e;
+}
+
+static inline uint32_t rfbt_get32(const volatile uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static inline uint64_t rfbt_get64(const volatile uint8_t *p)
+{
+    return (uint64_t)rfbt_get32(p) | ((uint64_t)rfbt_get32(p + 4) << 32);
+}
+static inline void rfbt_put32(volatile uint8_t *p, uint32_t v)
+{
+    unsigned int i;
+    for (i = 0; i < 4u; ++i) p[i] = (uint8_t)(v >> (i * 8u));
+}
+static inline void rfbt_put64(volatile uint8_t *p, uint64_t v)
+{
+    rfbt_put32(p, (uint32_t)v);
+    rfbt_put32(p + 4, (uint32_t)(v >> 32));
+}
+static inline uint32_t rfbt_crc32(const volatile uint8_t *p, size_t n)
+{
+    uint32_t crc = UINT32_C(0xffffffff);
+    size_t i;
+    unsigned int b;
+    for (i = 0; i < n; ++i) {
+        crc ^= p[i];
+        for (b = 0; b < 8u; ++b)
+            crc = (crc >> 1) ^ (UINT32_C(0xedb88320) & (0u - (crc & 1u)));
+    }
+    return ~crc;
+}
+
+/* Private template check: static INITIAL is deliberately NOT a committed wire. */
+static inline uint32_t rfbt_initial_check(const void *wire, size_t length, int seeded)
+{
+    const volatile uint8_t *p = (const volatile uint8_t *)wire;
+    size_t i;
+    if (wire == NULL) return RFBT_E_ARGUMENT;
+    if (length != RFBT_WIRE_SIZE) return RFBT_E_WIRE_LENGTH;
+    if (rfbt_get64(p) != RFBT_MAGIC) return RFBT_E_MAGIC;
+    if (rfbt_get32(p + 8) != RFBT_VERSION) return RFBT_E_VERSION;
+    if (rfbt_get32(p + 12) != RFBT_WIRE_SIZE) return RFBT_E_SIZE;
+    for (i = 16; i < RFBT_WIRE_SIZE; ++i) {
+        uint8_t expected = 0;
+        if (i >= 48u && i < 56u) continue;
+        if (i == 20u) expected = RFBT_PHASE_INITIAL;
+        if (i == 40u) expected = RFBT_DEFAULT_DELAY;
+        if (p[i] != expected) return RFBT_E_STATE;
+    }
+    if ((rfbt_get64(p + 48) != 0) != (seeded != 0)) return RFBT_E_COOKIE;
+    return RFBT_OK;
+}
+
+/* Loader pre-handoff: seed the unique static template ONCE; retain cookie out of band. */
+static inline uint32_t rfbt_seed_initial(void *wire, size_t length, uint64_t cookie)
+{
+    uint32_t e;
+    if (cookie == 0) return RFBT_E_COOKIE;
+    e = rfbt_initial_check(wire, length, 0);
+    if (e != RFBT_OK) return e;
+    rfbt_put64((volatile uint8_t *)wire + 48, cookie);
+    return RFBT_OK;
+}
+
+/* XNU reads the cookie from that same uncommitted template, before record_init. */
+static inline uint32_t rfbt_initial_cookie(const void *wire, size_t length,
+                                          uint64_t *cookie_out)
+{
+    uint32_t e;
+    if (cookie_out == NULL) return RFBT_E_ARGUMENT;
+    if (rfbt_ranges_overlap(wire, length, cookie_out, sizeof *cookie_out))
+        return RFBT_E_ARGUMENT;
+    *cookie_out = 0;
+    e = rfbt_initial_check(wire, length, 1);
+    if (e != RFBT_OK) return e;
+    *cookie_out = rfbt_get64((const volatile uint8_t *)wire + 48);
+    return RFBT_OK;
+}
+
+/* Overlap is rejected unchanged; other invalid encoding invalidates a full buffer. */
+static inline uint32_t rfbt_encode(const struct rfbt_record *r,
+                                  void *wire, size_t length)
+{
+    volatile uint8_t *p = (volatile uint8_t *)wire;
+    uint32_t e, crc;
+    size_t i;
+    if (wire == NULL) return RFBT_E_ARGUMENT;
+    if (rfbt_ranges_overlap(r, sizeof *r, wire, length)) return RFBT_E_ARGUMENT;
+    if (length >= RFBT_WIRE_SIZE) rfbt_put64(p + 120, 0);
+    if (length != RFBT_WIRE_SIZE) return RFBT_E_WIRE_LENGTH;
+    e = rfbt_record_check(r);
+    if (e != RFBT_OK) return e;
+    rfbt_put64(p, RFBT_MAGIC);
+    rfbt_put32(p + 8, RFBT_VERSION);
+    rfbt_put32(p + 12, RFBT_WIRE_SIZE);
+    rfbt_put32(p + 16, r->flags); rfbt_put32(p + 20, r->phase);
+    rfbt_put32(p + 24, r->reason); rfbt_put32(p + 28, r->storage);
+    rfbt_put32(p + 32, r->kernel_drain); rfbt_put32(p + 36, r->tail_drain);
+    rfbt_put32(p + 40, r->delay_seconds); rfbt_put32(p + 44, r->failure);
+    rfbt_put64(p + 48, r->boot_cookie); rfbt_put64(p + 56, r->primary_target);
+    rfbt_put64(p + 64, r->final_target); rfbt_put64(p + 72, r->kernel_tail);
+    rfbt_put64(p + 80, r->tail_tail);
+    for (i = 88; i < 112; ++i) p[i] = 0;
+    crc = rfbt_crc32(p, 112);
+    rfbt_put32(p + 112, crc); rfbt_put32(p + 116, ~crc);
+    rfbt_put64(p + 120, RFBT_COMMIT);
+    return RFBT_OK;
+}
+
+/* Reject overlap unchanged. On any failure out is NOT a valid new candidate. */
+static inline uint32_t rfbt_decode(const void *wire, size_t length,
+                                  struct rfbt_record *out)
+{
+    const volatile uint8_t *p = (const volatile uint8_t *)wire;
+    uint32_t crc;
+    size_t i;
+    if (out == NULL) return RFBT_E_ARGUMENT;
+    if (rfbt_ranges_overlap(wire, length, out, sizeof *out)) return RFBT_E_ARGUMENT;
+    rfbt_record_zero(out);
+    if (wire == NULL) return RFBT_E_ARGUMENT;
+    if (length != RFBT_WIRE_SIZE) return RFBT_E_WIRE_LENGTH;
+    if (rfbt_get64(p) != RFBT_MAGIC) return RFBT_E_MAGIC;
+    if (rfbt_get32(p + 8) != RFBT_VERSION) return RFBT_E_VERSION;
+    if (rfbt_get32(p + 12) != RFBT_WIRE_SIZE) return RFBT_E_SIZE;
+    if (rfbt_get64(p + 120) != RFBT_COMMIT) return RFBT_E_COMMIT;
+    crc = rfbt_get32(p + 112);
+    if (rfbt_get32(p + 116) != ~crc || rfbt_crc32(p, 112) != crc)
+        return RFBT_E_CHECKSUM;
+    for (i = 88; i < 112; ++i) if (p[i] != 0) return RFBT_E_RESERVED;
+    out->flags = rfbt_get32(p + 16); out->phase = rfbt_get32(p + 20);
+    out->reason = rfbt_get32(p + 24); out->storage = rfbt_get32(p + 28);
+    out->kernel_drain = rfbt_get32(p + 32); out->tail_drain = rfbt_get32(p + 36);
+    out->delay_seconds = rfbt_get32(p + 40); out->failure = rfbt_get32(p + 44);
+    out->boot_cookie = rfbt_get64(p + 48); out->primary_target = rfbt_get64(p + 56);
+    out->final_target = rfbt_get64(p + 64); out->kernel_tail = rfbt_get64(p + 72);
+    out->tail_tail = rfbt_get64(p + 80);
+    return rfbt_record_check(out);
+}
+
+/* Read-only eligibility; this never grants permission to invoke firmware. */
+static inline uint32_t rfbt_eligible(const struct rfbt_record *r,
+                                    const struct rfbt_config *c,
+                                    uint64_t expected_cookie,
+                                    uint64_t ctx_reason, uint64_t ctx_esr)
+{
+    uint32_t e = rfbt_config_check(c);
+    if (e != RFBT_OK) return e;
+    if (c->enabled == 0) return RFBT_E_DISABLED;
+    if (ctx_reason != RFBT_RETURN_REASON) return RFBT_E_CTX_REASON;
+    if (ctx_esr != 0) return RFBT_E_CTX_ESR;
+    e = rfbt_record_check(r);
+    if (e != RFBT_OK) return e;
+    if (expected_cookie == 0 || r->boot_cookie != expected_cookie) return RFBT_E_COOKIE;
+    if (r->delay_seconds != c->delay_seconds) return RFBT_E_CONFIG;
+    if (r->phase == RFBT_PHASE_CLAIMED || r->phase == RFBT_PHASE_FAILED)
+        return RFBT_E_CONSUMED;
+    if (r->phase != RFBT_PHASE_READY) return RFBT_E_NOT_READY;
+    return RFBT_OK;
+}
+
+static inline void rfbt_once_init(struct rfbt_once *once)
+{
+    if (once == NULL) return;
+    once->used = 0;
+    once->result = RFBT_E_NOT_READY;
+    rfbt_record_zero(&once->summary);
+}
+
+/*
+ * Sole authorization API. With disjoint wire/once/config storage, every
+ * invocation consumes the latch, even malformed input or insufficient delay.
+ * Overlap is rejected without changing any bytes, including the latch.
+ * On success wire is CLAIMED, not READY. A new latch cannot reuse that wire.
+ * Any error means retain evidence and STOP.
+ */
+static inline uint32_t rfbt_loader_claim(struct rfbt_once *once,
+                                        void *wire, size_t length,
+                                        const struct rfbt_config *c,
+                                        uint64_t expected_cookie,
+                                        uint64_t ctx_reason, uint64_t ctx_esr,
+                                        uint64_t waited_ms)
+{
+    uint32_t e, write_error;
+    if (once == NULL) return RFBT_E_ARGUMENT;
+    if (rfbt_ranges_overlap(once, sizeof *once, wire, length) ||
+        rfbt_ranges_overlap(once, sizeof *once, c, sizeof *c) ||
+        rfbt_ranges_overlap(wire, length, c, sizeof *c)) return RFBT_E_ARGUMENT;
+    if (once->used != 0) return RFBT_E_CONSUMED;
+    once->used = 1;
+    once->result = RFBT_E_NOT_READY;
+    e = rfbt_decode(wire, length, &once->summary);
+    if (e != RFBT_OK) {
+        once->result = e;
+        return e; /* Do not overwrite malformed/unknown-version evidence. */
+    }
+    e = rfbt_eligible(&once->summary, c, expected_cookie, ctx_reason, ctx_esr);
+    if (e == RFBT_OK && waited_ms < (uint64_t)once->summary.delay_seconds * 1000u)
+        e = RFBT_E_DELAY;
+    if (e != RFBT_OK) {
+        /* Already-terminal evidence must remain byte-for-byte intact. */
+        if (once->summary.phase != RFBT_PHASE_CLAIMED &&
+            once->summary.phase != RFBT_PHASE_FAILED) {
+            rfbt_fail(&once->summary, e);
+            write_error = rfbt_encode(&once->summary, wire, length);
+            if (write_error != RFBT_OK) e = write_error;
+        }
+        once->result = e;
+        return e;
+    }
+    once->summary.phase = RFBT_PHASE_CLAIMED;
+    once->summary.flags |= RFBT_F_ATTEMPTED;
+    e = rfbt_encode(&once->summary, wire, length);
+    once->result = e;
+    return e;
+}
+
+/* A returned firmware call is a failure regardless of its numeric return code. */
+static inline uint32_t rfbt_handoff_returned(struct rfbt_once *once,
+                                            void *wire, size_t length)
+{
+    uint32_t e;
+    if (once == NULL) return RFBT_E_ARGUMENT;
+    if (rfbt_ranges_overlap(once, sizeof *once, wire, length)) return RFBT_E_ARGUMENT;
+    if (once->used != 1 || once->result != RFBT_OK ||
+        once->summary.phase != RFBT_PHASE_CLAIMED) return RFBT_E_CONSUMED;
+    once->result = RFBT_E_HANDOFF_RETURNED;
+    rfbt_fail(&once->summary, RFBT_E_HANDOFF_RETURNED);
+    e = rfbt_encode(&once->summary, wire, length);
+    return e == RFBT_OK ? (uint32_t)RFBT_E_HANDOFF_RETURNED : e;
+}
+
+#endif /* HAKIOS_RETURN_FASTBOOT_CONTRACT_H */
diff --git a/ports/hakios-lithium/return-fastboot/firmware-protocol.h b/ports/hakios-lithium/return-fastboot/firmware-protocol.h
new file mode 100644
index 0000000..8199d52
--- /dev/null
+++ b/ports/hakios-lithium/return-fastboot/firmware-protocol.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: MIT
+ * Lithium UEFI Fastboot-return protocol, version 1.
+ * The loader must locate this protocol; never fall back to ResetSystem when it
+ * is absent. Old firmware ignores ResetData and would perform a normal reset.
+ * Supply LFB_UINT32/LFB_UINT64/LFB_STATUS/LFB_EFIAPI before including this file.
+ */
+#ifndef LITHIUM_RETURN_FASTBOOT_FIRMWARE_PROTOCOL_H
+#define LITHIUM_RETURN_FASTBOOT_FIRMWARE_PROTOCOL_H
+
+#define LFB_PROTOCOL_GUID_VALUES \
+    0x9fef394d, 0x21f1, 0x4bd4, {0xb9,0xc4,0x60,0xf0,0x82,0x53,0xea,0x61}
+#define LFB_PROTOCOL_REVISION 0x00010000u
+#define LFB_RESULT_SIZE 64u
+#define LFB_BACKEND_NONE 0u
+#define LFB_BACKEND_LITHIUM 1u
+#define LFB_STATE_IDLE 0u
+#define LFB_STATE_PREPARED 1u
+#define LFB_STATE_CONSUMED 2u
+#define LFB_STATE_FAILED 3u
+#define LFB_FLAG_IMEM_VERIFIED 1u
+#define LFB_FLAG_PMIC_VERIFIED 2u
+#define LFB_PROFILE_UNSPECIFIED 0u
+#define LFB_PROFILE_RAM_ISOLATED 1u
+#define LFB_PROFILE_UFS 2u
+#define LFB_CAP_NO_PHYSICAL_UFS 1u
+
+struct lithium_fastboot_result {
+    LFB_UINT32 revision;
+    LFB_UINT32 size;
+    LFB_UINT32 state;
+    LFB_UINT32 backend;
+    LFB_UINT32 flags;
+    LFB_UINT32 imem_before;
+    LFB_UINT32 imem_after;
+    LFB_UINT32 pmic_before;
+    LFB_UINT32 pmic_after;
+    LFB_UINT32 reserved;
+    LFB_UINT64 ticket;
+    LFB_UINT64 detail;
+    LFB_UINT64 affinity;
+};
+
+struct lithium_fastboot_protocol;
+typedef LFB_STATUS (LFB_EFIAPI *lithium_fastboot_prepare_fn)(
+    struct lithium_fastboot_protocol *, struct lithium_fastboot_result *);
+typedef LFB_STATUS (LFB_EFIAPI *lithium_fastboot_commit_fn)(
+    struct lithium_fastboot_protocol *, LFB_UINT64 ticket);
+
+struct lithium_fastboot_protocol {
+    LFB_UINT64 revision;
+    LFB_UINT64 size;
+    LFB_UINT32 profile;
+    LFB_UINT32 capabilities;
+    lithium_fastboot_prepare_fn prepare;
+    lithium_fastboot_commit_fn commit;
+};
+
+/* PREPARE may only be called after a verified normal kernel return. It stages
+ * a board-supported bootloader request and reports actual readback. COMMIT is
+ * a one-shot terminal request. Any returned status retains the failure screen;
+ * the caller must not retry, use generic reboot, or launch another image.
+ * Protocol presence/version establishes software compatibility, not successful
+ * hardware operation. All physical results require a separate device test.
+ */
+#endif
diff --git a/ports/hakios-lithium/return-fastboot/init.inc b/ports/hakios-lithium/return-fastboot/init.inc
new file mode 100644
index 0000000..367ab91
--- /dev/null
+++ b/ports/hakios-lithium/return-fastboot/init.inc
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: MIT
+ * Independent RAM-only software lifecycle test. No touch/peripheral options,
+ * mount, storage access, reboot syscall, local countdown or replacement PID1.
+ */
+#include "profile.h"
+
+static int
+lithium_fastboot_test_hold(void)
+{
+    const char *hint = boot_arg("fastboot_return_test");
+    char args[1024];
+    size_t bytes = sizeof(args);
+    struct rfbt_config config;
+    unsigned matches = 0, accepted = 0, exact_zero = 0, exact_one = 0, probes = 0;
+    /* The old helper is only a fallback hint when the complete snapshot fails.
+     * Its first-value/space-only parser cannot authorize normal routing. */
+    if (sysctlbyname("kern.bootargs", args, &bytes, NULL, 0) != 0 ||
+        !bytes || bytes >= sizeof(args) || args[bytes - 1] != 0) {
+        if (!hint) return 0;
+    } else {
+        size_t pos = 0;
+        while (pos + 1 < bytes) {
+            while (pos + 1 < bytes && rfbt_space((unsigned char)args[pos])) ++pos;
+            size_t begin = pos;
+            while (pos + 1 < bytes && !rfbt_space((unsigned char)args[pos])) ++pos;
+            size_t n = pos - begin, key = 0;
+            while (key < n && args[begin + key] != '=') ++key;
+            if (rfbt_bytes_equal(args + begin, key, "fastboot_return_test", 20)) {
+                ++matches;
+                exact_zero += rfbt_bytes_equal(args + begin, n, "fastboot_return_test=0", 22);
+                exact_one += rfbt_bytes_equal(args + begin, n, "fastboot_return_test=1", 22);
+            }
+            if ((key >= 5 && rfbt_bytes_equal(args + begin, 5, "touch", 5)) ||
+                (key >= 3 && rfbt_bytes_equal(args + begin, 3, "gpu", 3))) probes = 1;
+        }
+        if (!matches && !hint) return 0;
+        if (matches == 1 && exact_zero == 1) return 0;
+        accepted = matches == 1 && exact_one == 1 && !probes &&
+            rfbt_parse_args(args, bytes - 1, 1, &config) == RFBT_OK &&
+            config.enabled && rfbt_ram_profile(args, bytes - 1, 1);
+    }
+    printf("LITHIUM FASTBOOT session=software_test accepted=%u pid=%d no_storage=1 no_touch=1\n",
+        accepted, getpid());
+    for (;;) (void)usleep(1000000);
+}
diff --git a/ports/hakios-lithium/return-fastboot/kernel.inc b/ports/hakios-lithium/return-fastboot/kernel.inc
new file mode 100644
index 0000000..9e7bfc3
--- /dev/null
+++ b/ports/hakios-lithium/return-fastboot/kernel.inc
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: MIT
+ * Optional normal-timer handoff. The complete HakiOS return path remains the
+ * owner of driver shutdown and the final branch. New state is static/small.
+ */
+#include <pexpert/arm64/boot.h>
+#include "profile.h"
+
+static uint8_t lithium_fastboot_wire[RFBT_WIRE_SIZE]
+    __attribute__((used, aligned(RFBT_RECORD_ALIGNMENT))) = RFBT_WIRE_INITIALIZER;
+static struct rfbt_config lithium_fastboot_config;
+static struct rfbt_record lithium_fastboot_record;
+static bool lithium_fastboot_pending;
+static uint64_t lithium_fastboot_usb_session;
+
+extern bool lithium_return_fastboot_ram_storage_clean(void);
+extern uint64_t lithium_usb_log_delivered(void);
+extern uint64_t lithium_usb_log_session(void);
+extern uint64_t lithium_usb_log_lost_total(void);
+
+static bool
+lithium_fastboot_single_cpu(void)
+{
+    return ml_get_max_cpu_number() == 0 &&
+        (__builtin_arm_rsr64("MPIDR_EL1") & 0xff00ffffffULL) == 1;
+}
+
+static void
+lithium_fastboot_timer_prepare(void)
+{
+    const char *args = PE_boot_args();
+    size_t length = args ? strnlen(args, BOOT_LINE_LENGTH) : 0;
+    uint64_t cookie = 0;
+    uint32_t error = rfbt_parse_args(args, length,
+        args != NULL && length < BOOT_LINE_LENGTH, &lithium_fastboot_config);
+    if (error != RFBT_OK || !lithium_fastboot_config.enabled) return;
+    error = rfbt_initial_cookie(lithium_fastboot_wire, RFBT_WIRE_SIZE, &cookie);
+    if (error != RFBT_OK || !lithium_fastboot_single_cpu() ||
+        !rfbt_ram_profile(args, length, 1) ||
+        !lithium_return_fastboot_ram_storage_clean()) {
+        printf("LITHIUM FASTBOOT status=blocked phase=prepare contract=%u ram_profile=%u\n",
+            error, rfbt_ram_profile(args, length, 1));
+        return;
+    }
+    error = rfbt_record_init(&lithium_fastboot_record, &lithium_fastboot_config, cookie);
+    if (error != RFBT_OK) return;
+    lithium_fastboot_pending = true;
+    lithium_fastboot_usb_session = lithium_usb_log_session();
+    printf("LITHIUM FASTBOOT status=armed mode=isolated_ram delay_seconds=%u firmware_result=unverified\n",
+        lithium_fastboot_config.delay_seconds);
+}
+
+static void
+lithium_fastboot_primary(uint64_t target, bool drained)
+{
+    if (!lithium_fastboot_pending) return;
+    drained = drained && lithium_fastboot_usb_session != 0 &&
+        lithium_fastboot_usb_session == lithium_usb_log_session() &&
+        lithium_usb_log_lost_total() == 0;
+    (void)rfbt_kernel_finish(&lithium_fastboot_record, RFBT_REASON_NORMAL_TIMER,
+        RFBT_STORAGE_RAM_NONE, target,
+        drained ? RFBT_DRAIN_OK : RFBT_DRAIN_FAILED, lithium_usb_log_delivered());
+}
+
+static void
+lithium_fastboot_tail(uint64_t target, bool drained)
+{
+    if (!lithium_fastboot_pending) return;
+    drained = drained && lithium_fastboot_usb_session != 0 &&
+        lithium_fastboot_usb_session == lithium_usb_log_session() &&
+        lithium_usb_log_lost_total() == 0;
+    (void)rfbt_tail_finish(&lithium_fastboot_record, target,
+        drained ? RFBT_DRAIN_OK : RFBT_DRAIN_FAILED, lithium_usb_log_delivered());
+    /* No printf after the final streaming drain. Later retained msgbuf/panic
+     * capture is independent and is not falsely counted as USB-delivered. */
+}
+
+static uint64_t
+lithium_fastboot_return_reason(bool normal_timer)
+{
+    if (!normal_timer || !lithium_fastboot_pending || panic_active() ||
+        !lithium_fastboot_single_cpu() ||
+        !lithium_fastboot_usb_session ||
+        lithium_fastboot_usb_session != lithium_usb_log_session() ||
+        lithium_usb_log_lost_total() != 0 ||
+        __atomic_load_n(&lithium_log_contention_dropped_bytes, __ATOMIC_RELAXED) != 0 ||
+        !lithium_return_fastboot_ram_storage_clean() ||
+        rfbt_eligible(&lithium_fastboot_record, &lithium_fastboot_config,
+            lithium_fastboot_record.boot_cookie, RFBT_RETURN_REASON, 0) != RFBT_OK)
+        return 0;
+    if (rfbt_encode(&lithium_fastboot_record, lithium_fastboot_wire,
+        RFBT_WIRE_SIZE) != RFBT_OK) return 0;
+    for (uintptr_t p = (uintptr_t)lithium_fastboot_wire;
+         p < (uintptr_t)lithium_fastboot_wire + RFBT_WIRE_SIZE; p += 64)
+        __asm__ volatile ("dc cvac, %0" : : "r"(p) : "memory");
+    __asm__ volatile ("dsb sy" : : : "memory");
+    return RFBT_RETURN_REASON;
+}
diff --git a/ports/hakios-lithium/return-fastboot/loader.inc b/ports/hakios-lithium/return-fastboot/loader.inc
new file mode 100644
index 0000000..7c79cda
--- /dev/null
+++ b/ports/hakios-lithium/return-fastboot/loader.inc
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: MIT
+ * Included by the complete HakiOS loader after its firmware/cache helpers.
+ * No device I/O without the explicit option and a valid returned kernel proof.
+ */
+#include "profile.h"
+#define LFB_UINT32 uint32_t
+#define LFB_UINT64 uint64_t
+#define LFB_STATUS efi_status
+#define LFB_EFIAPI EFIAPI
+#include "firmware-protocol.h"
+#undef LFB_UINT32
+#undef LFB_UINT64
+#undef LFB_STATUS
+#undef LFB_EFIAPI
+
+static struct rfbt_config lithium_fastboot_requested;
+static struct rfbt_once lithium_fastboot_once;
+static uint8_t *lithium_fastboot_handoff;
+static uint64_t lithium_fastboot_cookie;
+static struct lithium_fastboot_protocol *lithium_fastboot_firmware;
+
+static void
+lithium_fastboot_seed(const char *args, uint32_t bytes, unsigned copies,
+    uint64_t low, uint64_t high, uint64_t checkpoint)
+{
+    static const efi_guid guid = { LFB_PROTOCOL_GUID_VALUES };
+    uint8_t *candidate = NULL;
+    unsigned matches = 0;
+    lithium_fastboot_handoff = NULL;
+    lithium_fastboot_firmware = NULL;
+    lithium_fastboot_cookie = 0;
+    rfbt_config_default(&lithium_fastboot_requested);
+    if (!args || !bytes || bytes > RFBT_ARGS_MAX || copies != 1 || args[bytes - 1] != 0)
+        return;
+    if (rfbt_parse_args(args, bytes - 1, 1, &lithium_fastboot_requested) != RFBT_OK ||
+        !lithium_fastboot_requested.enabled) return;
+    if (lithium_fastboot_once.used || checkpoint || !rfbt_ram_profile(args, bytes - 1, 0) ||
+        block_enabled || block_write_requested || hc_requested || high <= low ||
+        high - low < RFBT_WIRE_SIZE) {
+        print("LITHIUM FASTBOOT status=blocked phase=seed reason=profile_or_consumed\n");
+        return;
+    }
+    efi_status status = BS->locate_protocol(&guid, NULL, (void **)&lithium_fastboot_firmware);
+    struct lithium_fastboot_protocol *f = lithium_fastboot_firmware;
+    if (EFI_ERROR(status) || !f || f->revision != LFB_PROTOCOL_REVISION ||
+        f->size != sizeof(*f) || f->profile != LFB_PROFILE_RAM_ISOLATED ||
+        f->capabilities != LFB_CAP_NO_PHYSICAL_UFS || !f->prepare || !f->commit) {
+        lithium_fastboot_firmware = NULL;
+        print("LITHIUM FASTBOOT status=blocked phase=seed reason=firmware_protocol\n");
+        return;
+    }
+    /* Scan only aligned, complete INITIAL candidates. Multiple candidates are
+     * rejected; an instruction literal or a stale encoded record is not one. */
+    for (uint64_t p = (low + RFBT_RECORD_ALIGNMENT - 1) &
+            ~((uint64_t)RFBT_RECORD_ALIGNMENT - 1);
+         p <= high - RFBT_WIRE_SIZE; p += RFBT_RECORD_ALIGNMENT) {
+        if (*(const uint64_t *)(uintptr_t)p == RFBT_MAGIC &&
+            rfbt_initial_check((const void *)(uintptr_t)p, RFBT_WIRE_SIZE, 0) == RFBT_OK) {
+            candidate = (uint8_t *)(uintptr_t)p;
+            if (++matches > 1) break;
+        }
+    }
+    if (matches != 1) {
+        print("LITHIUM FASTBOOT status=blocked phase=seed candidates=%d\n", (uint64_t)matches);
+        return;
+    }
+    uint64_t cookie = READ_SYSREG(CNTVCT_EL0) ^ (uint64_t)(uintptr_t)candidate ^ RFBT_MAGIC;
+    if (!cookie) cookie = 1; /* Per-invocation discriminator, not a security secret. */
+    if (rfbt_seed_initial(candidate, RFBT_WIRE_SIZE, cookie) != RFBT_OK) return;
+    clean_dcache((uint64_t)(uintptr_t)candidate,
+        (uint64_t)(uintptr_t)candidate + RFBT_WIRE_SIZE);
+    lithium_fastboot_handoff = candidate;
+    lithium_fastboot_cookie = cookie;
+    print("LITHIUM FASTBOOT status=seeded mode=isolated_ram delay_seconds=%d\n",
+        (uint64_t)lithium_fastboot_requested.delay_seconds);
+}
+
+static void
+lithium_fastboot_after_return(uint64_t reason, uint64_t syndrome)
+{
+    struct rfbt_record result;
+    struct lithium_fastboot_result hardware = {0};
+    uint8_t *wire = lithium_fastboot_handoff;
+    if (!lithium_fastboot_requested.enabled || !wire || !lithium_fastboot_firmware) return;
+    /* XNU cleaned its final record before branching; invalidate the loader's
+     * view after the independent returned-core/context handshake. */
+    flush_dcache((uint64_t)(uintptr_t)wire, (uint64_t)(uintptr_t)wire + RFBT_WIRE_SIZE);
+    uint32_t error = rfbt_decode(wire, RFBT_WIRE_SIZE, &result);
+    if (error == RFBT_OK) error = rfbt_eligible(&result, &lithium_fastboot_requested,
+        lithium_fastboot_cookie, reason, syndrome);
+    if (error != RFBT_OK) {
+        print("LITHIUM FASTBOOT status=retained reason=kernel_proof error=%d ctx=%x\n",
+            (uint64_t)error, reason);
+        return;
+    }
+    uint64_t freq = READ_SYSREG(CNTFRQ_EL0), start = READ_SYSREG(CNTVCT_EL0), now = start;
+    if (!freq || freq > 0xffffffffULL) {
+        print("LITHIUM FASTBOOT status=retained reason=timer_frequency\n");
+        return;
+    }
+    uint64_t ticks = (uint64_t)result.delay_seconds * freq;
+    unsigned polls = 0, limit = result.delay_seconds * 20u + 20u;
+    print("LITHIUM FASTBOOT status=countdown seconds=%d primary_target=%d primary_tail=%d\n",
+        (uint64_t)result.delay_seconds, result.primary_target, result.kernel_tail);
+    print("LITHIUM FASTBOOT final_target=%d final_tail=%d host_persistence=unverified\n",
+        result.final_target, result.tail_tail);
+    while (now >= start && now - start < ticks && polls++ < limit) {
+        BS->stall(100000);
+        wdt_pet();
+        now = READ_SYSREG(CNTVCT_EL0);
+    }
+    if (now < start || now - start < ticks) {
+        print("LITHIUM FASTBOOT status=retained reason=countdown_clock\n");
+        return;
+    }
+    uint64_t elapsed = now - start;
+    uint64_t waited_ms = (elapsed / freq) * 1000 + ((elapsed % freq) * 1000) / freq;
+    error = rfbt_loader_claim(&lithium_fastboot_once, wire, RFBT_WIRE_SIZE,
+        &lithium_fastboot_requested, lithium_fastboot_cookie, reason, syndrome, waited_ms);
+    clean_dcache((uint64_t)(uintptr_t)wire, (uint64_t)(uintptr_t)wire + RFBT_WIRE_SIZE);
+    if (error != RFBT_OK) {
+        print("LITHIUM FASTBOOT status=retained reason=claim error=%d\n", (uint64_t)error);
+        return;
+    }
+    hardware.revision = LFB_PROTOCOL_REVISION;
+    hardware.size = sizeof(hardware);
+    efi_status status = lithium_fastboot_firmware->prepare(lithium_fastboot_firmware, &hardware);
+    print("LITHIUM FASTBOOT phase=firmware_prepare status=%x state=%d flags=%x detail=%x\n",
+        status, (uint64_t)hardware.state, (uint64_t)hardware.flags, hardware.detail);
+    print("LITHIUM FASTBOOT imem_before=%x imem_after=%x pmic_before=%x pmic_after=%x\n",
+        (uint64_t)hardware.imem_before, (uint64_t)hardware.imem_after,
+        (uint64_t)hardware.pmic_before, (uint64_t)hardware.pmic_after);
+    if (!EFI_ERROR(status) && hardware.revision == LFB_PROTOCOL_REVISION &&
+        hardware.size == sizeof(hardware) && hardware.state == LFB_STATE_PREPARED &&
+        hardware.backend == LFB_BACKEND_LITHIUM && hardware.ticket &&
+        hardware.flags == (LFB_FLAG_IMEM_VERIFIED | LFB_FLAG_PMIC_VERIFIED)) {
+        print("LITHIUM FASTBOOT status=commit attempt=1\n");
+        status = lithium_fastboot_firmware->commit(lithium_fastboot_firmware, hardware.ticket);
+    }
+    (void)rfbt_handoff_returned(&lithium_fastboot_once, wire, RFBT_WIRE_SIZE);
+    clean_dcache((uint64_t)(uintptr_t)wire, (uint64_t)(uintptr_t)wire + RFBT_WIRE_SIZE);
+    print("LITHIUM FASTBOOT status=retained reason=firmware_returned status=%x retry=0\n", status);
+}
diff --git a/ports/hakios-lithium/return-fastboot/profile.h b/ports/hakios-lithium/return-fastboot/profile.h
new file mode 100644
index 0000000..4ef50c0
--- /dev/null
+++ b/ports/hakios-lithium/return-fastboot/profile.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: MIT
+ * Admission for the existing isolated RAM diagnostic. This is not an ENOENT
+ * exception for a failed UFS boot. Loader also checks its actual firmware
+ * profile/provider capability and XNU checks the actual storage driver state.
+ */
+#ifndef LITHIUM_RETURN_FASTBOOT_PROFILE_H
+#define LITHIUM_RETURN_FASTBOOT_PROFILE_H
+#include "contract.h"
+
+static inline int
+rfbt_ram_profile(const char *args, size_t length, int require_rd)
+{
+    size_t at = 0;
+    unsigned ufs = 0, cpu = 0, boot = 0, rd = 0;
+    if (!args || !length || length >= RFBT_ARGS_MAX) return 0;
+    while (at < length) {
+        while (at < length && rfbt_space((unsigned char)args[at])) ++at;
+        size_t start = at;
+        while (at < length && !rfbt_space((unsigned char)args[at])) ++at;
+        size_t n = at - start, key = 0;
+        if (!n) continue;
+        while (key < n && args[start + key] != '=') ++key;
+#define LRF_KEY(s) rfbt_bytes_equal(args + start, key, s, sizeof(s) - 1)
+#define LRF_WORD(s) rfbt_bytes_equal(args + start, n, s, sizeof(s) - 1)
+        if (LRF_KEY("ufs")) { if (!LRF_WORD("ufs=0") || ++ufs != 1) return 0; }
+        else if (LRF_KEY("cpus")) { if (!LRF_WORD("cpus=1") || ++cpu != 1) return 0; }
+        else if (LRF_KEY("bootcpu")) { if (!LRF_WORD("bootcpu=1") || ++boot != 1) return 0; }
+        else if (LRF_KEY("rd")) { if (!LRF_WORD("rd=md0") || ++rd != 1) return 0; }
+        else if ((key >= 4 && rfbt_bytes_equal(args + start, 4, "ufs_", 4)) ||
+                 (key >= 4 && rfbt_bytes_equal(args + start, 4, "var_", 4)) ||
+                 LRF_KEY("root_apfs") || LRF_KEY("rootdev") || LRF_KEY("root_device") ||
+                 LRF_KEY("apfs_volume") || LRF_KEY("cpumask") || LRF_KEY("return_cpu") ||
+                 LRF_KEY("return_panic") || LRF_KEY("hfs_bench") || LRF_KEY("fsdiag") ||
+                 LRF_KEY("hfsdiag") || LRF_KEY("lsdbfinal")) return 0;
+#undef LRF_KEY
+#undef LRF_WORD
+    }
+    return ufs == 1 && cpu == 1 && boot == 1 && (!require_rd || rd == 1);
+}
+#endif
diff --git a/ports/hakios-lithium/return-fastboot/reset-core.h b/ports/hakios-lithium/return-fastboot/reset-core.h
new file mode 100644
index 0000000..ca16c15
--- /dev/null
+++ b/ports/hakios-lithium/return-fastboot/reset-core.h
@@ -0,0 +1,507 @@
+/* SPDX-License-Identifier: MIT
+ * Callback-only, single-use Lithium reset backend. No device access at include
+ * time; no libc, heap, IRQ, SCM, generic reset, or automatic transaction retry.
+ *
+ * Primary semantic references (pinned hashes in reset-core/source-hashes.json):
+ * LK 0c6ffa45154fb133dfe986d98d50f75470d8fa83:
+ *   msm_shared/spmi.c, include/spmi{,_v2}.h: v2 EXT_LONG READ=1/WRITE=0,
+ *   PPID->channel table, observer reads, channel writes, bytecount=0.
+ *   pm8x41.c:388-413: both disable, 300us, both type, both enable.
+ * Stock aboot research: reason SID0/088f consumed as high-six-bit field 08.
+ * Linux v6.12 adc218676eef25575469234709c2d87185ca223a:
+ *   spmi-pmic-arb.c:59,1093-1104,1249-1263,1561-1564:
+ *   v2 APID is channel-table index; CNFG+700+4*APID, low3 = write/IRQ EE.
+ *
+ * The adapter MUST serialize every entry and keep this object/private callbacks
+ * inaccessible to untrusted callers. Flags are attestations, not measurements.
+ * A bounded callback count cannot bound a hung MMIO or faulty delay callback.
+ */
+#ifndef LITHIUM_RETURN_FASTBOOT_RESET_CORE_H
+#define LITHIUM_RETURN_FASTBOOT_RESET_CORE_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#define LFBR_API_VERSION             UINT32_C(0x00010000)
+#define LFBR_CORE_PA                 UINT64_C(0x0400f000)
+#define LFBR_CNFG_PA                 UINT64_C(0x0400a000)
+#define LFBR_WRITE_PA                UINT64_C(0x04400000)
+#define LFBR_OBSERVER_PA             UINT64_C(0x04c00000)
+#define LFBR_IMEM_PA                 UINT64_C(0x066bf65c)
+#define LFBR_PSHOLD_PA               UINT64_C(0x004ab000)
+#define LFBR_IMEM_FASTBOOT           UINT32_C(0x77665500)
+#define LFBR_V2_MIN                  UINT32_C(0x20010000)
+#define LFBR_V3_MIN                  UINT32_C(0x30000000)
+#define LFBR_CHANNELS                256u
+#define LFBR_STRIDE                  UINT64_C(0x8000)
+#define LFBR_MAX_POLLS               1024u
+#define LFBR_REASON                  0x8fu
+#define LFBR_TYPE                    0x5au
+#define LFBR_ENABLE                  0x5bu
+
+/* This deliberately implements ONLY EE0. Other EEs are rejected; owning is
+ * checked in real MMIO, not inferred from PPID or an adapter Q_OWNER flag.
+ * Exclusivity / safe register access remain adapter qualifications.
+ */
+#define LFBR_Q_BOARD                 (1u << 0)
+#define LFBR_Q_MAPPINGS              (1u << 1)
+/* bit2 is deliberately unused: owner is measured, never attested. */
+#define LFBR_Q_EXCLUSIVE             (1u << 3)
+#define LFBR_Q_NORMAL_RETURN         (1u << 4)
+#define LFBR_Q_FINALIZED             (1u << 5)
+#define LFBR_Q_USB_DRAIN             (1u << 6)
+/* The adapter has resolved optional arbiter-halt/secure-world policy. Required
+ * halt is delegated ONCE to the sourced adapter callback after all PMIC reads.
+ */
+#define LFBR_Q_ARBITER_POLICY        (1u << 7)
+#define LFBR_Q_REQUIRED              UINT32_C(0xfb)
+
+enum lfbr_error {
+    LFBR_OK = 0, LFBR_BAD_ARGUMENT, LFBR_PRECONDITION, LFBR_BAD_STATE,
+    LFBR_VERSION, LFBR_CHANNEL, LFBR_IO, LFBR_TIMEOUT, LFBR_SPMI_STATUS,
+    LFBR_VERIFY, LFBR_TICKET, LFBR_TERMINAL_RETURNED, LFBR_TERMINAL_IO,
+    LFBR_OWNER, LFBR_HALT
+};
+enum lfbr_state {
+    LFBR_IDLE = 0, LFBR_PREPARING, LFBR_PREPARED, LFBR_FAILED,
+    LFBR_ABORTED, LFBR_CONSUMED
+};
+enum lfbr_dirty {
+    LFBR_DIRTY_REASON = 1u, LFBR_DIRTY_RESET = 2u, LFBR_DIRTY_IMEM = 4u
+};
+
+/* All callbacks return 1 on success, 0 on failure. A failed write may already
+ * have taken effect. read32 must set *value only on success. barrier provides
+ * device ordering (e.g. DSB SY), not just a compiler fence. delay_us must wait
+ * AT LEAST the requested real time, with an independently bounded return.
+ */
+struct lfbr_io {
+    void *opaque;
+    int (*read32)(void *, uint64_t, uint32_t *);
+    int (*write32)(void *, uint64_t, uint32_t);
+    int (*delay_us)(void *, uint32_t);
+    int (*barrier)(void *);
+    int (*halt_arbiter)(void *);    /* required iff config says halt required */
+};
+struct lfbr_config {
+    uint32_t version;
+    uint32_t qualifications;
+    uint32_t owner;                 /* ONLY 0 */
+    uint32_t polls;                 /* 1..1024, per command */
+    uint32_t arbiter_halt_required; /* exact source availability: 0 or 1 */
+};
+struct lfbr_core {
+    struct lfbr_io io;
+    struct lfbr_config config;
+    uint32_t magic, state, error, recovery_error;
+    uint32_t hw_version, channel[2], mapping[2];
+    uint32_t owner_before[2], owner_latest[2];
+    uint32_t dirty, recovery_attempted, transport_uncertain;
+    uint32_t imem_before, imem_after, last_status;
+    uint32_t read_count, write_count, poll_count, command_count;
+    uint32_t terminal_attempted;
+    uint32_t halt_attempted, halt_succeeded;
+    uint8_t reason_before, reason_after, type_before[2], enable_before[2];
+    uint64_t ticket, last_address;
+};
+
+static inline int lfbr_barrier(struct lfbr_core *c)
+{
+    if (!c->io.barrier(c->io.opaque)) return LFBR_IO;
+    return LFBR_OK;
+}
+static inline int lfbr_read(struct lfbr_core *c, uint64_t pa, uint32_t *v)
+{
+    c->last_address = pa;
+    ++c->read_count;
+    return c->io.read32(c->io.opaque, pa, v) ? LFBR_OK : LFBR_IO;
+}
+static inline int lfbr_write(struct lfbr_core *c, uint64_t pa, uint32_t v)
+{
+    c->last_address = pa;
+    ++c->write_count;
+    return c->io.write32(c->io.opaque, pa, v) ? LFBR_OK : LFBR_IO;
+}
+static inline int lfbr_delay(struct lfbr_core *c, uint32_t us)
+{
+    return c->io.delay_us(c->io.opaque, us) ? LFBR_OK : LFBR_IO;
+}
+
+static inline int lfbr_gate(const struct lfbr_core *c)
+{
+    if (c->config.version != LFBR_API_VERSION ||
+        c->config.qualifications != LFBR_Q_REQUIRED ||
+        c->config.owner != 0u || c->config.arbiter_halt_required > 1u ||
+        (c->config.arbiter_halt_required && !c->io.halt_arbiter))
+        return LFBR_PRECONDITION;
+    if (!c->config.polls || c->config.polls > LFBR_MAX_POLLS)
+        return LFBR_BAD_ARGUMENT;
+    return LFBR_OK;
+}
+
+/* Initialize ONCE per serialized firmware instance, before Prepare. Do not
+ * reinitialize the same instance after failure/commit to defeat single-use.
+ * Zeroing uses volatile byte stores, so freestanding builds need no memset.
+ */
+static inline int lfbr_init(struct lfbr_core *c, const struct lfbr_io *io,
+                            const struct lfbr_config *config)
+{
+    size_t i;
+    volatile unsigned char *p;
+    struct lfbr_io io_copy;
+    struct lfbr_config config_copy;
+    if (!c || !io || !config || !io->read32 || !io->write32 ||
+        !io->delay_us || !io->barrier) return LFBR_BAD_ARGUMENT;
+    io_copy = *io;
+    config_copy = *config;
+    p = (volatile unsigned char *)c;
+    for (i = 0; i < sizeof(*c); ++i) p[i] = 0;
+    c->io = io_copy;
+    c->config = config_copy;
+    c->magic = UINT32_C(0x4c465242);
+    return lfbr_gate(c);             /* no callbacks, including on rejection */
+}
+
+static inline int lfbr_discover(struct lfbr_core *c)
+{
+    uint32_t i, value, found[2] = {0u, 0u};
+    int e;
+    e = lfbr_read(c, LFBR_CORE_PA, &value);
+    if (e) return e;
+    if (value < LFBR_V2_MIN || value >= LFBR_V3_MIN) return LFBR_VERSION;
+    c->hw_version = value;
+    for (i = 0; i < LFBR_CHANNELS; ++i) {
+        uint32_t ppid, n;
+        e = lfbr_read(c, LFBR_CORE_PA + UINT64_C(0x800) + 4u*i, &value);
+        if (e) return e;
+        ppid = (value >> 8) & 0xfffu;
+        if (ppid == 0x008u) n = 0u;
+        else if (ppid == 0x208u) n = 1u;
+        else continue;
+        if (found[n]) return LFBR_CHANNEL; /* ambiguous mapping never wins */
+        found[n] = 1u;
+        c->channel[n] = i;
+        c->mapping[n] = value;
+    }
+    if (!found[0] || !found[1]) return LFBR_CHANNEL;
+    /* Refuse inherited IRQ-mode windows instead of modifying/restoring unknown
+     * CONFIG semantics. Normal transfers write the already-observed zero.
+     */
+    for (i = 0; i < 2u; ++i) {
+        uint64_t off = LFBR_STRIDE * c->channel[i];
+        e = lfbr_read(c, LFBR_CNFG_PA + UINT64_C(0x700) +
+                         4u*c->channel[i], &value);
+        if (e) return e;
+        c->owner_before[i] = value;
+        c->owner_latest[i] = value;
+        if ((value & 7u) != c->config.owner) return LFBR_OWNER;
+        e = lfbr_read(c, LFBR_WRITE_PA + off + 4u, &value);
+        if (e) return e;
+        if (value != 0u) return LFBR_PRECONDITION;
+        e = lfbr_read(c, LFBR_OBSERVER_PA + off + 4u, &value);
+        if (e) return e;
+        if (value != 0u) return LFBR_PRECONDITION;
+    }
+    return LFBR_OK;
+}
+
+/* Only one-byte accesses to PON page 08 at SID0/SID2 are expressible.
+ * A command write or ordering/status failure leaves transport_uncertain set.
+ * No subsequent command (including rollback) is allowed in that situation.
+ */
+static inline int lfbr_byte(struct lfbr_core *c, uint32_t n, uint8_t reg,
+                            int is_read, uint8_t *value)
+{
+    uint64_t base;
+    uint32_t v, k;
+    int e;
+    if (n > 1u || !value || c->channel[n] >= LFBR_CHANNELS ||
+        (reg != LFBR_REASON && reg != LFBR_TYPE && reg != LFBR_ENABLE) ||
+        (reg == LFBR_REASON && n != 0u)) return LFBR_BAD_ARGUMENT;
+    if (c->transport_uncertain) return LFBR_BAD_STATE;
+    e = lfbr_read(c, LFBR_CORE_PA, &v);
+    if (e) return e;
+    if (v != c->hw_version) return LFBR_VERSION;
+    e = lfbr_read(c, LFBR_CORE_PA + UINT64_C(0x800) +
+                     4u*c->channel[n], &v);
+    if (e) return e;
+    if (v != c->mapping[n]) return LFBR_CHANNEL;
+    e = lfbr_read(c, LFBR_CNFG_PA + UINT64_C(0x700) +
+                     4u*c->channel[n], &v);
+    if (e) return e;
+    c->owner_latest[n] = v;
+    if ((v & 7u) != c->config.owner) return LFBR_OWNER;
+    base = (is_read ? LFBR_OBSERVER_PA : LFBR_WRITE_PA) +
+           LFBR_STRIDE*c->channel[n]; /* owner 0 ONLY */
+    e = lfbr_read(c, base + 4u, &v);
+    if (e) return e;
+    if (v != 0u) return LFBR_PRECONDITION;
+    e = lfbr_write(c, base + 4u, 0u); /* sourced polling-mode CONFIG */
+    if (e) return e;
+    if (!is_read) {
+        e = lfbr_write(c, base + 0x10u, *value);
+        if (e) return e;
+    }
+    e = lfbr_barrier(c);
+    if (e) return e;
+    c->transport_uncertain = 1u; /* before possibly-effectful CMD callback */
+    ++c->command_count;
+    /* v2 encodes offset ONLY, not SID/peripheral. BYTE_CNT for 1 byte is 0. */
+    v = (is_read ? (UINT32_C(1) << 27) : 0u) | ((uint32_t)reg << 4);
+    e = lfbr_write(c, base, v);
+    if (e) return e;
+    e = lfbr_barrier(c);
+    if (e) return e;
+    for (k = 0; k < c->config.polls; ++k) {
+        ++c->poll_count;
+        e = lfbr_read(c, base + 8u, &v);
+        if (e) return e;
+        c->last_status = v;
+        if (v != 0u) {
+            /* DONE+known error bits is terminal but unsuccessful. Unknown
+             * bits / error-without-DONE do not prove an idle transport.
+             */
+            if ((v & 1u) && !(v & ~UINT32_C(0xf)))
+                c->transport_uncertain = 0u;
+            if (v != 1u) return LFBR_SPMI_STATUS;
+            e = lfbr_barrier(c);
+            if (e) return e;
+            if (is_read) {
+                e = lfbr_read(c, base + 0x18u, &v);
+                if (e) return e;
+                *value = (uint8_t)v;
+            }
+            return LFBR_OK;
+        }
+        if (k + 1u < c->config.polls) {
+            e = lfbr_delay(c, 1u);
+            if (e) return e;
+        }
+    }
+    return LFBR_TIMEOUT;
+}
+static inline int lfbr_get(struct lfbr_core *c, uint32_t n, uint8_t reg,
+                           uint8_t *value)
+{
+    return lfbr_byte(c, n, reg, 1, value);
+}
+/* Both routes must still be owned/mapped at the final commit boundary, including
+ * the route whose final PMIC read happened earlier than the other route's.
+ */
+static inline int lfbr_validate_routes(struct lfbr_core *c)
+{
+    uint32_t n, v;
+    int e = lfbr_read(c, LFBR_CORE_PA, &v);
+    if (e) return e;
+    if (v != c->hw_version) return LFBR_VERSION;
+    for (n = 0; n < 2u; ++n) {
+        e = lfbr_read(c, LFBR_CORE_PA + UINT64_C(0x800) +
+                         4u*c->channel[n], &v);
+        if (e) return e;
+        if (v != c->mapping[n]) return LFBR_CHANNEL;
+        e = lfbr_read(c, LFBR_CNFG_PA + UINT64_C(0x700) +
+                         4u*c->channel[n], &v);
+        if (e) return e;
+        c->owner_latest[n] = v;
+        if ((v & 7u) != c->config.owner) return LFBR_OWNER;
+    }
+    return LFBR_OK;
+}
+static inline int lfbr_set(struct lfbr_core *c, uint32_t n, uint8_t reg,
+                           uint8_t value)
+{
+    return lfbr_byte(c, n, reg, 0, &value);
+}
+static inline int lfbr_set_checked(struct lfbr_core *c, uint32_t n,
+                                   uint8_t reg, uint8_t value)
+{
+    uint8_t got;
+    int e = lfbr_set(c, n, reg, value);
+    if (e) return e;
+    e = lfbr_get(c, n, reg, &got);
+    if (e) return e;
+    return got == value ? LFBR_OK : LFBR_VERIFY;
+}
+
+/* One bounded recovery attempt, distinct from retrying the failed operation.
+ * Saved PMIC reset state is restored with the SAME sourced safe write order:
+ * both disable -> >=300us -> both saved types -> both saved enables.
+ * Stop the PMIC sequence on the first failure (never enable after failed type).
+ * Even if SPMI is uncertain, independent IMEM restoration is attempted once.
+ * dirty retains every group whose exact restoration cannot be verified.
+ */
+static inline int lfbr_recover(struct lfbr_core *c)
+{
+    uint32_t n, v;
+    int e = LFBR_OK, ie;
+    if (c->recovery_attempted) return LFBR_BAD_STATE;
+    c->recovery_attempted = 1u;
+    if (c->halt_attempted) {
+        c->recovery_error = LFBR_BAD_STATE;
+        return LFBR_BAD_STATE; /* successful OR failed halt is irreversible */
+    }
+    e = lfbr_gate(c);
+    if (e) {
+        c->recovery_error = (uint32_t)e;
+        return e; /* lost mappings/ownership never authorize recovery MMIO */
+    }
+    if (c->dirty & (LFBR_DIRTY_REASON | LFBR_DIRTY_RESET)) {
+        if (c->transport_uncertain) e = LFBR_BAD_STATE;
+        if (!e && (c->dirty & LFBR_DIRTY_RESET)) {
+            for (n = 0; n < 2u && !e; ++n)
+                e = lfbr_set_checked(c, n, LFBR_ENABLE, 0u);
+            if (!e) e = lfbr_delay(c, 300u);
+            for (n = 0; n < 2u && !e; ++n)
+                e = lfbr_set_checked(c, n, LFBR_TYPE, c->type_before[n]);
+            for (n = 0; n < 2u && !e; ++n)
+                e = lfbr_set_checked(c, n, LFBR_ENABLE, c->enable_before[n]);
+            if (!e) c->dirty &= ~(uint32_t)LFBR_DIRTY_RESET;
+        }
+        if (!e && (c->dirty & LFBR_DIRTY_REASON)) {
+            e = lfbr_set_checked(c, 0u, LFBR_REASON, c->reason_before);
+            if (!e) c->dirty &= ~(uint32_t)LFBR_DIRTY_REASON;
+        }
+    }
+    if (c->dirty & LFBR_DIRTY_IMEM) {
+        ie = lfbr_write(c, LFBR_IMEM_PA, c->imem_before);
+        if (!ie) ie = lfbr_barrier(c);
+        if (!ie) ie = lfbr_read(c, LFBR_IMEM_PA, &v);
+        if (!ie && v != c->imem_before) ie = LFBR_VERIFY;
+        if (!ie) c->dirty &= ~(uint32_t)LFBR_DIRTY_IMEM;
+        if (!e) e = ie;
+    }
+    c->recovery_error = (uint32_t)e;
+    return e;
+}
+
+static inline int lfbr_fail(struct lfbr_core *c, int error)
+{
+    c->state = LFBR_FAILED;
+    c->error = (uint32_t)error;
+    c->ticket = 0;
+    if (c->dirty && !c->recovery_attempted) (void)lfbr_recover(c);
+    return error;
+}
+
+static inline int lfbr_prepare(struct lfbr_core *c, uint64_t ticket)
+{
+    uint32_t n, v;
+    uint8_t want;
+    int e;
+    if (!c || c->magic != UINT32_C(0x4c465242)) return LFBR_BAD_ARGUMENT;
+    if (c->state != LFBR_IDLE) return LFBR_BAD_STATE;
+    c->state = LFBR_PREPARING;
+    e = lfbr_gate(c);
+    if (e) return lfbr_fail(c, e);
+    if (!ticket) return lfbr_fail(c, LFBR_BAD_ARGUMENT);
+    e = lfbr_discover(c);
+    if (e) return lfbr_fail(c, e);
+    /* Complete snapshots BEFORE any PMIC/IMEM data mutation. */
+    e = lfbr_get(c, 0u, LFBR_REASON, &c->reason_before);
+    if (e) return lfbr_fail(c, e);
+    for (n = 0; n < 2u; ++n) {
+        e = lfbr_get(c, n, LFBR_TYPE, &c->type_before[n]);
+        if (e) return lfbr_fail(c, e);
+        e = lfbr_get(c, n, LFBR_ENABLE, &c->enable_before[n]);
+        if (e) return lfbr_fail(c, e);
+        if (!(c->enable_before[n] & 0x80u))
+            return lfbr_fail(c, LFBR_PRECONDITION);
+    }
+    e = lfbr_read(c, LFBR_IMEM_PA, &c->imem_before);
+    if (e) return lfbr_fail(c, e);
+    want = (uint8_t)((c->reason_before & 3u) | 8u);
+    c->dirty |= LFBR_DIRTY_REASON; /* possibly landed writes are dirty too */
+    e = lfbr_set_checked(c, 0u, LFBR_REASON, want);
+    if (e) return lfbr_fail(c, e);
+    c->reason_after = want; /* only published AFTER exact readback */
+    c->dirty |= LFBR_DIRTY_RESET;
+    for (n = 0; n < 2u; ++n) {
+        e = lfbr_set_checked(c, n, LFBR_ENABLE, 0u);
+        if (e) return lfbr_fail(c, e);
+    }
+    e = lfbr_delay(c, 300u);
+    if (e) return lfbr_fail(c, e);
+    for (n = 0; n < 2u; ++n) {
+        e = lfbr_set_checked(c, n, LFBR_TYPE, 7u);
+        if (e) return lfbr_fail(c, e);
+    }
+    for (n = 0; n < 2u; ++n) {
+        e = lfbr_set_checked(c, n, LFBR_ENABLE, 0x80u);
+        if (e) return lfbr_fail(c, e);
+    }
+    c->dirty |= LFBR_DIRTY_IMEM;
+    e = lfbr_write(c, LFBR_IMEM_PA, LFBR_IMEM_FASTBOOT);
+    if (e) return lfbr_fail(c, e);
+    e = lfbr_barrier(c);
+    if (e) return lfbr_fail(c, e);
+    e = lfbr_read(c, LFBR_IMEM_PA, &v);
+    if (e) return lfbr_fail(c, e);
+    if (v != LFBR_IMEM_FASTBOOT) return lfbr_fail(c, LFBR_VERIFY);
+    c->imem_after = v;
+    c->ticket = ticket;
+    c->state = LFBR_PREPARED;
+    return LFBR_OK;
+}
+
+static inline int lfbr_abort(struct lfbr_core *c)
+{
+    int e;
+    if (!c || c->magic != UINT32_C(0x4c465242)) return LFBR_BAD_ARGUMENT;
+    if (c->state != LFBR_PREPARED) return LFBR_BAD_STATE;
+    c->state = LFBR_ABORTED; /* consume even when restoration fails */
+    c->ticket = 0;
+    e = lfbr_recover(c);
+    c->error = (uint32_t)e;
+    return e;
+}
+
+static inline int lfbr_commit(struct lfbr_core *c, uint64_t ticket)
+{
+    uint32_t n, v;
+    uint8_t got;
+    int e;
+    if (!c || c->magic != UINT32_C(0x4c465242)) return LFBR_BAD_ARGUMENT;
+    if (c->state != LFBR_PREPARED) return LFBR_BAD_STATE;
+    if (!ticket || ticket != c->ticket) return lfbr_fail(c, LFBR_TICKET);
+    e = lfbr_gate(c);
+    if (e) return lfbr_fail(c, e);
+    /* Revalidate actual state immediately before terminal commit. */
+    e = lfbr_get(c, 0u, LFBR_REASON, &got);
+    if (e) return lfbr_fail(c, e);
+    if (got != c->reason_after) return lfbr_fail(c, LFBR_VERIFY);
+    for (n = 0; n < 2u; ++n) {
+        e = lfbr_get(c, n, LFBR_TYPE, &got);
+        if (e) return lfbr_fail(c, e);
+        if (got != 7u) return lfbr_fail(c, LFBR_VERIFY);
+        e = lfbr_get(c, n, LFBR_ENABLE, &got);
+        if (e) return lfbr_fail(c, e);
+        if (got != 0x80u) return lfbr_fail(c, LFBR_VERIFY);
+    }
+    e = lfbr_read(c, LFBR_IMEM_PA, &v);
+    if (e) return lfbr_fail(c, e);
+    if (v != LFBR_IMEM_FASTBOOT) return lfbr_fail(c, LFBR_VERIFY);
+    e = lfbr_validate_routes(c);
+    if (e) return lfbr_fail(c, e);
+    e = lfbr_barrier(c);
+    if (e) return lfbr_fail(c, e);
+    /* Set all software state BEFORE terminal store. Any return is a failed
+     * physical reset. There are NO callbacks, readbacks, recovery or fallback
+     * after this sole PSHOLD attempt, whether write32 returns true or false.
+     */
+    c->state = LFBR_CONSUMED;
+    c->ticket = 0;
+    if (c->config.arbiter_halt_required) {
+        c->halt_attempted = 1u; /* a false callback may still have halted */
+        if (!c->io.halt_arbiter(c->io.opaque)) {
+            c->state = LFBR_FAILED;
+            c->error = LFBR_HALT;
+            return LFBR_HALT; /* no recovery/MMIO/PSHOLD after uncertain halt */
+        }
+        c->halt_succeeded = 1u;
+    }
+    c->terminal_attempted = 1u;
+    e = lfbr_write(c, LFBR_PSHOLD_PA, 0u);
+    c->error = e ? LFBR_TERMINAL_IO : LFBR_TERMINAL_RETURNED;
+    return (int)c->error;
+}
+#endif
