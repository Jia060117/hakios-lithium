+           RFBT_E_ARGS_TRUNCATED);
+        EQ(c.enabled, 0u);
+    }
+    rfbt_config_default(&c); c.enabled = 1;
+    EQ(rfbt_config_check(&c), RFBT_E_CONFIG);
+    rfbt_config_default(&c); c.delay_seconds = 0;
+    EQ(rfbt_config_check(&c), RFBT_E_CONFIG);
+    rfbt_config_default(&c); c.seen = UINT32_MAX;
+    EQ(rfbt_config_check(&c), RFBT_E_CONFIG);
+    rfbt_config_default(&c); c.error = 1;
