+static void parser_fuzz(void)
+{
+    char b[201];
+    struct rfbt_config c;
+    size_t i, j;
+    suite = "deterministic hostile parser fuzz";
+    for (i = 0; i < 40000; ++i) {
+        size_t n = random32() % sizeof b;
