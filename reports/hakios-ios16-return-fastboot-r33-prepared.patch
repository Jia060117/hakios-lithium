+    for (i = 0; i < sizeof valid / sizeof valid[0]; ++i) {
+        EQ(parse(valid[i].s, &c), RFBT_OK);
+        EQ(c.enabled, valid[i].on); EQ(c.delay_seconds, valid[i].delay);
+        EQ(rfbt_config_check(&c), RFBT_OK);
