index 0000000..e6cb81a
--- /dev/null
+++ b/maintenance/hakios-lithium/peripherals-next/touch-r21-probe.h
@@ -0,0 +1,73 @@
+#ifndef LITHIUM_TOUCH_R21_PROBE_H
+#define LITHIUM_TOUCH_R21_PROBE_H
+
+#include "qup-combined.h"
+
+/* An explicit zero requests a static report; an absent option does nothing.
+ * This parser does not grant access to hardware or interpret legacy switches. */
+enum lithium_r21_touch_request {
+    LITHIUM_R21_TOUCH_ABSENT, LITHIUM_R21_TOUCH_STATIC,
+    LITHIUM_R21_TOUCH_ID, LITHIUM_R21_TOUCH_FRAMES, LITHIUM_R21_TOUCH_HID,
+    LITHIUM_R21_TOUCH_INVALID
+};
+
+static inline bool
+lithium_r21_touch_space(char c)
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+static inline enum lithium_r21_touch_request
+lithium_r21_touch_request_parse(const char *cmd, size_t length)
+{
+    static const char key[] = "touch_stage";
+    const size_t n = sizeof(key) - 1;
+    enum lithium_r21_touch_request stage = LITHIUM_R21_TOUCH_ABSENT;
+
+    if ((!cmd && length) || length >= 4096) return LITHIUM_R21_TOUCH_INVALID;
+    for (size_t i = 0; i < length;) {
+        if (lithium_r21_touch_space(cmd[i])) { ++i; continue; }
+        const size_t start = i;
+        while (i < length && !lithium_r21_touch_space(cmd[i])) {
+            if (!cmd[i]) return LITHIUM_R21_TOUCH_INVALID;
+            ++i;
+        }
+        const size_t len = i - start;
+        if (len < n || memcmp(cmd + start, key, n) != 0 ||
+            (len > n && cmd[start + n] != '=')) continue;
+        if (stage != LITHIUM_R21_TOUCH_ABSENT || len != n + 2 ||
+            cmd[start + n + 1] < '0' || cmd[start + n + 1] > '3')
+            return LITHIUM_R21_TOUCH_INVALID;
+        stage = (enum lithium_r21_touch_request)(LITHIUM_R21_TOUCH_STATIC +
+            (cmd[start + n + 1] - '0'));
+    }
+    return stage;
+}
+
+/* First transaction only. Ownership is supplied by a separately verified
+ * platform adapter. Merely parsing touch_stage, or seeing an idle status,
+ * does not prove ownership. Zero-initialize and serialize on one worker. */
+struct lithium_r21_probe {
+    bool attempted;
+    bool parked_or_quarantined;
+    struct lqt_outcome last;
+};
+
+static inline enum lqt_status
+lithium_r21_read_id_once(struct lithium_r21_probe *probe, const struct lqt_io *io,
+    unsigned long long affinity, int max_cpu, uint64_t deadline, uint8_t *id)
+{
+    if (!probe || !id || !deadline || probe->attempted) return LQT_INVALID;
+    if (affinity != 1 || max_cpu != 0 || !lqt_ready(io))
+        return LQT_PLATFORM_UNVERIFIED;
+
+    probe->attempted = true;
+    probe->last = lqc_probe_chip_id(io, id, deadline);
+    /* The parked controller stays claimed; any failure after programming
+     * requires quarantine. Neither result is safe-release evidence. */
+    probe->parked_or_quarantined = probe->last.status == LQT_OK ||
+        probe->last.cleanup != LQT_OK;
+    return probe->last.status;
+}
+
+#endif
