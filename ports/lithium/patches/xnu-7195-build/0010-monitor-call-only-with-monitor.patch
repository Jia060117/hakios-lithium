From: ios14-lithium
Subject: [build] initialize the Apple monitor only when present

Backport of UniXNU c34f018aafd6befd5dc93c05a8dccd5bdce6724b,
patches/xnu/non-apple-cache-monitor.patch (monitor-call hunk).
NO_MONITOR targets have no Apple PPL monitor to enable.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2015,7 +2015,9 @@
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
+#if XNU_MONITOR
 	ml_enable_monitor();
+#endif
 
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
