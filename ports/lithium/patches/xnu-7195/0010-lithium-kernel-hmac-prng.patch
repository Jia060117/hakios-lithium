Subject: prng: adapt sailfish HMAC-SHA256 provider to XNU7195

Source: 6f27e41ff249f2680540ebe8ee5ab982c5e641c9, patch 0014.
7195 owns DRBG state separately and uses the older init callback signature.
Entropy collection preserves existing health tests; no dummy crypto table.

--- a/osfmk/prng/prng_random.c
+++ b/osfmk/prng/prng_random.c
@@ -145,6 +145,143 @@
 		     .strictFIPS = 0,
 	     }};
 
+#if defined(LITHIUM)
+/*
+ * The corecrypto kext normally installs the kernel PRNG. LITHIUM has no such
+ * kext: use the built-in HMAC-SHA256 DRBG, just as early_random does. A
+ * single mutex serializes generation and reseeding across all CPUs. This
+ * favors a small, auditable bring-up implementation over per-CPU scaling.
+ * This registers only the PRNG, not the unrelated g_crypto_funcs table.
+ */
+#include <kern/startup.h>
+
+static LCK_GRP_DECLARE(lithium_prng_group, "lithium-prng");
+static LCK_MTX_DECLARE(lithium_prng_lock, &lithium_prng_group);
+static struct cckprng_ctx lithium_prng_ctx;
+static uint8_t lithium_drbg_state[EARLY_RANDOM_STATE_STATIC_SIZE];
+static struct ccdrbg_info lithium_drbg_info;
+static const struct ccdrbg_nisthmac_custom lithium_prng_custom = {
+	.di = &ccsha256_ltc_di,
+	.strictFIPS = 0,
+};
+static cckprng_getentropy lithium_getentropy;
+static void *lithium_getentropy_arg;
+static unsigned lithium_max_ngens;
+static bool lithium_generators[MAX_CPUS];
+
+static struct ccdrbg_state *
+lithium_prng_state(struct cckprng_ctx *ctx)
+{
+	return (struct ccdrbg_state *)lithium_drbg_state;
+}
+
+static void
+lithium_prng_check(int status)
+{
+	if (status != CCDRBG_STATUS_OK) {
+		panic("LITHIUM HMAC DRBG error %d", status);
+	}
+}
+
+static void
+lithium_prng_init_with_getentropy(struct cckprng_ctx *ctx, unsigned max_ngens,
+    size_t seed_nbytes, const void *seed, size_t nonce_nbytes, const void *nonce,
+    cckprng_getentropy getentropy, void *getentropy_arg)
+{
+	assert(max_ngens > 0 && max_ngens <= MAX_CPUS);
+	ccdrbg_factory_nisthmac(&lithium_drbg_info, &lithium_prng_custom);
+	assert(lithium_drbg_info.size <= sizeof(lithium_drbg_state));
+	const char ps[] = "xnu lithium kernel random";
+	lithium_prng_check(ccdrbg_init(&lithium_drbg_info, lithium_prng_state(ctx),
+	    seed_nbytes, seed, nonce_nbytes, nonce, sizeof(ps) - 1, ps));
+	lithium_getentropy = getentropy;
+	lithium_getentropy_arg = getentropy_arg;
+	lithium_max_ngens = max_ngens;
+}
+
+static void
+lithium_prng_init(struct cckprng_ctx *ctx, unsigned max_ngens,
+    __unused size_t entropybuf_nbytes, __unused const void *entropybuf,
+    __unused const uint32_t *entropybuf_nsamples, size_t seed_nbytes,
+    const void *seed, size_t nonce_nbytes, const void *nonce)
+{
+	lithium_prng_init_with_getentropy(ctx, max_ngens, seed_nbytes, seed,
+	    nonce_nbytes, nonce, entropy_provide, NULL);
+}
+
+static void
+lithium_prng_initgen(__unused struct cckprng_ctx *ctx, unsigned gen_idx)
+{
+	lck_mtx_lock(&lithium_prng_lock);
+	assert(gen_idx < lithium_max_ngens);
+	assert(!lithium_generators[gen_idx]);
+	lithium_generators[gen_idx] = true;
+	lck_mtx_unlock(&lithium_prng_lock);
+}
+
+static void
+lithium_prng_reseed(struct cckprng_ctx *ctx, size_t nbytes, const void *seed)
+{
+	lck_mtx_lock(&lithium_prng_lock);
+	lithium_prng_check(ccdrbg_reseed(&lithium_drbg_info, lithium_prng_state(ctx),
+	    nbytes, seed, 0, NULL));
+	lck_mtx_unlock(&lithium_prng_lock);
+}
+
+static void
+lithium_prng_refresh(struct cckprng_ctx *ctx)
+{
+	/* The entropy callback also uses try-lock; refresh must not wait. */
+	if (!lck_mtx_try_lock(&lithium_prng_lock)) {
+		return;
+	}
+	uint8_t entropy[SHA256_DIGEST_LENGTH];
+	size_t nbytes = sizeof(entropy);
+	int32_t nsamples = lithium_getentropy(&nbytes, entropy, lithium_getentropy_arg);
+	if (nsamples < 0) {
+		panic("LITHIUM PRNG entropy health test failed");
+	}
+	if (nsamples >= 256) {
+		assert(nbytes >= SEED_SIZE && nbytes <= sizeof(entropy));
+		lithium_prng_check(ccdrbg_reseed(&lithium_drbg_info, lithium_prng_state(ctx),
+		    nbytes, entropy, 0, NULL));
+	}
+	cc_clear(sizeof(entropy), entropy);
+	lck_mtx_unlock(&lithium_prng_lock);
+}
+
+static void
+lithium_prng_generate(struct cckprng_ctx *ctx, unsigned gen_idx,
+    size_t nbytes, void *out)
+{
+	assert(nbytes <= CCKPRNG_GENERATE_MAX_NBYTES);
+	lck_mtx_lock(&lithium_prng_lock);
+	assert(gen_idx < lithium_max_ngens && lithium_generators[gen_idx]);
+	lithium_prng_check(ccdrbg_generate(&lithium_drbg_info, lithium_prng_state(ctx),
+	    nbytes, out, 0, NULL));
+	lck_mtx_unlock(&lithium_prng_lock);
+}
+
+__startup_func
+static void
+lithium_prng_startup(void)
+{
+	/* Ensure the boot seed exists before registration erases the early DRBG. */
+	(void)early_random();
+	const struct cckprng_funcs funcs = {
+		.init = lithium_prng_init,
+		.initgen = lithium_prng_initgen,
+		.reseed = lithium_prng_reseed,
+		.refresh = lithium_prng_refresh,
+		.generate = lithium_prng_generate,
+		.init_with_getentropy = lithium_prng_init_with_getentropy,
+	};
+	register_and_init_prng(&lithium_prng_ctx, &funcs);
+	kprintf("LITHIUM PRNG: HMAC-SHA256 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_FIRST, lithium_prng_startup);
+#endif /* LITHIUM */
