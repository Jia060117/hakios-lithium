Subject: lithium: locate real arm_vm_init stop; clear old loader body

diff --git a/osfmk/arm64/lithium_early.c b/osfmk/arm64/lithium_early.c
--- a/osfmk/arm64/lithium_early.c
+++ b/osfmk/arm64/lithium_early.c
@@ -32,7 +32,12 @@
 }
 void lithium_early_putc(char c)
 {
-    if (!started) { started = 1; clear_row(); }
+    if (!started) {
+        started = 1;
+        /* Keep the loader's build header; clear its old body before kernel logs. */
+        for (unsigned int y = row * CELL_H; y < HEIGHT - 32; y++)
+            for (unsigned int x = 0; x < WIDTH; x++) pixel(x, y, 0);
+    }
     if (c == '\r') { col = 0; return; }
     if (c == '\n' || col == COLS) {
         col = 0; row = (row + 1) % ROWS; clear_row();
@@ -62,6 +67,14 @@
     lithium_early_putc('0' + stage % 10);
     string(": "); string(label); lithium_early_putc('\n');
 }
+void lithium_early_hex(const char *label, uint64_t value)
+{
+    static const char digits[] = "0123456789abcdef";
+    string(label); string("=0x");
+    for (int shift = 60; shift >= 0; shift -= 4)
+        lithium_early_putc(digits[(value >> shift) & 15]);
+    lithium_early_putc('\n');
+}
 void lithium_early_relocate(uint64_t base)
 {
     fb = (volatile unsigned char *)(uintptr_t)base;
