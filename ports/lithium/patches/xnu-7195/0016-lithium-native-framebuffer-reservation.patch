Subject: lithium: reserve the native framebuffer L2 alias from kernel VM allocation

Round 4 reached zone_init, then pmap_ttne tried L3 at 0xfffffff0038ec000
inside the console block (TTE 0x0060000082000605). Reserve that VA in
the existing low-globals region before kmem_init makes heap allocations.

diff --git a/osfmk/arm/pmap.c b/osfmk/arm/pmap.c
--- a/osfmk/arm/pmap.c
+++ b/osfmk/arm/pmap.c
@@ -5110,10 +5110,25 @@
 		low_global_vr_size = 0x800000;
 	}
 
+#if defined(LITHIUM)
+	/* arm_vm_init.c maps the early BGR24 console in the NEXT L2 block
+	 * above low globals. Unlike the newer reference kernel, non-KTRR
+	 * XNU7195 reserves only the first block here. Exclude both blocks
+	 * from kernel_map so zone allocations cannot overwrite the console. */
+	assert(!TEST_PAGE_SIZE_4K && low_global_vr_size == ARM_TT_L2_SIZE);
+	low_global_vr_size += ARM_TT_L2_SIZE;
+	assert(LOW_GLOBAL_BASE_ADDRESS + low_global_vr_size <=
+	    (gVirtBase & low_global_vr_mask));
+#endif
+
 	if (((gVirtBase & low_global_vr_mask) != LOW_GLOBAL_BASE_ADDRESS) && (region_select == 2)) {
 		*startp = LOW_GLOBAL_BASE_ADDRESS;
 		*size = low_global_vr_size;
 		ret = TRUE;
+#if defined(LITHIUM)
+		printf("lithium: low globals + framebuffer reserved (%llu MiB)\n",
+		    (unsigned long long)(*size >> 20));
+#endif
 	}
 
 	if (region_select == 3) {
