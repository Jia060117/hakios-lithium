Subject: lithium: measured UFS host and bounded read-only GPT probe

Adapted from ios-sailfish 6f27e41ff249f2680540ebe8ee5ab982c5e641c9 patches 0028/0034.
No SCSI write command; boot argument only probes before ordinary root matching.

diff --git a/bsd/dev/lithium_ufs.c b/bsd/dev/lithium_ufs.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/lithium_ufs.c
@@ -0,0 +1,548 @@
+/*
+ * LITHIUM internal UFS root device (read-only).
+ *
+ * The Qualcomm UFS host (UFSHCI 2.1) is left enabled with the link up by the
+ * bootloader, which loaded our boot image from it. This driver reuses that
+ * state: it points the transfer request list at its own memory (verifying the
+ * host took it before ringing any doorbell) and issues polled SCSI commands,
+ * one at a time, to LUN 0. It finds one GPT partition by name (boot-arg
+ * ufsroot=, default "userdata") and exposes it as the BSD disk ufsroot0
+ * (rufsroot0), with 512-byte logical sectors over the device's 4 KiB blocks.
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
+ * cleaned/invalidated around each command. Writes are refused.
+ */
+#if defined(ARM64_BOARD_CONFIG_LITHIUM)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <libkern/OSByteOrder.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#include "lithium_ufs_gpt.h"
+
+#define REG_CAP         0x00
+#define REG_VER         0x08
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (1u << 20)
+#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	struct {
+		uint32_t addr_lo, addr_hi, rsvd, dbc;
+	} prdt[PRDT_MAX];
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t disk_blocks;
+	bool failed;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} su;
+
+static LCK_GRP_DECLARE(lithium_ufs_grp, "lithium_ufs");
+static LCK_MTX_DECLARE(lithium_ufs_lock, &lithium_ufs_grp);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+/*
+ * One SCSI command in slot 0, data (if any) to/from the bounce buffer.
+ * Read direction only. Returns 0 or an errno.
+ */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+
+	/* An explicit command allowlist prevents accidental storage writes. */
+    if (su.failed || cdb_len > 16 || len > BOUNCE_SIZE ||
+        (cdb[0] != 0x00 && cdb[0] != 0x25 && cdb[0] != 0x28)) return EINVAL;
+    if (ufs_rd(REG_UTRLDBR) || ufs_rd(REG_UTRLBA) != (uint32_t)su.dma_pa ||
+        ufs_rd(REG_UTRLBAU) != (uint32_t)(su.dma_pa >> 32) ||
+        !(ufs_rd(REG_UTRLRSR) & 1)) return EBUSY;
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = len ? 0x40 : 0x00;        /* R: data in */
+	ucd->cmd[2] = su.lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+
+	utrd->dw0 = (1u << 28) | ((len ? 2u : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		uint32_t n = 0;
+		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
+			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
+			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
+			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			ucd->prdt[n].dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+	}
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	if (len) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			su.failed = true; /* Never reuse DMA after an uncompleted request. */
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("LITHIUM UFS: command 0x%02x timed out\n", cdb[0]);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	if (len) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[2] != su.lun ||
+	    ucd->resp[3] != su.tag || (ucd->resp[1] & 0x60) || ucd->resp[6] || ucd->resp[7]) {
+		printf("LITHIUM UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		return EIO;
+	}
+	return 0;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (!count || lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba >= su.disk_blocks || count > su.disk_blocks-lba) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+    const uint8_t *b=(const uint8_t *)(su.dma+DMA_BOUNCE);
+    struct lithium_gpt g;
+    int error=ufs_read_blocks(1,1);
+    if(error) return error;
+    int check=lg_header(b,su.disk_blocks,&g);
+    if(check) { printf("LITHIUM UFS: GPT header rejected %d\n",check); return ENXIO; }
+    error=ufs_read_blocks(g.entries_lba,(g.bytes+UFS_BLOCK-1)/UFS_BLOCK);
+    if(error) return error;
+    check=lg_partition(b,&g,want,&su.first_block,&su.nblocks);
+    if(check) { printf("LITHIUM UFS: GPT entries rejected %d\n",check); return ENXIO; }
+    if(strcmp(want,"userdata") || su.first_block != 98304ULL ||
+        su.nblocks != 61208543ULL) {
+        printf("LITHIUM UFS: partition differs from measured MIX geometry\n"); return ENXIO;
+    }
+    printf("LITHIUM UFS: GPT header + entries CRC verified; userdata bounds match\n");
+    return 0;
+}
+
+static int
+ufs_capacity(void)
+{
+    const uint8_t cdb[10]={0x25};
+    int error=ufs_scsi(cdb,sizeof(cdb),8);
+    if(error) return error;
+    const uint8_t *b=(const uint8_t *)(su.dma+DMA_BOUNCE);
+    uint32_t last=OSReadBigInt32(b,0), size=OSReadBigInt32(b,4);
+    printf("LITHIUM UFS: LUN0 last LBA 0x%x block bytes %u\n",last,size);
+    if(size!=UFS_BLOCK || last==UINT32_MAX || (uint64_t)last+1!=61306880ULL) return ENXIO;
+    su.disk_blocks=(uint64_t)last+1;
+    error=ufs_read_blocks(0,1);
+    if(error) return error;
+    if(b[510]!=0x55 || b[511]!=0xaa || b[450]!=0xee) return ENXIO;
+    return 0;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+    printf("LITHIUM UFS: ver 0x%x cap 0x%x hce 0x%x hcs 0x%x DMA 0x%llx\n",
+        ufs_rd(REG_VER),ufs_rd(REG_CAP),hce,hcs,su.dma_pa);
+    if (((su.dma_pa+DMA_SIZE-1)>>32) && !(ufs_rd(REG_CAP)&(1u<<24))) return ENXIO;
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("LITHIUM UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("LITHIUM UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("LITHIUM UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+lithium_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+lithium_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+lithium_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&lithium_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(su.first_block + lba, blocks);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const void *)(su.dma + DMA_BOUNCE + skip), want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&lithium_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+lithium_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+lithium_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return lithium_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+lithium_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return lithium_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+lithium_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+lithium_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(lithium_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+lithium_ufs_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw lithium_ufs_bdevsw = {
+	.d_open     = lithium_ufs_open,
+	.d_close    = lithium_ufs_close,
+	.d_strategy = lithium_ufs_strategy,
+	.d_ioctl    = lithium_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = lithium_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw lithium_ufs_cdevsw = {
+	.d_open       = lithium_ufs_open,
+	.d_close      = lithium_ufs_close,
+	.d_read       = lithium_ufs_read,
+	.d_write      = lithium_ufs_write,
+	.d_ioctl      = lithium_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+lithium_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/lithium-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("LITHIUM UFS: no /lithium-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+
+	if (reg[0] != 0x624000 || reg[1] != 0x2500) return ENXIO;
+    printf("LITHIUM UFS: mapping measured controller 0x624000, read-only probe\n");
+    su.regs = ml_io_map(reg[0], reg[1]);
+    if (!su.regs) return ENOMEM;
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("LITHIUM UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&lithium_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* The first command after the bootloader may report a unit attention. */
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0)); i++) {
+		}
+	}
+	if (!error) error = ufs_capacity();
+    if (!error) {
+        error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&lithium_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &lithium_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &lithium_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+		printf("LITHIUM UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, read-only\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20);
+    error=ufs_read_blocks(su.first_block,1);
+    if(error) return error;
+    const uint8_t *sb=(const uint8_t *)(su.dma+DMA_BOUNCE+1024);
+    printf("LITHIUM UFS: userdata first block CRC32 0x%x; superblock 0x%x ext magic 0x%x\n",
+        lg_crc((const uint8_t *)(su.dma+DMA_BOUNCE),4096,0),lg_le32(sb),
+        (unsigned)sb[56]|(unsigned)sb[57]<<8);
+	return 0;
+}
+
+/* Future read-only root hook; probe does not claim to mount a filesystem. */
+int lithium_ufs_rootdev(dev_t *dev);
+
+int
+lithium_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = lithium_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	su.ready = true;
+	*dev = su.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_LITHIUM */
diff --git a/bsd/dev/lithium_ufs_gpt.h b/bsd/dev/lithium_ufs_gpt.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/lithium_ufs_gpt.h
@@ -0,0 +1,77 @@
+/* Bounded GPT parsing shared by the native driver and its host validation.
+ * Only the primary GPT on a 4096-byte logical-block disk is accepted.
+ */
+#ifndef LITHIUM_UFS_GPT_H
+#define LITHIUM_UFS_GPT_H
+struct lithium_gpt {
+    uint64_t entries_lba, first_usable, last_usable;
+    uint32_t count, bytes, entries_crc;
+};
+static uint32_t lg_le32(const uint8_t *p)
+{ return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24; }
+static uint64_t lg_le64(const uint8_t *p)
+{ return (uint64_t)lg_le32(p) | (uint64_t)lg_le32(p+4)<<32; }
+static uint32_t lg_crc(const uint8_t *p, uint32_t n, int header)
+{
+    uint32_t crc = 0xffffffffu;
+    for (uint32_t i=0; i<n; ++i) {
+        crc ^= (header && i>=16 && i<20) ? 0 : p[i];
+        for (unsigned j=0; j<8; ++j) crc = (crc>>1) ^ (0xedb88320u & (0u-(crc&1)));
+    }
+    return ~crc;
+}
+static int lg_header(const uint8_t *b, uint64_t blocks, struct lithium_gpt *g)
+{
+    const uint8_t sig[8] = {'E','F','I',' ','P','A','R','T'};
+    for (unsigned i=0;i<8;++i) if (b[i]!=sig[i]) return 1;
+    uint32_t size=lg_le32(b+12), count=lg_le32(b+80);
+    if (blocks<8 || lg_le32(b+8)!=0x10000 || size<92 || size>4096 ||
+        lg_le32(b+20)!=0 || lg_crc(b,size,1)!=lg_le32(b+16) ||
+        lg_le64(b+24)!=1 || lg_le64(b+32)!=blocks-1 ||
+        lg_le32(b+84)!=128 || count==0 || count>(1u<<20)/128) return 2;
+    g->count=count; g->bytes=count*128; g->entries_lba=lg_le64(b+72);
+    g->first_usable=lg_le64(b+40); g->last_usable=lg_le64(b+48);
+    g->entries_crc=lg_le32(b+88);
+    uint64_t table_blocks=(g->bytes+4095u)/4096u;
+    if (g->entries_lba<2 || g->entries_lba>=blocks ||
+        table_blocks>blocks-g->entries_lba ||
+        g->first_usable<g->entries_lba+table_blocks ||
+        g->last_usable<g->first_usable ||
+        g->last_usable>=blocks-1-table_blocks) return 3;
+    return 0;
+}
+static int lg_used(const uint8_t *e)
+{ uint8_t x=0; for(unsigned i=0;i<16;++i) x|=e[i]; return x!=0; }
+static int lg_name(const uint8_t *e, const char *want)
+{
+    for(unsigned i=0;i<36;++i) {
+        uint16_t ch=(uint16_t)e[56+2*i] | (uint16_t)e[57+2*i]<<8;
+        if (ch!=(uint8_t)want[i]) return 0;
+        if (!ch) return 1;
+    }
+    return 0;
+}
+static int lg_partition(const uint8_t *b, const struct lithium_gpt *g,
+    const char *want, uint64_t *first, uint64_t *count)
+{
+    if (lg_crc(b,g->bytes,0)!=g->entries_crc) return 4;
+    int found=-1;
+    for(uint32_t i=0;i<g->count;++i) {
+        const uint8_t *e=b+i*128;
+        if (!lg_used(e)) continue;
+        uint64_t a=lg_le64(e+32), z=lg_le64(e+40);
+        if (a<g->first_usable || z<a || z>g->last_usable) return 5;
+        if (lg_name(e,want)) {
+            if(found>=0) return 6;
+            found=(int)i; *first=a; *count=z-a+1;
+        }
+    }
+    if(found<0) return 7;
+    for(uint32_t i=0;i<g->count;++i) {
+        const uint8_t *e=b+i*128;
+        if((int)i==found || !lg_used(e)) continue;
+        if(lg_le64(e+32)<*first+*count && lg_le64(e+40)>=*first) return 8;
+    }
+    return 0;
+}
+#endif
