--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -206,3 +206,15 @@
 
 include $(MakeInc_rule)
 include $(MakeInc_dir)
+
+# Portable MD5 for the legacy API used by HFS volume UUIDs.
+ifeq ($(CURRENT_MACHINE_CONFIG),LITHIUM)
