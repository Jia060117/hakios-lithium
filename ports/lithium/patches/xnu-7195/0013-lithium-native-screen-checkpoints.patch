diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -459,6 +459,26 @@
 
 	mov		x20, x0
 	mov		x21, #0
+#if defined(LITHIUM)
+    /* Real XNU physical entry: white BGR24 band, preserve boot args in x20. */
+    MOV64 x0, (0x83401000 + 2008 * 3240)
+    mov w1, #255
+    mov x2, #32
+    mov x4, #3240
+Llithium_mark_row:
+    mov x3, #48
+    mov x5, x0
+Llithium_mark_pixel:
+    strb w1, [x5], #1
+    strb w1, [x5], #1
+    strb w1, [x5], #1
+    subs x3, x3, #1
+    b.ne Llithium_mark_pixel
+    add x0, x0, x4
+    subs x2, x2, #1
+    b.ne Llithium_mark_row
+    dsb sy
+#endif
 
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
@@ -605,6 +625,16 @@
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(LITHIUM)
+    /* Both low splash and upper DDR use L1 slot 0 with 16K / 39-bit VA. */
+    MOV64 x10, 0x82000000
+    MOV64 x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+    orr x11, x11, x10
+    and x12, x10, #(ARM_TT_L2_INDEX_MASK)
+    lsr x12, x12, #(ARM_TT_L2_SHIFT)
+    add x13, x25, #(2 * PGBYTES)
+    str x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
 	/* Ensure TTEs are visible */
 	dsb		ish
 
