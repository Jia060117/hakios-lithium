         -Warray-bounds-pointer-arithmetic
 SFLAGS+= -include meta_features.h
+
+# 7195-era libpthread provider, staged with its existing license headers.
+ifeq ($(CURRENT_MACHINE_CONFIG),LITHIUM)
+LITHIUM_PTHREAD_ROOT = $(SOURCE_DIR)/bsd/pthread/lithium_libpthread
+LITHIUM_PTHREAD_INC = -I$(LITHIUM_PTHREAD_ROOT) -I$(LITHIUM_PTHREAD_ROOT)/private -I$(LITHIUM_PTHREAD_ROOT)/include $(LITHIUM_EMPTY)
+lithium_pthread_init.o_INCFLAGS = $(LITHIUM_PTHREAD_INC)
+lithium_pthread_support.o_INCFLAGS = $(LITHIUM_PTHREAD_INC)
+lithium_pthread_synch.o_INCFLAGS = $(LITHIUM_PTHREAD_INC)
+endif
 
