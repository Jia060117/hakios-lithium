Subject: crypto: describe the SHA256 constant table as Mach-O data

The bytes stay identical. This makes instruction scans distinguish
the 64 round constants from code in the executable hibernation section.

--- a/osfmk/arm64/corecrypto/sha256_compress_arm64.s
+++ b/osfmk/arm64/corecrypto/sha256_compress_arm64.s
@@ -127,6 +127,7 @@
 
     .p2align  4
 
+    .data_region
 K256:
     .long   0x428a2f98
     .long   0x71374491
@@ -192,6 +193,7 @@
     .long   0xa4506ceb
     .long   0xbef9a3f7
     .long   0xc67178f2
+    .end_data_region
 
 
     .p2align  4
