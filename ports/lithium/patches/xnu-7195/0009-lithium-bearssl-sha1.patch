Subject: crypto: backport sailfish portable SHA1 to the 7195 legacy API

Source: 6f27e41ff249f2680540ebe8ee5ab982c5e641c9, patch 0032.
BearSSL is staged at its pinned commit by the isolated build script.

--- a/libkern/crypto/corecrypto_sha1.c
+++ b/libkern/crypto/corecrypto_sha1.c
@@ -15,6 +15,62 @@
 {
 	ctx->c.b64[0] = count;
 }
+
+#if defined(ARM64_BOARD_CONFIG_LITHIUM)
+/*
+ * LITHIUM has no corecrypto kext (g_crypto_funcs stays NULL). SHA-1 uses
+ * BearSSL's portable implementation (libkern/crypto/lithium_sha1.c), with
+ * SHA1_CTX carrying exactly its state: chaining value, byte count and the
+ * partial block, converted around each call like the corecrypto path does.
+ */
+#include "lithium_bearssl/inc/bearssl_hash.h"
+
+static void
+SHA1ToBr(SHA1_CTX *sha1_ctx, br_sha1_context *br_ctx)
+{
+	br_sha1_init(br_ctx);
+	memcpy(br_ctx->val, sha1_ctx->h.b32, sizeof(br_ctx->val));
+	br_ctx->count = getCount(sha1_ctx);
+	memcpy(br_ctx->buf, sha1_ctx->m.b8, sizeof(br_ctx->buf));
+}
+
+static void
+BrToSHA1(const br_sha1_context *br_ctx, SHA1_CTX *sha1_ctx)
+{
+	memcpy(sha1_ctx->h.b32, br_ctx->val, sizeof(sha1_ctx->h.b32));
+	setCount(sha1_ctx, br_ctx->count);
+	memcpy(sha1_ctx->m.b8, br_ctx->buf, sizeof(sha1_ctx->m.b8));
+}
+
+void
+SHA1Init(SHA1_CTX *ctx)
+{
+	br_sha1_context br_ctx;
+
+	br_sha1_init(&br_ctx);
+	BrToSHA1(&br_ctx, ctx);
+}
+
+void
+SHA1Update(SHA1_CTX *ctx, const void *data, size_t len)
+{
+	br_sha1_context br_ctx;
+
+	SHA1ToBr(ctx, &br_ctx);
+	br_sha1_update(&br_ctx, data, len);
+	BrToSHA1(&br_ctx, ctx);
+}
+
+void
+SHA1Final(void *digest, SHA1_CTX *ctx)
+{
+	br_sha1_context br_ctx;
+
+	SHA1ToBr(ctx, &br_ctx);
+	br_sha1_out(&br_ctx, digest);
+}
+
+#else /* !ARM64_BOARD_CONFIG_LITHIUM */
 
 /* Copy a ccdigest ctx into a legacy SHA1 context */
 static void
@@ -69,6 +125,8 @@
 	ccdigest_final(di, di_ctx, digest);
 }
 
+#endif /* !ARM64_BOARD_CONFIG_LITHIUM */
+
 #ifdef XNU_KERNEL_PRIVATE
 void
 SHA1UpdateUsePhysicalAddress(SHA1_CTX *ctx, const void *data, size_t len)
