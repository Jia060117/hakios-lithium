--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -18,6 +18,18 @@
 #
 CFLAGS+= -include meta_features.h -DLIBKERN_KERNEL_PRIVATE -DOSALLOCDEBUG=1
 SFLAGS+= -include meta_features.h
+
+
+# Pinned BearSSL; prevent SIMD use in the kernel SHA1 path.
+ifeq ($(CURRENT_MACHINE_CONFIG),LITHIUM)
+lithium_sha1.o_INCFLAGS = -I$(SOURCE_DIR)/libkern/crypto/lithium_bearssl/inc -I$(SOURCE_DIR)/libkern/crypto/lithium_bearssl/src $(LITHIUM_EMPTY)
+lithium_sha1.o_CFLAGS_ADD += -mgeneral-regs-only
+lithium_dec32be.o_INCFLAGS = -I$(SOURCE_DIR)/libkern/crypto/lithium_bearssl/inc -I$(SOURCE_DIR)/libkern/crypto/lithium_bearssl/src $(LITHIUM_EMPTY)
+lithium_dec32be.o_CFLAGS_ADD += -mgeneral-regs-only
+lithium_enc32be.o_INCFLAGS = -I$(SOURCE_DIR)/libkern/crypto/lithium_bearssl/inc -I$(SOURCE_DIR)/libkern/crypto/lithium_bearssl/src $(LITHIUM_EMPTY)
+lithium_enc32be.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_sha1.o_CFLAGS_ADD += -mgeneral-regs-only
+endif
 
 # Runtime support functions don't interact well with LTO (9294679)
