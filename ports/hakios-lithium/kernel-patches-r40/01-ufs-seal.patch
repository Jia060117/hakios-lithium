+/*
+ * Sleepable, one shot after the caller proves non-forced HFS unmount and
+ * journal completion on data_dev. The caller holds the mount/writer admission
+ * fence and has drained filesystem I/O. Core 0 is still servicing the mailbox.
+ * The result is a mailbox completion cookie. Controller proof belongs to UEFI.
+ */
+int
+hakios_ufs_seal_for_return(dev_t data_dev, uint32_t *flush_request)
+{
+	uint32_t native = 0, rawbench = 0, seq = 0, part;
+	int error = 0;
+
+	if (flush_request == NULL) {
+		return EINVAL;
+	}
+	*flush_request = 0;
+	/* Native requests can run without ufs_lock. Exclude the entire profile. */
+	if ((PE_parse_boot_argn("ufs_native", &native, sizeof(native)) && native != 0) ||
+	    (PE_parse_boot_argn("ufs_rawbench", &rawbench, sizeof(rawbench)) && rawbench == 1)) {
+		return ENOTSUP;
+	}
+	lck_mtx_lock(&ufs_data_mtx);
+	lck_mtx_lock(&ufs_write_mtx);
+	lck_mtx_lock(&ufs_lock);
+	if (ufs_admission != UFS_ADMISSION_OPEN) {
+		error = EALREADY;
+		goto out;
+	}
+	if (!ufs_is_data(data_dev) || ufs_bmajor < 0 || data_dev != makedev(ufs_bmajor, UFS_DATA_MINOR)) {
+		error = ENXIO;
+		goto out;
+	}
+	part = (uint32_t)ufs_write_part;
+	if (part >= ufs_parts || ufs_page->write_part_plus_one != part + 1 ||
+	    ufs_page->write_first != UFS_WRITE_FIRST || ufs_data_op() != BLOCK_OP_WRITE_FAST) {
+		error = ENOTSUP;
+		goto out;
+	}
+	if (!ufs_data_used || ufs_var_busy_pid != 0 || ufs_raw_write_seen ||
+	    ufs_native_on || ufs_native_mapped || ufs_write_was_native || ufshc_list_in() ||
+	    ufs_page->kernel_native.list_in != 0 || ufs_page->loader_native.take_back != 0) {
+		error = EBUSY;
+		goto out;
+	}
+
+	/* From here onwards, a failure leaves the storage closed without a cookie. */
+	ufs_admission = UFS_ADMISSION_CLOSED;
+	if (ufs_dead || ufs_errors != 0 || ufs_flush_failed || ufs_data_write_failed ||
+	    ufs_page->ask.request != ufs_seq || ufs_page->answer.answered != ufs_seq) {
+		error = EIO;
+		goto out;
+	}
+	if (ufs_seq == UINT32_MAX) {           /* reserve zero for an absent receipt */
+		error = EOVERFLOW;
+		goto out;
+	}
+	error = ufs_request_r13_impl(BLOCK_OP_FLUSH, part, UFS_WRITE_FIRST, 1, NULL, NULL, &seq);
+	if (error == 0) {
+		if (ufs_page->loader_native.take_back != 0) {
+			error = EIO;
+			goto out;
+		}
+		ufs_admission = UFS_ADMISSION_SEALED;
+		*flush_request = seq;
+	}
+out:
+	lck_mtx_unlock(&ufs_lock);
+	lck_mtx_unlock(&ufs_write_mtx);
+	lck_mtx_unlock(&ufs_data_mtx);
+	return error;
+}
