diff --git a/bsd/hfs/hfs_return.h b/bsd/hfs/hfs_return.h
new file mode 100644
--- /dev/null
+++ b/bsd/hfs/hfs_return.h
@@ -0,0 +1,44 @@
+/*
+ * Internal Lithium HFS return API. Enable LITHIUM_ARMV8_0 at build
+ * time and ufs_return=1 at boot time.
+ * Only the first HFS mount of the devfs node ufs_darwin_data is admitted.
+ */
+#ifndef LITHIUM_HFS_RETURN_RECEIPT_H
+#define LITHIUM_HFS_RETURN_RECEIPT_H
+#include <sys/types.h>
+#include <sys/errno.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <stdbool.h>
+
+#if defined(LITHIUM_ARMV8_0)
+/*
+ * Sleepable kernel shutdown caller: stop process relaunch and swaps, release
+ * Data cwd/root/file/mmap references, exclude mounts/remounts/raw writers.
+ * cookie is the nonzero caller boot/session cookie. One nonforced attempt per admission.
+ * Zero means checked journal close AND complete same-generation dounmount.
+ * A nonzero result always prohibits automatic return, even if VFS has already
+ * removed the mount. Never retry or remount on the basis of this return value.
+ * After zero, keep the writer fence and call hakios_ufs_seal_for_return()
+ * separately; this API neither seals UFS nor claims controller persistence.
+ */
+int lithium_hfs_return_unmount(dev_t expected_dev, uint64_t cookie);
+
+/* Internal producers; caller must own a valid mount/vnode lifetime. */
+bool lithium_hfs_return_tracks(mount_t mp);
+int lithium_hfs_return_note(mount_t mp, int error);
+int lithium_hfs_return_error(mount_t mp);
+/* mp is an identity token only here: dounmount may already have freed it. */
+void lithium_hfs_return_vfs_done(mount_t mp, uint64_t generation,
+    int flags, int error);
+#else
+static inline bool lithium_hfs_return_tracks(mount_t mp)
+{ (void)mp; return false; }
+static inline int lithium_hfs_return_note(mount_t mp, int error)
+{ (void)mp; return error; }
+static inline int lithium_hfs_return_error(mount_t mp)
+{ (void)mp; return ENOTSUP; }
+static inline int lithium_hfs_return_unmount(dev_t dev, uint64_t cookie)
+{ (void)dev; (void)cookie; return ENOTSUP; }
+#endif
+#endif
