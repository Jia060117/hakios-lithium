+
+/* Included in hfs_vfsops.c, after its existing headers, with no new build unit. */
+#if defined(LITHIUM_ARMV8_0)
+/*
+ * Published once, before this Data mount can expose vnodes. Device, pointer
+ * and mount ID never change. The shutdown caller binds its cookie once it
+ * claims the attempt. No lock is taken from journal completion or vclean.
+ */
+static struct {
+	mount_t mp;
+	uint64_t generation;
+	dev_t dev;
+	uint64_t cookie;
+	fsid_t fsid;
+	journal *jnl;
+	int admitted, ready, called, first_error, hfs_done, vfs_done;
+} lithium_hfs_return;
+
+bool
+lithium_hfs_return_tracks(mount_t mp)
+{
+	return mp != NULL &&
+	    __atomic_load_n(&lithium_hfs_return.mp, __ATOMIC_ACQUIRE) == mp &&
+	    mp->mnt_mount_id == lithium_hfs_return.generation;
+}
+
+int
+lithium_hfs_return_note(mount_t mp, int error)
+{
+	if (error != 0 && lithium_hfs_return_tracks(mp)) {
+		int zero = 0;
+		int saved = error > 0 ? error : EIO; /* legacy journal -1 */
+		(void)__atomic_compare_exchange_n(&lithium_hfs_return.first_error,
+		    &zero, saved, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+	}
+	return error; /* preserve the original ABI/error convention */
+}
+
+int
+lithium_hfs_return_error(mount_t mp)
+{
+	if (!lithium_hfs_return_tracks(mp))
+		return ENOTSUP;
+	return __atomic_load_n(&lithium_hfs_return.first_error, __ATOMIC_ACQUIRE);
+}
+
+static int
+lithium_hfs_return_admit(mount_t mp, vnode_t devvp)
+{
+	int enabled = 0;
+	int zero = 0;
+	const char *name;
+	bool data;
+
+	if (!PE_parse_boot_argn("ufs_return", &enabled, sizeof(enabled)) ||
+	    enabled != 1 || devvp == NULLVP)
+		return 0;
+	name = vnode_getname(devvp);
+	data = name && strcmp(name, "ufs_darwin_data") == 0;
+	if (name)
+		vnode_putname(name);
+	if (!data)
+		return 0;
+	if ((vfs_flags(mp) & (MNT_UPDATE | MNT_RDONLY | MNT_ROOTFS)) ||
+	    !vnode_isblk(devvp))
+		return ENOTSUP;
+	if (!__atomic_compare_exchange_n(&lithium_hfs_return.admitted,
+	    &zero, 1, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+		return EALREADY;
+	lithium_hfs_return.dev = vnode_specrdev(devvp);
+	lithium_hfs_return.generation = mp->mnt_mount_id;
+	__atomic_store_n(&lithium_hfs_return.mp, mp, __ATOMIC_RELEASE);
+	return 0;
+}
+
+static int
+lithium_hfs_return_ready(mount_t mp, int error)
+{
+	struct hfsmount *hfsmp;
+
+	if (!lithium_hfs_return_tracks(mp))
+		return error;
+	(void)lithium_hfs_return_note(mp, error);
+	if (error)
+		return error;
+	hfsmp = VFSTOHFS(mp);
+	if (__atomic_load_n(&lithium_hfs_return.ready, __ATOMIC_ACQUIRE)) {
+		/* A remount cannot replace the admitted journal instance. */
+		if (!hfsmp || !hfsmp->hfs_devvp || hfsmp->jnl != lithium_hfs_return.jnl ||
+		    vnode_specrdev(hfsmp->hfs_devvp) != lithium_hfs_return.dev)
+			(void)lithium_hfs_return_note(mp, ESTALE);
+		return error;
+	}
+	if (!hfsmp || !hfsmp->jnl || hfsmp->jnl->jdev != hfsmp->hfs_devvp ||
+	    hfsmp->jnl->fsdev != hfsmp->hfs_devvp ||
+	    (hfsmp->hfs_flags & HFS_READ_ONLY) ||
+	    (hfsmp->vcbAtrb & kHFSVolumeInconsistentMask)) {
+		(void)lithium_hfs_return_note(mp, ENOTSUP);
+		return error; /* don't change successful mount's normal result */
+	}
+	lithium_hfs_return.fsid = vfs_statfs(mp)->f_fsid;
+	lithium_hfs_return.jnl = hfsmp->jnl;
+	__atomic_store_n(&lithium_hfs_return.ready, 1, __ATOMIC_RELEASE);
+	return error;
+}
+
+void
+lithium_hfs_return_vfs_done(mount_t mp, uint64_t generation, int flags, int error)
+{
+	int zero = 0;
+	int saved;
+	/* Do not dereference mp: the covered-vnode path can already free it. */
+	if (mp != __atomic_load_n(&lithium_hfs_return.mp, __ATOMIC_ACQUIRE) ||
+	    generation != lithium_hfs_return.generation)
+		return;
+	saved = error ? error : ((flags & MNT_FORCE) ||
+	    !__atomic_load_n(&lithium_hfs_return.called, __ATOMIC_ACQUIRE) ||
+	    !__atomic_load_n(&lithium_hfs_return.hfs_done, __ATOMIC_ACQUIRE)
+	    ? EIO : 0);
+	if (saved)
+		(void)__atomic_compare_exchange_n(&lithium_hfs_return.first_error,
+		    &zero, saved > 0 ? saved : EIO, false,
+		    __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+	__atomic_store_n(&lithium_hfs_return.vfs_done, error == 0 ? 1 : -1,
+	    __ATOMIC_RELEASE);
+}
+
+int
+lithium_hfs_return_unmount(dev_t expected_dev, uint64_t cookie)
+{
+	mount_t mp;
+	struct hfsmount *hfsmp;
+	int zero = 0, error;
+
+	if (cookie == 0)
+		return EINVAL;
+	if (!__atomic_load_n(&lithium_hfs_return.ready, __ATOMIC_ACQUIRE))
+		return ENOTSUP;
+	if (expected_dev != lithium_hfs_return.dev)
+		return EINVAL;
+	if (__atomic_load_n(&lithium_hfs_return.called, __ATOMIC_ACQUIRE) ||
+	    __atomic_load_n(&lithium_hfs_return.vfs_done, __ATOMIC_ACQUIRE))
+		return EALREADY;
+	/*
+	 * Same lookup/iteration-to-mount-ref handoff as vfs_unmountbyfsid().
+	 * Do not keep an extra ref across dounmount's mount_refdrain().
+	 */
+	mp = mount_list_lookupby_fsid(&lithium_hfs_return.fsid, 0, 1);
+	if (!mp)
+		return ENOENT;
+	if (!lithium_hfs_return_tracks(mp) || !mp->mnt_devvp ||
+	    vnode_specrdev(mp->mnt_devvp) != expected_dev ||
+	    (mp->mnt_flag & (MNT_ROOTFS | MNT_RDONLY | MNT_UPDATE)) ||
+	    (mp->mnt_kern_flag & MNTK_BACKS_ROOT)) {
+		mount_iterdrop(mp);
+		return ESTALE;
+	}
+	/* Caller has already fenced mount/remount and process/raw writers. */
+	hfsmp = VFSTOHFS(mp);
+	if (!hfsmp || hfsmp->jnl != lithium_hfs_return.jnl ||
+	    hfsmp->hfs_freeze_state != HFS_THAWED ||
+	    (hfsmp->hfs_flags & (HFS_READ_ONLY | HFS_IN_CHANGEFS))) {
+		mount_iterdrop(mp);
+		return EBUSY;
+	}
+	if (!__atomic_compare_exchange_n(&lithium_hfs_return.called, &zero, 1,
+	    false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		mount_iterdrop(mp);
+		return EALREADY;
+	}
+	lithium_hfs_return.cookie = cookie;
+	mount_ref(mp, 0);
+	mount_iterdrop(mp);
+	/* dounmount consumes this ref. flags=0: no force/no fallback. */
+	error = dounmount(mp, 0, 1, vfs_context_kernel());
+	if (error)
+		return error;
+	if (__atomic_load_n(&lithium_hfs_return.vfs_done, __ATOMIC_ACQUIRE) != 1 ||
+	    !__atomic_load_n(&lithium_hfs_return.hfs_done, __ATOMIC_ACQUIRE))
+		return EIO;
+	return __atomic_load_n(&lithium_hfs_return.first_error, __ATOMIC_ACQUIRE);
+}
+#endif
 
