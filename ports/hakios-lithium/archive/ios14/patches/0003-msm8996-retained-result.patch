+#if defined(LITHIUM_ARMV8_0) && defined(GENERIC_GIC_V3_IRQ)
+/* Single boot-core MIX test: reuse the existing callback and return-log channel. */
+static uint64_t lithium_start_ticks, lithium_start_irqs, lithium_clock_hz;
+static uint64_t lithium_previous_irqs, lithium_min_irq_step;
+static uint32_t lithium_timer_samples, lithium_stalled_samples;
+
+static uint64_t
+lithium_counter_ticks(void)
+{
+    __asm__ volatile ("isb" ::: "memory");
+    return __builtin_arm_rsr64("CNTVCT_EL0");
+}
+
+static uint64_t
+lithium_elapsed_ms(uint64_t ticks)
+{
+    if (lithium_clock_hz == 0 || ticks < lithium_start_ticks) return 0;
+    uint64_t delta = ticks - lithium_start_ticks;
+    return (delta / lithium_clock_hz) * 1000 + (delta % lithium_clock_hz) * 1000 / lithium_clock_hz;
+}
+
+static void
+lithium_timer_sample(void)
+{
+    char line[256];
+    uint64_t irqs = lithium_vtimer_irq_count(), ticks = lithium_counter_ticks();
+    uint64_t step = irqs - lithium_previous_irqs;
+    if (irqs <= lithium_previous_irqs) lithium_stalled_samples++;
+    if (lithium_timer_samples == 0 || step < lithium_min_irq_step) lithium_min_irq_step = step;
+    lithium_previous_irqs = irqs;
+    lithium_timer_samples++;
+    snprintf(line, sizeof(line), "\nLITHIUM TIMER ppi27=%llu heartbeat=%llu elapsed_ms=%llu samples=%u stalled=%u\n",
+        (unsigned long long)irqs, (unsigned long long)loader_live.heartbeat,
+        (unsigned long long)lithium_elapsed_ms(ticks), lithium_timer_samples, lithium_stalled_samples);
+    /* printf's screen output alone was absent from R8's returned log. Save explicitly. */
+    loader_log_puts(line);
+    printf("%s", line);
+}
+
+static void
+lithium_save_final_measurements(void)
+{
+    char line[256];
+    uint64_t ticks = lithium_counter_ticks(), irqs = lithium_vtimer_irq_count();
+    unsigned valid = lithium_clock_hz == 19200000 && lithium_start_ticks != 0 && ticks >= lithium_start_ticks;
+    snprintf(line, sizeof(line), "\nLITHIUM CLOCK ticks_start=%llu ticks_end=%llu freq_hz=%llu elapsed_ms=%llu valid=%u\n",
+        (unsigned long long)lithium_start_ticks, (unsigned long long)ticks,
+        (unsigned long long)lithium_clock_hz, (unsigned long long)lithium_elapsed_ms(ticks), valid);
+    loader_log_puts(line);
+    snprintf(line, sizeof(line), "LITHIUM FINAL ppi27_start=%llu ppi27_end=%llu irq_delta=%llu samples=%u stalled=%u min_step=%llu\n",
+        (unsigned long long)lithium_start_irqs, (unsigned long long)irqs,
+        (unsigned long long)(irqs - lithium_start_irqs), lithium_timer_samples,
+        lithium_stalled_samples, (unsigned long long)lithium_min_irq_step);
+    loader_log_puts(line);
+}
+#endif
+
 /*
