+#if defined(HAKIOS_LITHIUM)
+/* Raw logs stay in compose_logs(). The screen needs bounded text, not stackshot bytes. */
+static const char *
+lithium_last_line(const char *log, uint64_t bytes, const char *prefix)
+{
+	const char *found = NULL;
+	uint64_t width = str_len(prefix);
+	for (uint64_t i = 0; i + width <= bytes; i++) {
+		if ((i == 0 || log[i - 1] == '\n') && memcmp(log + i, prefix, width) == 0) found = log + i;
+	}
+	return found;
+}
+
+static void
+lithium_show_line(const char *line, const char *end)
+{
+	if (line == NULL) return;
+	for (unsigned i = 0; line < end && *line != '\n' && i < 400; line++, i++) {
+		unsigned char c = (unsigned char)*line;
+		put_char(c >= 32 && c < 127 ? (char)c : '.');
+	}
+	put_char('\n');
+}
+
+static void
+lithium_return_screen(const char *log, uint64_t bytes)
+{
+	((efi_status (EFIAPI *)(efi_text_output *, uint8_t))ST->con_out->reset)(ST->con_out, 0);
+	print("LITHIUM RETURN LOG %d BYTES\n", bytes);
+	if (log == NULL) return;
+	const char *panic_line = lithium_last_line(log, bytes, "panic(cpu ");
+	const char *timed = lithium_last_line(log, bytes, "--- loader_return_after expired ---");
+	print(panic_line != NULL ? "KERNEL PANIC CAUSE:\n" :
+	    timed != NULL ? "KERNEL TIMED RETURN OBSERVED\n" : "RETURN CAUSE NOT CAPTURED\n");
+	lithium_show_line(panic_line, log + bytes);
+	lithium_show_line(lithium_last_line(log, bytes, "LITHIUM TIMER "), log + bytes);
+	lithium_show_line(lithium_last_line(log, bytes, "LITHIUM SELECT "), log + bytes);
+	lithium_show_line(lithium_last_line(log, bytes, "LITHIUM HELLO "), log + bytes);
+	print("RAW LOG RETAINED IN RAM; SCREEN SHOWS TEXT SUMMARY\n");
+}
+#endif
