+@@ -805,10 +805,18 @@
+  *	Thread wait timer expiration.
+  *	Runs in timer interrupt context with interrupts disabled.
+  */
++#if defined(LITHIUM_ARMV8_0)
++#include "../../../../devices/lithium/diagnostics/cpu-sched-r37.inc"
++#include "../../../../devices/lithium/diagnostics/cpu-slowcores-r37.inc"
++#endif
++
+ void
+ thread_timer_expire(void *p0, __unused void *p1)
+ {
+ 	thread_t thread = (thread_t)p0;
++#if defined(LITHIUM_ARMV8_0)
++	lithium_sched_r37_expiry(thread, (unsigned)cpu_number());
++#endif
+ 
+ 	assert_thread_magic(thread);
+ 
+@@ -3105,6 +3113,10 @@
+ 
+ 			self->reason = reason;
+ 
