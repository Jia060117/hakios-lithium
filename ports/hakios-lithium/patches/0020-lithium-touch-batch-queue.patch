+int
+hakios_touch_post_batch(const struct hakios_touch *events, uint32_t count)
+{
+	struct hakios_touch staged[HAKIOS_TOUCH_BATCH_MAX];
+	struct hakios_touch *t;
+	uint32_t i, used;
+	uint64_t frame_time;
+
+	if (events == NULL || count == 0 || count > HAKIOS_TOUCH_BATCH_MAX) {
+		return EINVAL;
+	}
+	/* Stage and validate the complete input before acquiring the queue lock. */
+	for (i = 0; i < count; i++) {
+		staged[i] = events[i];
+		if (staged[i].type < HAKIOS_TOUCH_DOWN || staged[i].type > HAKIOS_TOUCH_UP) {
+			return EINVAL;
+		}
+	}
+
+	lck_mtx_lock(&touch_lock);
+	/* Unsigned subtraction intentionally permits head/tail counters to wrap. */
+	used = touch_tail - touch_head;
+	if (used > TOUCH_QUEUE || count > TOUCH_QUEUE - used) {
+		lck_mtx_unlock(&touch_lock);
+		return ENOBUFS;
+	}
+
+	frame_time = mach_absolute_time();
+	for (i = 0; i < count; i++) {
+		t = &touch_queue[touch_tail++ % TOUCH_QUEUE];
+		*t = staged[i];
+		t->time = frame_time;
+		/* Keep the legacy per-event touch-feel cadence; queue time remains frame_time. */
+		touch_feel_add(t->type, t->finger, mach_absolute_time());
+		if (latency_lines()) {
+			uint64_t ns;
+
+			absolutetime_to_nanoseconds(t->time, &ns);
+			hakios_tl("tl: p %u %u %u %u at %llu\n", t->type, t->finger, t->x, t->y, ns / 1000);
+		}
+		t->x = t->x > 65535 ? 65535 : t->x;
+		t->y = t->y > 65535 ? 65535 : t->y;
+		count_fingers(t->type, t->finger);
+	}
+	lck_mtx_unlock(&touch_lock);
+	wakeup(&touch_queue);
+	return 0;
+}
