 /* For drivers; not from interrupt context. */
 void hakios_touch_post(uint32_t type, uint32_t finger, uint32_t x, uint32_t y);
+#define HAKIOS_TOUCH_BATCH_MAX 20
+/*
+ * Atomically append 1..HAKIOS_TOUCH_BATCH_MAX touch-only records in ordinary thread context.
+ * Input time fields are ignored. Success assigns one mach_absolute_time() to every record,
+ * preserves input order, and wakes readers once. Returns EINVAL for invalid input or ENOBUFS
+ * when the complete batch does not fit; on rejection no queue or touch state is changed.
+ */
+int hakios_touch_post_batch(const struct hakios_touch *events, uint32_t count);
