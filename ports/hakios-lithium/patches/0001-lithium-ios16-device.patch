+		PL011_LCR_WORD_LENGTH_8 |
+		PL011_LCR_FIFO_ENABLE |
+		PL011_LCR_ONE_STOP_BIT |
+		PL011_LCR_PARITY_DISABLE |
+		PL011_LCR_BREAK_DISABLE
